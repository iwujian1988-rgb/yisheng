.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ffffff;
  border-top: 1rpx solid rgba(111, 61, 255, 0.12);
  box-shadow: 0 -8rpx 28rpx rgba(61, 42, 140, 0.05);
  z-index: 9999;
}

.tab-bar__inner {
  display: flex;
  height: 100rpx;
  align-items: center;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 8rpx 0;
}

.tab-bar-item__text {
  font-size: 20rpx;
  line-height: 28rpx;
  color: #8B94AC;
}

.tab-bar-item--active .tab-bar-item__text {
  color: #6F3DFF;
  font-weight: 700;
}

.tab-bar__safe-bottom {
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
}
