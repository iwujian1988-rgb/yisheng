.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ffffff;
  border-top: 1rpx solid #e7e7e7;
  z-index: 9999;
}

.tab-bar__inner {
  display: flex;
  height: 100rpx;
  align-items: center;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 8rpx 0;
}

.tab-bar-item__text {
  font-size: 20rpx;
  line-height: 28rpx;
  color: #8a94a6;
}

.tab-bar-item--active .tab-bar-item__text {
  color: #1677ff;
  font-weight: 600;
}

.tab-bar__safe-bottom {
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
}
