.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ffffff;
  border-top: 1rpx solid rgba(111, 61, 255, 0.12);
  box-shadow: 0 -8rpx 28rpx rgba(61, 42, 140, 0.05);
  z-index: 9999;
}

.tab-bar__inner {
  display: flex;
  height: 100rpx;
  align-items: stretch;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 0;
  height: 100rpx;
  padding: 6rpx 0 4rpx;
  box-sizing: border-box;
  line-height: 1;
}

.tab-bar-item__icon-box {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 48rpx;
  margin-top: 8rpx;
  line-height: 0;
}

.tab-bar-item__icon {
  display: flex !important;
  width: 44rpx !important;
  height: 44rpx !important;
  flex: 0 0 44rpx;
  line-height: 1 !important;
  vertical-align: top !important;
}

.tab-bar-item__text {
  display: block;
  width: 100%;
  font-size: 20rpx;
  height: 28rpx;
  margin-top: 4rpx;
  line-height: 28rpx;
  text-align: center;
  color: #8B94AC;
}

.tab-bar-item--active .tab-bar-item__text {
  color: #6F3DFF;
  font-weight: 700;
}

.tab-bar__safe-bottom {
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
}
