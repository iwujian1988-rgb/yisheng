PORT=8080
NODE_ENV=development
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=ChangeMe123!
SESSION_TTL_SECONDS=7200
ENABLE_DEV_SEED=true
STORE_MODE=file
STORE_FILE=backend/data/store.json

# 阿里云 DashScope 通用 Key（OCR QwenVL-OCR / ASR 共用）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# OCR：优先走 DashScope QwenVL-OCR；未配置 Key 时回退本地 worker
OCR_CLOUD_ENABLED=true
OCR_CLOUD_MODEL=qwen-vl-ocr-2025-11-20
OCR_CLOUD_TASK=text_recognition
OCR_ENGINE=paddleocr
OCR_WORKER_URL=
OCR_TIMEOUT_MS=30000
OCR_MAX_IMAGE_BYTES=5242880

# ASR：优先走 DashScope；未配置 Key 时回退本地 worker
ASR_ENGINE=faster-whisper
ASR_WORKER_URL=
ASR_CLOUD_MODEL=qwen3-asr-flash

AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=default-chat-model
AI_TIMEOUT_MS=30000
WECHAT_APP_ID=
WECHAT_APP_SECRET=
