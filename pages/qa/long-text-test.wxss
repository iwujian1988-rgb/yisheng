/* pages/qa/long-text-test.wxss */
.test-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 32rpx 64rpx 96rpx;
  box-sizing: border-box;
}

.card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.card-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #101936;
}

.target-card {
  background-color: rgba(111, 61, 255, 0.06);
}

.target-text {
  font-size: 28rpx;
  color: #6F3DFF;
  line-height: 1.8;
}

.test-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
  background-color: #6F3DFF;
  color: #FFFFFF;
}

.test-btn:active {
  opacity: 0.8;
}

.record-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.record-chip {
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  background-color: #FFFFFF;
  font-size: 26rpx;
  color: #64739A;
}

.record-chip-active {
  color: #6F3DFF;
  border-color: #6F3DFF;
  background-color: rgba(111, 61, 255, 0.08);
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  background-color: #FCFBFF;
  font-size: 28rpx;
  color: #101936;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 240rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  background-color: #FCFBFF;
  font-size: 28rpx;
  color: #101936;
  box-sizing: border-box;
}

.failure-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.failure-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #64739A;
}

.empty-section {
  display: flex;
  justify-content: center;
  padding-top: 120rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #98A1B8;
}

.section-label {
  display: block;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #101936;
}

.list-area {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 40rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.record-date {
  font-size: 30rpx;
  color: #101936;
  font-weight: 500;
}

.record-pass {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.pass-yes {
  color: #52C41A;
  background-color: rgba(82, 196, 26, 0.1);
}

.pass-no {
  color: #F5222D;
  background-color: rgba(245, 34, 45, 0.06);
}

.record-meta {
  display: flex;
  gap: 32rpx;
}

.meta-text {
  font-size: 26rpx;
  color: #98A1B8;
}
