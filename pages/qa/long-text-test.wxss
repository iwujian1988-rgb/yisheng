/* pages/qa/long-text-test.wxss */
.test-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px 48px;
  box-sizing: border-box;
}

.card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 20px;
  margin-bottom: 12px;
  box-sizing: border-box;
}

.card-title {
  display: block;
  margin-bottom: 10px;
  font-size: 16px;
  font-weight: 500;
  color: #333333;
}

.target-card {
  background-color: rgba(74, 144, 226, 0.06);
}

.target-text {
  font-size: 14px;
  color: #4A90E2;
  line-height: 1.8;
}

.test-btn {
  width: 100%;
  height: 44px;
  border-radius: 8px;
  font-size: 15px;
  font-weight: 500;
  background-color: #4A90E2;
  color: #FFFFFF;
}

.test-btn:active {
  opacity: 0.8;
}

.record-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 12px;
}

.record-chip {
  padding: 6px 10px;
  border-radius: 8px;
  border: 1px solid #E5E5E5;
  background-color: #FFFFFF;
  font-size: 13px;
  color: #666666;
}

.record-chip-active {
  color: #4A90E2;
  border-color: #4A90E2;
  background-color: rgba(74, 144, 226, 0.08);
}

.form-input {
  width: 100%;
  height: 44px;
  padding: 0 12px;
  margin-bottom: 12px;
  border-radius: 8px;
  background-color: #F5F7FA;
  font-size: 14px;
  color: #333333;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 120px;
  padding: 12px;
  margin-bottom: 12px;
  border-radius: 8px;
  background-color: #F5F7FA;
  font-size: 14px;
  color: #333333;
  box-sizing: border-box;
}

.failure-group {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 16px;
}

.failure-item {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 13px;
  color: #666666;
}

.empty-section {
  display: flex;
  justify-content: center;
  padding-top: 60px;
}

.empty-text {
  font-size: 14px;
  color: #999999;
}

.section-label {
  display: block;
  margin-bottom: 10px;
  font-size: 15px;
  font-weight: 500;
  color: #333333;
}

.list-area {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.record-card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 16px 20px;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.record-date {
  font-size: 15px;
  color: #333333;
  font-weight: 500;
}

.record-pass {
  font-size: 12px;
  padding: 2px 8px;
  border-radius: 4px;
}

.pass-yes {
  color: #52C41A;
  background-color: rgba(82, 196, 26, 0.1);
}

.pass-no {
  color: #F5222D;
  background-color: rgba(245, 34, 45, 0.06);
}

.record-meta {
  display: flex;
  gap: 16px;
}

.meta-text {
  font-size: 13px;
  color: #999999;
}
