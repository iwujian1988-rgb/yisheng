/* pages/qa/smoke-result.wxss */
.result-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 32rpx 64rpx 96rpx;
}

.card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 32rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.summary-row {
  display: flex;
  justify-content: space-around;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-num {
  font-size: 56rpx;
  font-weight: 600;
  color: #101936;
  display: block;
}

.num-pass {
  color: #52C41A;
}

.num-fail {
  color: #F5222D;
}

.summary-label {
  font-size: 26rpx;
  color: #98A1B8;
  margin-top: 8rpx;
}

.section-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #101936;
  display: block;
  margin-bottom: 20rpx;
}

.empty-section {
  display: flex;
  justify-content: center;
  padding-top: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #98A1B8;
}

.issue-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.issue-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 40rpx;
  border-left: 8rpx solid #F5222D;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.issue-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #101936;
  display: block;
  margin-bottom: 8rpx;
}

.issue-desc {
  font-size: 26rpx;
  color: #98A1B8;
}
