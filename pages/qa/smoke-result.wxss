/* pages/qa/smoke-result.wxss */
.result-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px 48px;
}

.card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 20px;
  margin-bottom: 16px;
}

.summary-row {
  display: flex;
  justify-content: space-around;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-num {
  font-size: 28px;
  font-weight: 600;
  color: #333333;
  display: block;
}

.num-pass {
  color: #52C41A;
}

.num-fail {
  color: #F5222D;
}

.summary-label {
  font-size: 13px;
  color: #999999;
  margin-top: 4px;
}

.section-label {
  font-size: 15px;
  font-weight: 500;
  color: #333333;
  display: block;
  margin-bottom: 10px;
}

.empty-section {
  display: flex;
  justify-content: center;
  padding-top: 40px;
}

.empty-text {
  font-size: 14px;
  color: #999999;
}

.issue-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.issue-card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 16px 20px;
  border-left: 4px solid #F5222D;
}

.issue-title {
  font-size: 15px;
  font-weight: 500;
  color: #333333;
  display: block;
  margin-bottom: 4px;
}

.issue-desc {
  font-size: 13px;
  color: #999999;
}
