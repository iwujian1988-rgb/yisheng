/* pages/qa/hardware-test-guide.wxss */
.guide-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.step-card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 20px;
}

.step-header {
  display: flex;
  align-items: center;
  margin-bottom: 10px;
}

.step-num {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background-color: #4A90E2;
  color: #FFFFFF;
  font-size: 14px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
}

.step-title {
  font-size: 16px;
  font-weight: 500;
  color: #333333;
}

.step-desc {
  font-size: 14px;
  color: #666666;
  line-height: 1.8;
  padding-left: 40px;
}
