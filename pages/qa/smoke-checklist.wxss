/* pages/qa/smoke-checklist.wxss */
.checklist-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 32rpx 64rpx 96rpx;
}

/* 提示 */
.tip-card {
  background-color: rgba(111, 61, 255, 0.08);
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 32rpx;
}

.tip-text {
  font-size: 28rpx;
  color: #6F3DFF;
}

/* 检查项 */
.check-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 8rpx 40rpx;
  margin-bottom: 32rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.check-item {
  padding: 28rpx 0;
  border-bottom: 2rpx solid rgba(111, 61, 255, 0.08);
}

.check-item:last-child {
  border-bottom: none;
}

.check-label {
  display: flex;
  align-items: flex-start;
}

.check-info {
  margin-left: 20rpx;
  flex: 1;
}

.check-title {
  font-size: 30rpx;
  color: #101936;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}

.check-desc {
  font-size: 26rpx;
  color: #98A1B8;
  display: block;
}

/* 进度 */
.progress-section {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 40rpx;
}

.progress-bar {
  height: 16rpx;
  background-color: rgba(111, 61, 255, 0.08);
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  background-color: #52C41A;
  border-radius: 20rpx;
}

.progress-text {
  font-size: 26rpx;
  color: #64739A;
}
