<!--pages/qa/hardware-test-guide.wxml-->
<view class="guide-container">
  <view class="step-card">
    <view class="step-header">
      <view class="step-num">1</view>
      <text class="step-title">设备插入</text>
    </view>
    <text class="step-desc">将传输硬件插入电脑 USB 接口，等待系统识别设备。</text>
  </view>

  <view class="step-card">
    <view class="step-header">
      <view class="step-num">2</view>
      <text class="step-title">蓝牙连接</text>
    </view>
    <text class="step-desc">在小程序中搜索并连接硬件设备的蓝牙信号，确认连接成功。</text>
  </view>

  <view class="step-card">
    <view class="step-header">
      <view class="step-num">3</view>
      <text class="step-title">文本发送</text>
    </view>
    <text class="step-desc">在小程序中输入测试文本，点击发送，观察发送进度是否正常推进。</text>
  </view>

  <view class="step-card">
    <view class="step-header">
      <view class="step-num">4</view>
      <text class="step-title">电脑输入框确认</text>
    </view>
    <text class="step-desc">确认目标电脑输入框已获得焦点，检查文本是否完整、准确地出现在输入框中。</text>
  </view>
</view>
