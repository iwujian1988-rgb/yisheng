/* pages/qa/bug-report.wxss */
.bug-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px 48px;
}

.card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 20px;
  margin-bottom: 12px;
}

.card-title {
  font-size: 16px;
  font-weight: 500;
  color: #333333;
  display: block;
  margin-bottom: 14px;
}

.radio-item {
  display: flex;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid #F0F0F0;
}

.radio-item:last-child {
  border-bottom: none;
}

.radio-text {
  font-size: 15px;
  color: #333333;
  margin-left: 8px;
}

.field-item {
  margin-bottom: 16px;
}

.field-item:last-child {
  margin-bottom: 0;
}

.field-label {
  font-size: 14px;
  color: #333333;
  font-weight: 500;
  margin-bottom: 8px;
  display: block;
}

.field-input {
  width: 100%;
  height: 48px;
  padding: 0 16px;
  background-color: #F5F7FA;
  border-radius: 8px;
  font-size: 15px;
  color: #333333;
  box-sizing: border-box;
}

.field-textarea {
  width: 100%;
  height: 100px;
  padding: 14px 16px;
  background-color: #F5F7FA;
  border-radius: 8px;
  font-size: 15px;
  color: #333333;
  box-sizing: border-box;
  line-height: 1.6;
}

.input-placeholder {
  color: #999999;
}

.submit-btn {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
  margin-top: 12px;
  background-color: #4A90E2;
  color: #FFFFFF;
}

.submit-btn:active {
  opacity: 0.8;
}

.submit-btn[disabled] {
  background-color: #CCCCCC;
  color: #FFFFFF;
}
