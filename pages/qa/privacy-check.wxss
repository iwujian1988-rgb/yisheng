/* pages/qa/privacy-check.wxss */
.checklist-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px 48px;
}

.tip-card {
  background-color: rgba(74, 144, 226, 0.08);
  border-radius: 8px;
  padding: 12px 16px;
  margin-bottom: 16px;
}

.tip-text {
  font-size: 14px;
  color: #4A90E2;
}

.check-card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 4px 20px;
  margin-bottom: 16px;
}

.check-item {
  padding: 14px 0;
  border-bottom: 1px solid #F0F0F0;
}

.check-item:last-child {
  border-bottom: none;
}

.check-label {
  display: flex;
  align-items: flex-start;
}

.check-info {
  margin-left: 10px;
  flex: 1;
}

.check-title {
  font-size: 15px;
  color: #333333;
  font-weight: 500;
  display: block;
  margin-bottom: 4px;
}

.check-desc {
  font-size: 13px;
  color: #999999;
  display: block;
}

.progress-section {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 16px 20px;
}

.progress-bar {
  height: 8px;
  background-color: #F0F0F0;
  border-radius: 4px;
  overflow: hidden;
  margin-bottom: 8px;
}

.progress-fill {
  height: 100%;
  background-color: #52C41A;
  border-radius: 4px;
}

.progress-text {
  font-size: 13px;
  color: #666666;
}
