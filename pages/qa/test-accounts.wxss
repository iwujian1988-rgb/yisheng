/* pages/qa/test-accounts.wxss */
.accounts-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 32rpx 64rpx 96rpx;
}

/* 卡片 */
.card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #101936;
  display: block;
  margin-bottom: 24rpx;
}

.card-desc {
  font-size: 28rpx;
  color: #64739A;
  line-height: 1.8;
}

/* 账号类型 */
.account-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 2rpx solid rgba(111, 61, 255, 0.08);
}

.account-item:last-child {
  border-bottom: none;
}

.account-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background-color: #6F3DFF;
  margin-top: 16rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.account-info {
  flex: 1;
}

.account-name {
  font-size: 30rpx;
  color: #101936;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}

.account-desc {
  font-size: 26rpx;
  color: #98A1B8;
  display: block;
}

/* 按钮 */
.view-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
  margin-top: 48rpx;
  background-color: #6F3DFF;
  color: #FFFFFF;
}

.view-btn:active {
  opacity: 0.8;
}
