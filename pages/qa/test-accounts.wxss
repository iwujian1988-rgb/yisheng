/* pages/qa/test-accounts.wxss */
.accounts-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px 48px;
}

/* 卡片 */
.card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 20px;
  margin-bottom: 12px;
}

.card-title {
  font-size: 16px;
  font-weight: 500;
  color: #333333;
  display: block;
  margin-bottom: 12px;
}

.card-desc {
  font-size: 14px;
  color: #666666;
  line-height: 1.8;
}

/* 账号类型 */
.account-item {
  display: flex;
  align-items: flex-start;
  padding: 12px 0;
  border-bottom: 1px solid #F0F0F0;
}

.account-item:last-child {
  border-bottom: none;
}

.account-dot {
  width: 6px;
  height: 6px;
  border-radius: 3px;
  background-color: #4A90E2;
  margin-top: 8px;
  margin-right: 10px;
  flex-shrink: 0;
}

.account-info {
  flex: 1;
}

.account-name {
  font-size: 15px;
  color: #333333;
  font-weight: 500;
  display: block;
  margin-bottom: 4px;
}

.account-desc {
  font-size: 13px;
  color: #999999;
  display: block;
}

/* 按钮 */
.view-btn {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
  margin-top: 24px;
  background-color: #4A90E2;
  color: #FFFFFF;
}

.view-btn:active {
  opacity: 0.8;
}
