/* pages/support/index.wxss */
.support-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px;
}

/* 菜单 */
.menu-card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 0 20px;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 0;
}

.menu-label {
  font-size: 15px;
  color: #333333;
}

.menu-arrow {
  font-size: 12px;
  color: #CCCCCC;
}

.menu-divider {
  height: 1px;
  background-color: #F0F0F0;
}
