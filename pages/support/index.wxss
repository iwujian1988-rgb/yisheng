.support-container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 16px 32px;
}

.menu-card {
  background-color: #ffffff;
  border-radius: 8px;
  padding: 0 20px;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 0;
}

.menu-label {
  font-size: 15px;
  color: #333333;
}

.menu-arrow {
  font-size: 12px;
  color: #cccccc;
}

.menu-divider {
  height: 1px;
  background-color: #f0f0f0;
}
