<!--pages/support/index.wxml-->
<view class="support-container">
  <!-- 售后入口列表 -->
  <view class="menu-section">
    <view class="menu-card">
      <view class="menu-item" bindtap="contactSupport">
        <text class="menu-label">联系客服</text>
        <text class="menu-arrow">&#10095;</text>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-item" bindtap="reportDeviceIssue">
        <text class="menu-label">设备故障</text>
        <text class="menu-arrow">&#10095;</text>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-item" bindtap="reportAccountIssue">
        <text class="menu-label">账号开通问题</text>
        <text class="menu-arrow">&#10095;</text>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-item" bindtap="reportTransferIssue">
        <text class="menu-label">传输异常</text>
        <text class="menu-arrow">&#10095;</text>
      </view>
    </view>
  </view>
</view>
