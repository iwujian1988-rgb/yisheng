/* pages/sales/leads.wxss */
.leads-container { min-height: 100vh; background-color: #FCFBFF; padding: 24rpx 32rpx; }
.empty-section { display: flex; justify-content: center; padding-top: 240rpx; }
.empty-text { font-size: 28rpx; color: #98A1B8; }
.lead-list { display: flex; flex-direction: column; gap: 20rpx; }
.lead-card { background-color: #FFFFFF; border-radius: 20rpx; padding: 32rpx 40rpx; display: flex; justify-content: space-between; align-items: center;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}
.lead-name { font-size: 30rpx; font-weight: 500; color: #101936; }
.lead-status { font-size: 26rpx; color: #98A1B8; }
