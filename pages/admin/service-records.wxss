/* pages/admin/service-records.wxss */
.records-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 24rpx 32rpx;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.filter-item {
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  background-color: #FFFFFF;
}

.filter-active {
  background-color: #6F3DFF;
}

.filter-active .filter-text {
  color: #FFFFFF;
}

.filter-text {
  font-size: 28rpx;
  color: #64739A;
}

/* 空状态 */
.empty-section {
  display: flex;
  justify-content: center;
  padding-top: 240rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #98A1B8;
}

/* 列表 */
.list-area {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 40rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.record-user {
  font-size: 30rpx;
  font-weight: 500;
  color: #101936;
}

.record-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.status-active {
  color: #52C41A;
  background-color: rgba(82, 196, 26, 0.1);
}

.status-expired {
  color: #98A1B8;
  background-color: rgba(111, 61, 255, 0.08);
}

.record-meta {
  display: flex;
  gap: 32rpx;
}

.meta-text {
  font-size: 26rpx;
  color: #98A1B8;
}
