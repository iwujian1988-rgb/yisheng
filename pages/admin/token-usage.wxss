.page { padding: 16rpx; background: #FCFBFF; min-height: 100vh; }
.stats-card { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 16rpx;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}
.stat-row { display: flex; justify-content: space-between; padding: 12rpx 0; }
.stat-label { color: #64739A; }
.stat-value { font-weight: bold; font-size: 32rpx; }
.section-label { padding: 24rpx 16rpx 12rpx; color: #64739A; font-size: 26rpx; }
.empty { text-align: center; color: #98A1B8; padding: 80rpx 0; }
.token-count { color: #6F3DFF; font-weight: 500; }
