/* pages/admin/paid-user-create.wxss */
.create-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 32rpx 64rpx 96rpx;
}

.card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 48rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #101936;
  display: block;
  margin-bottom: 32rpx;
}

/* 字段 */
.field-item {
  margin-bottom: 40rpx;
}

.field-item:last-child {
  margin-bottom: 0;
}

.field-label {
  font-size: 28rpx;
  color: #101936;
  font-weight: 500;
  margin-bottom: 16rpx;
  display: block;
}

.field-input {
  width: 100%;
  height: 96rpx;
  padding: 0 32rpx;
  background-color: #FCFBFF;
  border-radius: 20rpx;
  font-size: 30rpx;
  color: #101936;
  box-sizing: border-box;
}

.field-textarea {
  width: 100%;
  height: 200rpx;
  padding: 28rpx 32rpx;
  background-color: #FCFBFF;
  border-radius: 20rpx;
  font-size: 30rpx;
  color: #101936;
  box-sizing: border-box;
  line-height: 1.6;
}

.input-placeholder {
  color: #98A1B8;
}

/* 日期选择器 */
.field-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 96rpx;
  padding: 0 32rpx;
  background-color: #FCFBFF;
  border-radius: 20rpx;
}

.picker-value {
  font-size: 30rpx;
  color: #101936;
}

.picker-placeholder {
  font-size: 30rpx;
  color: #98A1B8;
}

.picker-arrow {
  font-size: 24rpx;
  color: #CCCCCC;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
  background-color: #6F3DFF;
  color: #FFFFFF;
}

.submit-btn:active {
  opacity: 0.8;
}

.submit-btn[disabled] {
  background-color: #CCCCCC;
  color: #FFFFFF;
}
