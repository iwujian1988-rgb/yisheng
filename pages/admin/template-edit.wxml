<view class="page">
  <t-cell-group theme="card">
    <t-cell title="模板编码" wx:if="{{!isEdit}}" required hover>
      <t-input
        slot="note"
        placeholder="字母/数字/_- 3-64位"
        value="{{templateCode}}"
        data-field="templateCode"
        bind:change="onInput"
      />
    </t-cell>
    <t-cell title="模板编码" wx:else hover>
      <text slot="note">{{templateCode}}</text>
    </t-cell>
    <t-cell title="模板名称" required hover>
      <t-input
        slot="note"
        placeholder="如：会议纪要整理"
        value="{{name}}"
        data-field="name"
        bind:change="onInput"
      />
    </t-cell>
    <t-cell title="分类" hover>
      <t-input
        slot="note"
        placeholder="如：办公 / 学习"
        value="{{category}}"
        data-field="category"
        bind:change="onInput"
      />
    </t-cell>
    <t-cell title="描述" hover>
      <t-input
        slot="note"
        placeholder="一句话描述"
        value="{{description}}"
        data-field="description"
        bind:change="onInput"
      />
    </t-cell>
  </t-cell-group>

  <view class="section-label">受众</view>
  <t-cell-group theme="card">
    <t-cell title="受众范围" hover>
      <t-radio-group slot="note" value="{{audience}}" bind:change="onAudienceChange">
        <t-radio value="general" label="通用（所有人可见）" />
        <t-radio value="professional" label="专业（需会员+硬件）" />
      </t-radio-group>
    </t-cell>
    <t-cell title="状态" hover>
      <t-radio-group slot="note" value="{{status}}" bind:change="onStatusChange">
        <t-radio value="draft" label="草稿" />
        <t-radio value="published" label="发布" />
      </t-radio-group>
    </t-cell>
  </t-cell-group>

  <view class="section-label">Prompt 内容</view>
  <view class="textarea-wrap">
    <t-textarea
      placeholder="在此写入 AI Prompt 模板内容..."
      value="{{promptContent}}"
      data-field="promptContent"
      bind:change="onInput"
      maxlength="-1"
      autosize="{{ {minHeight: 240, maxHeight: 600} }}"
    />
  </view>

  <view class="footer">
    <t-button theme="primary" block loading="{{saving}}" disabled="{{!canSave}}" bind:tap="save">
      保存
    </t-button>
  </view>
</view>
