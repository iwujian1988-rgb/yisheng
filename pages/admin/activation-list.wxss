/* pages/admin/activation-list.wxss */
.list-container { min-height: 100vh; background-color: #FCFBFF; padding: 24rpx 32rpx; }
.filter-bar { display: flex; gap: 20rpx; margin-bottom: 32rpx; }
.filter-item { padding: 16rpx 32rpx; border-radius: 40rpx; background-color: #FFFFFF; }
.filter-active { background-color: #6F3DFF; }
.filter-active .filter-text { color: #FFFFFF; }
.filter-text { font-size: 28rpx; color: #64739A; }
.empty-section { display: flex; justify-content: center; padding-top: 240rpx; }
.empty-text { font-size: 28rpx; color: #98A1B8; }
.code-list { display: flex; flex-direction: column; gap: 20rpx; }
.code-card { background-color: #FFFFFF; border-radius: 20rpx; padding: 32rpx 40rpx; display: flex; justify-content: space-between; align-items: center;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}
.code-text { font-size: 28rpx; color: #101936; font-family: monospace; }
.code-status { font-size: 26rpx; color: #98A1B8; }
