/* pages/admin/device-detail.wxss */
.detail-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px 48px;
}

.card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 20px;
  margin-bottom: 24px;
}

.card-title {
  font-size: 16px;
  font-weight: 500;
  color: #333333;
  display: block;
  margin-bottom: 16px;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid #F0F0F0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 15px;
  color: #666666;
}

.info-value {
  font-size: 15px;
  color: #333333;
}

.action-section {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.action-btn {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
}

.btn-primary {
  background-color: #4A90E2;
  color: #FFFFFF;
}

.btn-outline {
  background-color: transparent;
  color: #F5222D;
  border: 1px solid #F5222D;
}
