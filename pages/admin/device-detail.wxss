/* pages/admin/device-detail.wxss */
.detail-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 32rpx 64rpx 96rpx;
}

.card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 48rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #101936;
  display: block;
  margin-bottom: 32rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(111, 61, 255, 0.08);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 30rpx;
  color: #64739A;
}

.info-value {
  font-size: 30rpx;
  color: #101936;
}

.action-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.action-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-primary {
  background-color: #6F3DFF;
  color: #FFFFFF;
}

.btn-outline {
  background-color: transparent;
  color: #F5222D;
  border: 2rpx solid #F5222D;
}
