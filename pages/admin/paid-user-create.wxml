<!--pages/admin/paid-user-create.wxml-->
<view class="create-container">
  <view class="card">
    <text class="card-title">用户信息</text>

    <view class="field-item">
      <text class="field-label">手机号</text>
      <input
        class="field-input"
        type="number"
        placeholder="请输入手机号"
        placeholder-class="input-placeholder"
        value="{{phone}}"
        bindinput="onPhoneInput"
        maxlength="11"
      />
    </view>

    <view class="field-item">
      <text class="field-label">服务期限</text>
      <picker mode="date" value="{{expiryDate}}" bindchange="onDateChange">
        <view class="field-picker">
          <text class="{{expiryDate ? 'picker-value' : 'picker-placeholder'}}">{{expiryDate || '请选择到期日期'}}</text>
          <text class="picker-arrow">&#10095;</text>
        </view>
      </picker>
    </view>

    <view class="field-item">
      <text class="field-label">设备序列号</text>
      <input
        class="field-input"
        placeholder="请输入设备序列号（选填）"
        placeholder-class="input-placeholder"
        value="{{serialNo}}"
        bindinput="onSerialInput"
        maxlength="50"
      />
    </view>

    <view class="field-item">
      <text class="field-label">备注</text>
      <textarea
        class="field-textarea"
        placeholder="选填备注信息"
        placeholder-class="input-placeholder"
        value="{{remark}}"
        bindinput="onRemarkInput"
        maxlength="200"
      />
    </view>
  </view>

  <button
    class="btn btn-primary submit-btn"
    disabled="{{!canSubmit}}"
    bindtap="submitCreate"
  >
    创建用户
  </button>
</view>
