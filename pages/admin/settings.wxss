/* pages/admin/settings.wxss */
.settings-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 24rpx 32rpx;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.entry-card {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 40rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.entry-info {
  flex: 1;
}

.entry-title {
  font-size: 32rpx;
  color: #101936;
  font-weight: 500;
  display: block;
  margin-bottom: 4rpx;
}

.entry-desc {
  font-size: 26rpx;
  color: #98A1B8;
  display: block;
}

.entry-arrow {
  font-size: 24rpx;
  color: #CCCCCC;
  flex-shrink: 0;
}
