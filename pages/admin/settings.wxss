/* pages/admin/settings.wxss */
.settings-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.entry-card {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 16px 20px;
}

.entry-info {
  flex: 1;
}

.entry-title {
  font-size: 16px;
  color: #333333;
  font-weight: 500;
  display: block;
  margin-bottom: 2px;
}

.entry-desc {
  font-size: 13px;
  color: #999999;
  display: block;
}

.entry-arrow {
  font-size: 12px;
  color: #CCCCCC;
  flex-shrink: 0;
}
