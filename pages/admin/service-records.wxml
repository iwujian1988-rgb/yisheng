<!--pages/admin/service-records.wxml-->
<view class="records-container">
  <!-- 筛选状态 -->
  <view class="filter-bar">
    <view class="filter-item {{filter === 'all' ? 'filter-active' : ''}}" bindtap="setFilter" data-filter="all">
      <text class="filter-text">全部</text>
    </view>
    <view class="filter-item {{filter === 'active' ? 'filter-active' : ''}}" bindtap="setFilter" data-filter="active">
      <text class="filter-text">有效</text>
    </view>
    <view class="filter-item {{filter === 'expired' ? 'filter-active' : ''}}" bindtap="setFilter" data-filter="expired">
      <text class="filter-text">已过期</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-section" wx:if="{{records.length === 0}}">
    <text class="empty-text">暂无服务记录</text>
  </view>

  <!-- 记录列表 -->
  <view class="list-area" wx:if="{{records.length > 0}}">
    <view class="record-card" wx:for="{{records}}" wx:key="id">
      <view class="record-header">
        <text class="record-user">{{item.userPhone}}</text>
        <text class="record-status {{item.active ? 'status-active' : 'status-expired'}}">{{item.active ? '有效' : '已过期'}}</text>
      </view>
      <view class="record-meta">
        <text class="meta-text">开通：{{item.startDate}}</text>
        <text class="meta-text">到期：{{item.expiryDate}}</text>
      </view>
    </view>
  </view>
</view>
