<view class="page">
  <view class="stats-card">
    <view class="stat-row">
      <text class="stat-label">总调用次数</text>
      <text class="stat-value">{{stats.total}}</text>
    </view>
    <view class="stat-row">
      <text class="stat-label">总 Token 消耗</text>
      <text class="stat-value">{{stats.totalTokens}}</text>
    </view>
  </view>

  <t-loading wx:if="{{isLoading}}" theme="circular" size="40rpx" text="加载中..." />
  <view wx:elif="{{items.length === 0}}" class="empty">暂无 Token 用量记录</view>

  <view wx:else class="section-label">最近 200 条</view>
  <t-cell-group wx:if="{{items.length > 0}}" theme="card">
    <t-cell
      wx:for="{{items}}"
      wx:key="id"
      title="{{item.userPhone || item.userId || '--'}}"
      description="{{item.provider || '--'}} · {{item.model || '--'}}"
    >
      <view slot="note">
        <text class="token-count">{{item.totalTokens || item.tokens || 0}} tokens</text>
      </view>
    </t-cell>
  </t-cell-group>
</view>
