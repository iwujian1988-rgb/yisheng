/* pages/admin/paid-user-list.wxss */
.list-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 24rpx 32rpx;
}

/* 搜索 */
.search-bar {
  margin-bottom: 32rpx;
}

.search-input {
  height: 88rpx;
  padding: 0 32rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  font-size: 30rpx;
  color: #101936;
}

.search-placeholder {
  color: #98A1B8;
}

/* 空状态 */
.empty-section {
  display: flex;
  justify-content: center;
  padding-top: 240rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #98A1B8;
}

/* 列表 */
.list-area {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.user-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 40rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.user-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.user-phone {
  font-size: 32rpx;
  font-weight: 500;
  color: #101936;
}

.user-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.status-active {
  color: #52C41A;
  background-color: rgba(82, 196, 26, 0.1);
}

.status-inactive {
  color: #98A1B8;
  background-color: rgba(111, 61, 255, 0.08);
}

.user-meta {
  display: flex;
  gap: 32rpx;
}

.meta-text {
  font-size: 26rpx;
  color: #98A1B8;
}
