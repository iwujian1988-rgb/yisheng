/* pages/admin/paid-user-edit.wxss */
.edit-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px 48px;
}

.card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 20px;
  margin-bottom: 24px;
}

.card-title {
  font-size: 16px;
  font-weight: 500;
  color: #333333;
  display: block;
  margin-bottom: 16px;
}

.field-item {
  margin-bottom: 20px;
}

.field-item:last-child {
  margin-bottom: 0;
}

.field-label {
  font-size: 14px;
  color: #333333;
  font-weight: 500;
  margin-bottom: 8px;
  display: block;
}

.field-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 48px;
  padding: 0 16px;
  background-color: #F5F7FA;
  border-radius: 8px;
}

.picker-value {
  font-size: 15px;
  color: #333333;
}

.picker-placeholder {
  font-size: 15px;
  color: #999999;
}

.picker-arrow {
  font-size: 12px;
  color: #CCCCCC;
}

.radio-item {
  display: flex;
  align-items: center;
  padding: 10px 0;
}

.radio-text {
  font-size: 15px;
  color: #333333;
  margin-left: 8px;
}

.field-textarea {
  width: 100%;
  height: 100px;
  padding: 14px 16px;
  background-color: #F5F7FA;
  border-radius: 8px;
  font-size: 15px;
  color: #333333;
  box-sizing: border-box;
  line-height: 1.6;
}

.input-placeholder {
  color: #999999;
}

.save-btn {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
  background-color: #4A90E2;
  color: #FFFFFF;
}

.save-btn:active {
  opacity: 0.8;
}

.save-btn[disabled] {
  background-color: #CCCCCC;
  color: #FFFFFF;
}
