/* pages/admin/feedback-detail.wxss */
.detail-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 32rpx 64rpx 96rpx;
}

.card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #101936;
  display: block;
  margin-bottom: 28rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(111, 61, 255, 0.08);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 30rpx;
  color: #64739A;
}

.info-value {
  font-size: 30rpx;
  color: #101936;
}

.content-text {
  font-size: 30rpx;
  color: #101936;
  line-height: 1.8;
  word-break: break-all;
}

.remark-input {
  width: 100%;
  height: 240rpx;
  padding: 28rpx 32rpx;
  background-color: #FCFBFF;
  border-radius: 20rpx;
  font-size: 30rpx;
  color: #101936;
  box-sizing: border-box;
  line-height: 1.6;
}

.input-placeholder {
  color: #98A1B8;
}

.submit-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
  margin-top: 24rpx;
  background-color: #6F3DFF;
  color: #FFFFFF;
}

.submit-btn:active {
  opacity: 0.8;
}

.submit-btn[disabled] {
  background-color: #CCCCCC;
  color: #FFFFFF;
}
