/* pages/admin/index.wxss */
.admin-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px;
}

.entry-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.entry-card {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 16px 20px;
}

.entry-icon {
  width: 44px;
  height: 44px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14px;
  flex-shrink: 0;
}

.icon-text {
  font-size: 22px;
}

.icon-users {
  background-color: rgba(74, 144, 226, 0.1);
  color: #4A90E2;
}

.icon-device {
  background-color: rgba(82, 196, 26, 0.1);
  color: #52C41A;
}

.icon-records {
  background-color: rgba(250, 173, 20, 0.1);
  color: #FAAD14;
}

.icon-feedback {
  background-color: rgba(114, 46, 209, 0.1);
  color: #722ED1;
}

.entry-info {
  flex: 1;
}

.entry-title {
  font-size: 16px;
  color: #333333;
  font-weight: 500;
  display: block;
  margin-bottom: 2px;
}

.entry-desc {
  font-size: 13px;
  color: #999999;
  display: block;
}

.entry-arrow {
  font-size: 12px;
  color: #CCCCCC;
  flex-shrink: 0;
}
