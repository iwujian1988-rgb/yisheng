/* pages/admin/audit-log.wxss */
.log-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 24rpx 32rpx;
}

.empty-section {
  display: flex;
  justify-content: center;
  padding-top: 240rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #98A1B8;
}

.log-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.log-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 40rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.log-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.log-action {
  font-size: 30rpx;
  font-weight: 500;
  color: #101936;
}

.log-time {
  font-size: 24rpx;
  color: #98A1B8;
}

.log-operator {
  font-size: 26rpx;
  color: #64739A;
}
