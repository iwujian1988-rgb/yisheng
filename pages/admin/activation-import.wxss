/* pages/admin/activation-import.wxss */
.import-container { min-height: 100vh; background-color: #FCFBFF; padding: 32rpx 64rpx 96rpx; }
.card { background-color: #FFFFFF; border-radius: 20rpx; padding: 40rpx; margin-bottom: 24rpx;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}
.card-title { font-size: 32rpx; font-weight: 500; color: #101936; display: block; margin-bottom: 24rpx; }
.import-textarea { width: 100%; height: 400rpx; padding: 28rpx 32rpx; background-color: #FCFBFF; border-radius: 20rpx; font-size: 28rpx; font-family: monospace; color: #101936; box-sizing: border-box; line-height: 1.8; }
.ph { color: #98A1B8; }
.hint-text { font-size: 26rpx; color: #98A1B8; display: block; margin-top: 16rpx; }
.desc-text { font-size: 28rpx; color: #64739A; line-height: 1.8; }
.submit-btn { width: 100%; height: 104rpx; border-radius: 999rpx; font-size: 32rpx; font-weight: 500; background-color: #6F3DFF; color: #FFFFFF; margin-top: 24rpx; }
.submit-btn:active { opacity: 0.8; }
.submit-btn[disabled] { background-color: #CCCCCC; color: #FFFFFF; }
