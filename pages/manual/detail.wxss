/* pages/manual/detail.wxss */
.detail-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 24rpx 32rpx;
}

.card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 32rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.detail-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #101936;
}

.section {
  margin-bottom: 40rpx;
}

.section-label {
  font-size: 32rpx;
  font-weight: 500;
  color: #101936;
  display: block;
  margin-bottom: 24rpx;
}

.step-card {
  display: flex;
  align-items: flex-start;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 40rpx;
  margin-bottom: 16rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #6F3DFF;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.step-text {
  font-size: 30rpx;
  color: #101936;
  line-height: 1.6;
  flex: 1;
  padding-top: 4rpx;
}

.notice-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
}

.notice-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background-color: #FAAD14;
  margin-top: 16rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.notice-text {
  font-size: 28rpx;
  color: #64739A;
  line-height: 1.6;
  flex: 1;
}
