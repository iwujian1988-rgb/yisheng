/* pages/manual/index.wxss */
.manual-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 24rpx 32rpx;
}

.entry-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.entry-card {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 40rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.entry-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.icon-text {
  font-size: 44rpx;
}

.icon-setup {
  background-color: rgba(111, 61, 255, 0.1);
  color: #6F3DFF;
}

.icon-device {
  background-color: rgba(82, 196, 26, 0.1);
  color: #52C41A;
}

.icon-transfer {
  background-color: rgba(250, 173, 20, 0.1);
  color: #FAAD14;
}

.icon-ai {
  background-color: rgba(114, 46, 209, 0.1);
  color: #722ED1;
}

.icon-trouble {
  background-color: rgba(245, 34, 45, 0.1);
  color: #F5222D;
}

.entry-info {
  flex: 1;
}

.entry-title {
  font-size: 32rpx;
  color: #101936;
  font-weight: 500;
  display: block;
  margin-bottom: 4rpx;
}

.entry-desc {
  font-size: 26rpx;
  color: #98A1B8;
  display: block;
}

.entry-arrow {
  font-size: 24rpx;
  color: #CCCCCC;
  flex-shrink: 0;
}
