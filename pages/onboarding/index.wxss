/* pages/onboarding/index.wxss */
.onboarding-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFFFFF 0%, #FCFBFF 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 32rpx;
  box-sizing: border-box;
}

/* 步骤内容 */
.step-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.step-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 56rpx 40rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  border-radius: 28rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(61, 42, 140, 0.05);
}

.step-icon-circle {
  width: 176rpx;
  height: 176rpx;
  border-radius: 28rpx;
  background-color: #6F3DFF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 56rpx;
}

.step-icon-text {
  font-size: 80rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.step-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #101936;
  margin-bottom: 24rpx;
}

.step-desc {
  font-size: 30rpx;
  color: #64739A;
  text-align: center;
  line-height: 1.6;
  padding: 0 48rpx;
}

/* 指示点 */
.dots {
  display: flex;
  gap: 16rpx;
  margin-bottom: 80rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background-color: #D9D9D9;
}

.dot-active {
  width: 48rpx;
  background-color: #6F3DFF;
}

/* 操作按钮 */
.action-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 120rpx;
}

.action-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
  background-color: #6F3DFF;
  color: #FFFFFF;
}

.action-btn:active {
  opacity: 0.8;
}

.skip-link {
  font-size: 28rpx;
  color: #98A1B8;
  margin-top: 32rpx;
}
