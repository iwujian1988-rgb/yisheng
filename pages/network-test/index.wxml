<view class="test-container">
  <view class="action-section">
    <button class="btn btn-primary test-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="startTest">
      {{loading ? '检测中' : '开始检测'}}
    </button>
  </view>

  <view class="results-section" wx:if="{{results.length > 0}}">
    <view class="result-item" wx:for="{{results}}" wx:key="key">
      <view class="result-left">
        <text class="result-name">{{item.name}}</text>
        <text class="result-message">{{item.message}}</text>
      </view>
      <view class="result-right">
        <text class="result-status status-{{item.status}}">{{item.statusText}}</text>
      </view>
    </view>
  </view>
</view>
