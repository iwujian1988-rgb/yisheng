.test-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 24rpx 32rpx;
}

.action-section {
  margin-bottom: 56rpx;
}

.test-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
  background-color: #6F3DFF;
  color: #ffffff;
}

.results-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 40rpx;
}

.result-left {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.result-name {
  font-size: 30rpx;
  color: #101936;
}

.result-message {
  font-size: 24rpx;
  color: #64748b;
  word-break: break-all;
}

.result-status {
  font-size: 28rpx;
  margin-left: 24rpx;
}

.status-pass {
  color: #52c41a;
}

.status-fail {
  color: #f5222d;
}

.status-warn {
  color: #faad14;
}
