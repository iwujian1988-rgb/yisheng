/* pages/settings/notifications.wxss */
.notifications-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 24rpx 32rpx;
}

.setting-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 0 40rpx;
  margin-bottom: 64rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
}

.setting-left {
  flex: 1;
  margin-right: 24rpx;
}

.setting-label {
  font-size: 30rpx;
  color: #101936;
  display: block;
  margin-bottom: 4rpx;
}

.setting-desc {
  font-size: 24rpx;
  color: #98A1B8;
  display: block;
}

.setting-divider {
  height: 2rpx;
  background-color: rgba(111, 61, 255, 0.08);
}

.save-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
  background-color: #6F3DFF;
  color: #FFFFFF;
}

.save-btn:active {
  opacity: 0.8;
}
