/* pages/settings/notifications.wxss */
.notifications-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px;
}

.setting-card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 0 20px;
  margin-bottom: 32px;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 0;
}

.setting-left {
  flex: 1;
  margin-right: 12px;
}

.setting-label {
  font-size: 15px;
  color: #333333;
  display: block;
  margin-bottom: 2px;
}

.setting-desc {
  font-size: 12px;
  color: #999999;
  display: block;
}

.setting-divider {
  height: 1px;
  background-color: #F0F0F0;
}

.save-btn {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
  background-color: #4A90E2;
  color: #FFFFFF;
}

.save-btn:active {
  opacity: 0.8;
}
