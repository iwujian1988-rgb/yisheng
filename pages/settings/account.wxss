.account-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 16px 32px;
  box-sizing: border-box;
}

.account-hero {
  background-color: #FFFFFF;
  border-radius: 12px;
  padding: 8px 20px;
  margin-bottom: 16px;
}

.account-hero__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 0;
  border-bottom: 1px solid #F0F2F5;
}

.account-hero__row:last-child {
  border-bottom: none;
}

.account-hero__label {
  font-size: 14px;
  color: #666666;
}

.account-hero__value {
  font-size: 15px;
  color: #333333;
  font-weight: 500;
}

.account-section-title {
  font-size: 12px;
  color: #999999;
  padding: 8px 4px;
  margin-top: 8px;
}

.setting-card {
  background-color: #FFFFFF;
  border-radius: 12px;
  padding: 0 20px;
  margin-bottom: 12px;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 0;
  border-bottom: 1px solid #F0F2F5;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-left {
  flex: 1;
  margin-right: 12px;
}

.setting-label {
  font-size: 15px;
  color: #333333;
  display: block;
  margin-bottom: 2px;
}

.setting-desc {
  font-size: 12px;
  color: #999999;
  display: block;
  line-height: 1.5;
}

.danger {
  color: #F5222D;
}

.setting-arrow {
  font-size: 16px;
  color: #CCCCCC;
  flex-shrink: 0;
}

.account-footer {
  padding: 24px 16px;
  text-align: center;
}

.account-footer__text {
  font-size: 12px;
  color: #BBBBBB;
  line-height: 1.6;
}
