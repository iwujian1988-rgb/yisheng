.account-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 32rpx 32rpx 64rpx;
  box-sizing: border-box;
}

.account-hero {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 16rpx 40rpx;
  margin-bottom: 32rpx;
}

.account-hero__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #F0F2F5;
}

.account-hero__row:last-child {
  border-bottom: none;
}

.account-hero__label {
  font-size: 28rpx;
  color: #64739A;
}

.account-hero__value {
  font-size: 30rpx;
  color: #101936;
  font-weight: 500;
}

.account-section-title {
  font-size: 24rpx;
  color: #98A1B8;
  padding: 16rpx 8rpx;
  margin-top: 16rpx;
}

.setting-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 0 40rpx;
  margin-bottom: 24rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 2rpx solid #F0F2F5;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-left {
  flex: 1;
  margin-right: 24rpx;
}

.setting-label {
  font-size: 30rpx;
  color: #101936;
  display: block;
  margin-bottom: 4rpx;
}

.setting-desc {
  font-size: 24rpx;
  color: #98A1B8;
  display: block;
  line-height: 1.5;
}

.danger {
  color: #F5222D;
}

.setting-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
  flex-shrink: 0;
}

.account-footer {
  padding: 48rpx 32rpx;
  text-align: center;
}

.account-footer__text {
  font-size: 24rpx;
  color: #BBBBBB;
  line-height: 1.6;
}
