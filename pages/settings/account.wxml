<view class="account-container">
  <view class="account-hero">
    <view class="account-hero__row">
      <text class="account-hero__label">手机号</text>
      <text class="account-hero__value">{{phone || '未绑定'}}</text>
    </view>
    <view class="account-hero__row">
      <text class="account-hero__label">会员状态</text>
      <text class="account-hero__value">{{memberText}}</text>
    </view>
    <view class="account-hero__row">
      <text class="account-hero__label">账号状态</text>
      <text class="account-hero__value">{{statusText}}</text>
    </view>
  </view>

  <view class="account-section-title">法律文件</view>
  <view class="setting-card">
    <view class="setting-item" bindtap="goToAgreement">
      <view class="setting-left">
        <text class="setting-label">用户协议</text>
      </view>
      <text class="setting-arrow">›</text>
    </view>
    <view class="setting-item" bindtap="goToPrivacy">
      <view class="setting-left">
        <text class="setting-label">隐私政策</text>
      </view>
      <text class="setting-arrow">›</text>
    </view>
  </view>

  <view class="account-section-title">账号操作</view>
  <view class="setting-card">
    <view class="setting-item" bindtap="onCancelAccount">
      <view class="setting-left">
        <text class="setting-label danger">注销账号</text>
        <text class="setting-desc">注销后历史记录、短语、片段、会员权益将一并清除且无法恢复</text>
      </view>
      <text class="setting-arrow danger">›</text>
    </view>
  </view>

  <view class="account-footer">
    <text class="account-footer__text">如遇账号问题，可联系客服：{{contactEmail}}</text>
  </view>
</view>
