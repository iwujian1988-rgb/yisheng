/* pages/settings/system-guide.wxss */
.guide-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px 48px;
}

/* 模式卡片 */
.mode-card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 20px;
  margin-bottom: 16px;
}

.mode-header {
  display: flex;
  align-items: center;
  margin-bottom: 12px;
}

.mode-badge {
  font-size: 11px;
  font-weight: 600;
  color: #FFFFFF;
  padding: 4px 10px;
  border-radius: 4px;
  margin-right: 10px;
}

.badge-win10 {
  background-color: #4A90E2;
}

.badge-win11 {
  background-color: #52C41A;
}

.badge-raw {
  background-color: #FAAD14;
}

.mode-name {
  font-size: 16px;
  font-weight: 500;
  color: #333333;
}

.mode-body {
  margin-bottom: 16px;
}

.mode-desc {
  font-size: 14px;
  color: #666666;
  line-height: 1.8;
  display: block;
  margin-bottom: 8px;
}

.mode-hint {
  font-size: 13px;
  color: #4A90E2;
  display: block;
}

/* 按钮 */
.mode-btn {
  width: 100%;
  height: 44px;
  border-radius: 8px;
  font-size: 15px;
  font-weight: 500;
  background-color: #4A90E2;
  color: #FFFFFF;
}

.mode-btn:active {
  opacity: 0.8;
}
