/* pages/settings/system-guide.wxss */
.guide-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 32rpx 64rpx 96rpx;
}

/* 模式卡片 */
.mode-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 32rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.mode-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.mode-badge {
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  margin-right: 20rpx;
}

.badge-win10 {
  background-color: #6F3DFF;
}

.badge-win11 {
  background-color: #52C41A;
}

.badge-raw {
  background-color: #FAAD14;
}

.mode-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #101936;
}

.mode-body {
  margin-bottom: 32rpx;
}

.mode-desc {
  font-size: 28rpx;
  color: #64739A;
  line-height: 1.8;
  display: block;
  margin-bottom: 16rpx;
}

.mode-hint {
  font-size: 26rpx;
  color: #6F3DFF;
  display: block;
}

/* 按钮 */
.mode-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
  background-color: #6F3DFF;
  color: #FFFFFF;
}

.mode-btn:active {
  opacity: 0.8;
}
