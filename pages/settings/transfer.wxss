/* pages/settings/transfer.wxss */
.settings-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px;
}

/* 区块 */
.section {
  margin-bottom: 32px;
}

.section-title {
  font-size: 16px;
  font-weight: 500;
  color: #333333;
  margin-bottom: 12px;
  display: block;
}

/* 选项组 */
.option-group {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.option-card {
  background-color: #FFFFFF;
  border: 2px solid #E5E5E5;
  border-radius: 8px;
  padding: 16px;
  display: flex;
  flex-direction: column;
}

.option-card.option-active {
  border-color: #4A90E2;
  background-color: rgba(74, 144, 226, 0.04);
}

.option-name {
  font-size: 15px;
  font-weight: 500;
  color: #333333;
  margin-bottom: 4px;
}

.option-active .option-name {
  color: #4A90E2;
}

.option-desc {
  font-size: 13px;
  color: #999999;
}

/* 保存按钮 */
.save-btn {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
  background-color: #4A90E2;
  color: #FFFFFF;
  margin-top: 16px;
}

.save-btn:active {
  opacity: 0.8;
}
