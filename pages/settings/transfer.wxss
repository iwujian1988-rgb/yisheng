/* pages/settings/transfer.wxss */
.settings-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}

/* 区块 */
.section {
  margin-bottom: 64rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #101936;
  margin-bottom: 16rpx;
  display: block;
}

.section-hint {
  font-size: 26rpx;
  color: #98A1B8;
  margin-bottom: 24rpx;
  display: block;
  line-height: 1.5;
}

/* 选项组 */
.option-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option-card {
  background-color: #FFFFFF;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4rpx 14rpx rgba(61, 42, 140, 0.03);
}

.option-card.option-active {
  border-color: #6F3DFF;
  background-color: #F2EDFF;
}

.option-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #101936;
  margin-bottom: 8rpx;
}

.option-active .option-name {
  color: #6F3DFF;
}

.option-desc {
  font-size: 26rpx;
  color: #98A1B8;
}

