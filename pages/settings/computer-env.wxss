/* pages/settings/computer-env.wxss */
.env-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px 48px;
}

/* 卡片 */
.card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 20px;
  margin-bottom: 24px;
}

.card-title {
  font-size: 16px;
  font-weight: 500;
  color: #333333;
  display: block;
  margin-bottom: 14px;
}

/* 选项 */
.env-item {
  display: flex;
  align-items: flex-start;
  padding: 14px 0;
  border-bottom: 1px solid #F0F0F0;
}

.env-item:last-child {
  border-bottom: none;
}

.env-info {
  margin-left: 8px;
  flex: 1;
}

.env-name {
  font-size: 15px;
  color: #333333;
  display: block;
  margin-bottom: 4px;
}

.env-desc {
  font-size: 13px;
  color: #999999;
  display: block;
}

/* 保存按钮 */
.save-btn {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
  background-color: #4A90E2;
  color: #FFFFFF;
}

.save-btn:active {
  opacity: 0.8;
}

.save-btn[disabled] {
  background-color: #CCCCCC;
  color: #FFFFFF;
}
