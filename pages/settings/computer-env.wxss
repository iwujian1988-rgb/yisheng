/* pages/settings/computer-env.wxss */
.env-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 32rpx 64rpx 96rpx;
}

/* 卡片 */
.card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 48rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #101936;
  display: block;
  margin-bottom: 28rpx;
}

/* 选项 */
.env-item {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 0;
  border-bottom: 2rpx solid rgba(111, 61, 255, 0.08);
}

.env-item:last-child {
  border-bottom: none;
}

.env-info {
  margin-left: 16rpx;
  flex: 1;
}

.env-name {
  font-size: 30rpx;
  color: #101936;
  display: block;
  margin-bottom: 8rpx;
}

.env-desc {
  font-size: 26rpx;
  color: #98A1B8;
  display: block;
}

/* 保存按钮 */
.save-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
  background-color: #6F3DFF;
  color: #FFFFFF;
}

.save-btn:active {
  opacity: 0.8;
}

.save-btn[disabled] {
  background-color: #CCCCCC;
  color: #FFFFFF;
}
