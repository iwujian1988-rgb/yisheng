/* pages/settings/speed-calibration.wxss */
.calibration-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px 48px;
}

/* 卡片 */
.card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 20px;
  margin-bottom: 12px;
}

.card-title {
  font-size: 16px;
  font-weight: 500;
  color: #333333;
  display: block;
  margin-bottom: 14px;
}

.card-desc {
  font-size: 14px;
  color: #666666;
  line-height: 1.6;
  display: block;
  margin-bottom: 16px;
}

/* 档位列表 */
.tier-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.tier-item {
  padding-bottom: 16px;
  border-bottom: 1px solid #F0F0F0;
}

.tier-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.tier-header {
  display: flex;
  align-items: center;
  margin-bottom: 6px;
}

.tier-badge {
  font-size: 12px;
  font-weight: 500;
  color: #FFFFFF;
  padding: 4px 10px;
  border-radius: 4px;
  margin-right: 10px;
}

.badge-safe {
  background-color: #4A90E2;
}

.badge-balanced {
  background-color: #52C41A;
}

.badge-turbo {
  background-color: #FAAD14;
}

.tier-name {
  font-size: 14px;
  font-weight: 500;
  color: #333333;
}

.tier-desc {
  font-size: 13px;
  color: #999999;
  line-height: 1.6;
}

/* 校准按钮 */
.calibrate-btn {
  width: 100%;
  height: 44px;
  border-radius: 8px;
  font-size: 15px;
  font-weight: 500;
  background-color: #4A90E2;
  color: #FFFFFF;
}

.calibrate-btn:active {
  opacity: 0.8;
}

/* 结果 */
.result-text {
  font-size: 14px;
  color: #333333;
  line-height: 1.8;
}
