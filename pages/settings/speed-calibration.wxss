/* pages/settings/speed-calibration.wxss */
.calibration-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 32rpx 64rpx 96rpx;
}

/* 卡片 */
.card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #101936;
  display: block;
  margin-bottom: 28rpx;
}

.card-desc {
  font-size: 28rpx;
  color: #64739A;
  line-height: 1.6;
  display: block;
  margin-bottom: 32rpx;
}

/* 档位列表 */
.tier-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.tier-item {
  padding-bottom: 32rpx;
  border-bottom: 2rpx solid rgba(111, 61, 255, 0.08);
}

.tier-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.tier-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.tier-badge {
  font-size: 24rpx;
  font-weight: 500;
  color: #FFFFFF;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  margin-right: 20rpx;
}

.badge-safe {
  background-color: #6F3DFF;
}

.badge-balanced {
  background-color: #52C41A;
}

.badge-turbo {
  background-color: #FAAD14;
}

.tier-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #101936;
}

.tier-desc {
  font-size: 26rpx;
  color: #98A1B8;
  line-height: 1.6;
}

/* 校准按钮 */
.calibrate-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
  background-color: #6F3DFF;
  color: #FFFFFF;
}

.calibrate-btn:active {
  opacity: 0.8;
}

/* 结果 */
.result-text {
  font-size: 28rpx;
  color: #101936;
  line-height: 1.8;
}
