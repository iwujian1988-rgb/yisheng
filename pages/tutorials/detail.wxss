/* pages/tutorials/detail.wxss */
.detail-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 32rpx 64rpx 96rpx;
}

/* 标题 */
.title-section {
  margin-bottom: 56rpx;
}

.detail-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #101936;
  line-height: 1.4;
}

.section-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #101936;
  margin-bottom: 24rpx;
  display: block;
}

/* 步骤列表 */
.steps-section {
  margin-bottom: 56rpx;
}

.step-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.step-item {
  display: flex;
  align-items: flex-start;
}

.step-num-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #6F3DFF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.step-num-text {
  font-size: 26rpx;
  color: #FFFFFF;
}

.step-content {
  font-size: 30rpx;
  color: #101936;
  line-height: 48rpx;
  flex: 1;
}

/* 注意事项 */
.notice-section {
  margin-bottom: 56rpx;
}

.notice-box {
  background-color: rgba(250, 173, 20, 0.08);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
}

.notice-text {
  font-size: 28rpx;
  color: #64739A;
  line-height: 1.8;
  display: block;
}
