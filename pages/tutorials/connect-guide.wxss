/* pages/tutorials/connect-guide.wxss */
.guide-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px 48px;
}

.section-label {
  font-size: 15px;
  font-weight: 500;
  color: #333333;
  margin-bottom: 12px;
  display: block;
}

/* 步骤 */
.steps-section {
  margin-bottom: 28px;
}

.step-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.step-item {
  display: flex;
  align-items: flex-start;
}

.step-num-circle {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background-color: #4A90E2;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
  flex-shrink: 0;
}

.step-num-text {
  font-size: 13px;
  color: #FFFFFF;
}

.step-content {
  font-size: 15px;
  color: #333333;
  line-height: 24px;
  flex: 1;
}

/* 指示灯 */
.led-section {
  margin-bottom: 28px;
}

.led-card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 16px 20px;
}

.led-item {
  display: flex;
  align-items: center;
  padding: 8px 0;
}

.led-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  margin-right: 12px;
  flex-shrink: 0;
}

.led-green {
  background-color: #52C41A;
}

.led-yellow {
  background-color: #FAAD14;
}

.led-red {
  background-color: #F5222D;
}

.led-text {
  font-size: 14px;
  color: #333333;
}

/* 常见问题入口 */
.faq-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 16px 20px;
}

.faq-text {
  font-size: 15px;
  color: #4A90E2;
}

.faq-arrow {
  font-size: 12px;
  color: #CCCCCC;
}
