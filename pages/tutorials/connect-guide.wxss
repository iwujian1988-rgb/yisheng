/* pages/tutorials/connect-guide.wxss */
.guide-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 32rpx 64rpx 96rpx;
}

.section-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #101936;
  margin-bottom: 24rpx;
  display: block;
}

/* 步骤 */
.steps-section {
  margin-bottom: 56rpx;
}

.step-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.step-item {
  display: flex;
  align-items: flex-start;
}

.step-num-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #6F3DFF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.step-num-text {
  font-size: 26rpx;
  color: #FFFFFF;
}

.step-content {
  font-size: 30rpx;
  color: #101936;
  line-height: 48rpx;
  flex: 1;
}

/* 指示灯 */
.led-section {
  margin-bottom: 56rpx;
}

.led-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 40rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.led-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.led-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.led-green {
  background-color: #52C41A;
}

.led-yellow {
  background-color: #FAAD14;
}

.led-red {
  background-color: #F5222D;
}

.led-text {
  font-size: 28rpx;
  color: #101936;
}

/* 常见问题入口 */
.faq-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 40rpx;
}

.faq-text {
  font-size: 30rpx;
  color: #6F3DFF;
}

.faq-arrow {
  font-size: 24rpx;
  color: #CCCCCC;
}
