<!--pages/tutorials/index.wxml-->
<view class="tutorials-container">
  <!-- 分类 tab -->
  <view class="tab-bar">
    <view
      class="tab-item {{activeTab === item.key ? 'tab-active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      bindtap="switchTab"
      data-key="{{item.key}}"
    >
      <text class="tab-text">{{item.name}}</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-section" wx:if="{{tutorials.length === 0}}">
    <view class="empty-icon">
      <text class="empty-icon-text">&#9998;</text>
    </view>
    <text class="empty-title">暂无教程</text>
    <text class="empty-desc">教程内容正在准备中</text>
  </view>

  <!-- 教程列表 -->
  <view class="list-section" wx:if="{{tutorials.length > 0}}">
    <view class="tutorial-card" wx:for="{{tutorials}}" wx:key="id">
      <text class="tutorial-title">{{item.title}}</text>
      <text class="tutorial-desc">{{item.desc}}</text>
    </view>
  </view>
</view>
