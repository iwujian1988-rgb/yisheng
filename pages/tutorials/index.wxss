.tutorials-container {
  min-height: 100vh;
  padding: 32rpx 28rpx 72rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f4f1ff 0, #fcfbff 320rpx);
}

.page-hero { padding: 20rpx 16rpx 34rpx; }
.page-title { display: block; color: #101936; font-size: 42rpx; font-weight: 700; }

.guide-card, .faq-card {
  margin-bottom: 20rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(111, 61, 255, .10);
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(30, 22, 79, .04);
}

.guide-title { display: block; margin-bottom: 22rpx; color: #332060; font-size: 32rpx; font-weight: 700; }
.step-text { display: block; margin-top: 12rpx; color: #455271; font-size: 28rpx; line-height: 42rpx; }
