<!--pages/tutorials/detail.wxml-->
<view class="detail-container">
  <!-- 标题 -->
  <view class="title-section">
    <text class="detail-title">{{title || '加载中...'}}</text>
  </view>

  <!-- 步骤列表 -->
  <view class="steps-section" wx:if="{{steps.length > 0}}">
    <text class="section-label">操作步骤</text>
    <view class="step-list">
      <view class="step-item" wx:for="{{steps}}" wx:key="index">
        <view class="step-num-circle">
          <text class="step-num-text">{{index + 1}}</text>
        </view>
        <text class="step-content">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 注意事项 -->
  <view class="notice-section" wx:if="{{notices.length > 0}}">
    <text class="section-label">注意事项</text>
    <view class="notice-box">
      <text class="notice-text" wx:for="{{notices}}" wx:key="index">{{item}}</text>
    </view>
  </view>
</view>
