/* pages/register/register.wxss */
.register-container {
  min-height: 100vh;
  padding: 0 32rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FCFBFF 100%);
  display: flex;
  flex-direction: column;
}

/* 标题区域 */
.header-section {
  margin-top: 160rpx;
  margin-bottom: 80rpx;
}

.page-title {
  font-size: 56rpx;
  font-weight: bold;
  color: #101936;
  display: block;
  margin-bottom: 16rpx;
}

.page-desc {
  font-size: 28rpx;
  color: #98A1B8;
  display: block;
}

/* 表单 */
.form-section {
  width: 100%;
  margin-bottom: 64rpx;
}

.input-group {
  margin-bottom: 48rpx;
}

.input-label {
  font-size: 28rpx;
  color: #101936;
  font-weight: 500;
  margin-bottom: 16rpx;
  display: block;
}

.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.input {
  flex: 1;
  height: 104rpx;
  padding: 0 32rpx;
  background-color: #FFFFFF;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  border-radius: 24rpx;
  font-size: 30rpx;
  color: #101936;
  box-sizing: border-box;
}

.input:focus {
  border-color: #6F3DFF;
  box-shadow: 0 0 0 6rpx rgba(111, 61, 255, 0.1);
}

.input-placeholder {
  color: #98A1B8;
}

/* 清除按钮 */
.clear-icon {
  position: absolute;
  right: 32rpx;
  width: 40rpx;
  height: 40rpx;
  font-size: 36rpx;
  color: #98A1B8;
  text-align: center;
  line-height: 40rpx;
}

/* 验证码 */
.code-wrapper {
  display: flex;
  gap: 24rpx;
}

.code-input {
  flex: 1;
}

.code-btn {
  width: 240rpx;
  height: 104rpx;
  line-height: 104rpx;
  padding: 0;
  background-color: #6F3DFF;
  color: #FFFFFF;
  border: none;
  border-radius: 999rpx;
  font-size: 28rpx;
  text-align: center;
  flex-shrink: 0;
}

.code-btn.disabled {
  background-color: #CCCCCC;
  color: #FFFFFF;
}

/* 密码 */
.password-wrapper {
  position: relative;
}

.password-input {
  padding-right: 96rpx;
}

.eye-icon {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
}

/* 密码强度 */
.strength-bar {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  gap: 12rpx;
}

.strength-segment {
  flex: 1;
  height: 8rpx;
  border-radius: 20rpx;
  background-color: rgba(111, 61, 255, 0.12);
}

.strength-segment.strength-weak {
  background-color: #F5222D;
}

.strength-segment.strength-medium {
  background-color: #FAAD14;
}

.strength-segment.strength-strong {
  background-color: #52C41A;
}

.strength-label {
  font-size: 24rpx;
  color: #98A1B8;
  margin-left: 8rpx;
  width: 48rpx;
}

/* 错误提示 */
.error-text {
  font-size: 24rpx;
  color: #F5222D;
  margin-top: 8rpx;
  display: block;
}

/* 注册按钮 */
.register-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
}

/* 协议 */
.agreement-section {
  width: 100%;
  margin-top: 40rpx;
  margin-bottom: 48rpx;
}

.agreement-label {
  display: flex;
  align-items: center;
  font-size: 26rpx;
}

.agreement-text {
  color: #64739A;
  margin-left: 16rpx;
}

.agreement-link {
  color: #6F3DFF;
  margin: 0 4rpx;
}

/* 返回登录 */
.login-section {
  margin-top: auto;
  margin-bottom: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-text {
  font-size: 28rpx;
  color: #64739A;
}

.login-link {
  font-size: 28rpx;
  color: #6F3DFF;
  margin-left: 8rpx;
}
