/* pages/help/help.wxss */
.help-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}

/* FAQ 列表 */
.faq-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.faq-item {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 0 40rpx;
  overflow: hidden;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-shadow: 0 4rpx 14rpx rgba(61, 42, 140, 0.03);
}

.faq-question {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 36rpx 0;
}

.question-text {
  font-size: 30rpx;
  color: #101936;
  font-weight: 500;
  flex: 1;
  padding-right: 24rpx;
}

.question-arrow {
  font-size: 24rpx;
  color: #CCCCCC;
  transition: transform 0.2s;
  transform: rotate(0deg);
}

.question-arrow.expanded {
  transform: rotate(90deg);
}

.faq-answer {
  padding-bottom: 36rpx;
}

.answer-text {
  font-size: 28rpx;
  color: #64739A;
  line-height: 1.8;
}

/* 底部联系 */
.contact-section {
  margin-top: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.contact-desc {
  font-size: 28rpx;
  color: #98A1B8;
  margin-bottom: 32rpx;
}

.contact-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
  background-color: #6F3DFF;
  color: #FFFFFF;
  border: none;
  line-height: 104rpx;
}

.contact-btn:active {
  opacity: 0.8;
}
