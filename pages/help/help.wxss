/* pages/help/help.wxss */
.help-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px;
}

/* FAQ 列表 */
.faq-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.faq-item {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 0 20px;
  overflow: hidden;
}

.faq-question {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 0;
}

.question-text {
  font-size: 15px;
  color: #333333;
  font-weight: 500;
  flex: 1;
  padding-right: 12px;
}

.question-arrow {
  font-size: 12px;
  color: #CCCCCC;
  transition: transform 0.2s;
  transform: rotate(0deg);
}

.question-arrow.expanded {
  transform: rotate(90deg);
}

.faq-answer {
  padding-bottom: 18px;
}

.answer-text {
  font-size: 14px;
  color: #666666;
  line-height: 1.8;
}

/* 底部联系 */
.contact-section {
  margin-top: 40px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.contact-desc {
  font-size: 14px;
  color: #999999;
  margin-bottom: 16px;
}

.contact-btn {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
  background-color: #4A90E2;
  color: #FFFFFF;
  border: none;
  line-height: 52px;
}

.contact-btn:active {
  opacity: 0.8;
}
