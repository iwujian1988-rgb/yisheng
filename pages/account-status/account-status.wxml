<view class="status-container">
  <view class="status-card" wx:if="{{status === 'unpaid'}}">
    <view class="icon-wrapper icon-unpaid">
      <text class="status-icon-text">!</text>
    </view>
    <text class="status-title">服务未开通</text>
    <text class="status-desc">当前账号还不能进入首页。请输入购买设备后获得的激活码，开通后再连接设备使用。</text>
    <button class="btn btn-primary action-btn" bindtap="goToActivation">输入激活码</button>
    <text class="help-link" bindtap="contactSupport">没有激活码，联系客服</text>
  </view>

  <view class="status-card" wx:if="{{status === 'active'}}">
    <view class="icon-wrapper icon-unbound">
      <text class="status-icon-text">✓</text>
    </view>
    <text class="status-title">账号可用</text>
    <text class="status-desc">服务已开通。进入首页后，请先连接设备，再使用文本传输和会员能力。</text>
    <button class="btn btn-primary action-btn" bindtap="goHome">进入首页</button>
  </view>

  <view class="status-card" wx:if="{{status === 'expired'}}">
    <view class="icon-wrapper icon-expired">
      <text class="status-icon-text">!</text>
    </view>
    <text class="status-title">服务已过期</text>
    <text class="status-desc">当前服务已到期，请续费或输入新的激活码后继续使用。</text>
    <button class="btn btn-primary action-btn" bindtap="goToActivation">输入激活码</button>
    <text class="help-link" bindtap="contactSupport">联系客服</text>
  </view>

  <view class="status-card" wx:if="{{status === 'conflict'}}">
    <view class="icon-wrapper icon-conflict">
      <text class="status-icon-text">!</text>
    </view>
    <text class="status-title">设备状态异常</text>
    <text class="status-desc">当前账号存在设备记录冲突，请联系客服处理后再使用。</text>
    <button class="btn btn-primary action-btn" bindtap="contactSupport">联系客服</button>
    <text class="info-text">设备 SN：{{deviceSN || '未知'}}</text>
  </view>

  <view class="status-card" wx:if="{{status === 'disabled'}}">
    <view class="icon-wrapper icon-disabled">
      <text class="status-icon-text">×</text>
    </view>
    <text class="status-title">账号已停用</text>
    <text class="status-desc">当前账号已停用，如有疑问请联系客服处理。</text>
    <button class="btn btn-primary action-btn" bindtap="contactSupport">联系客服</button>
  </view>

  <view class="bottom-section">
    <text class="back-link" bindtap="goBack">返回上一页</text>
  </view>
</view>
