/* pages/account-status/account-status.wxss */
.status-container {
  min-height: 100vh;
  padding: 0 32rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FCFBFF 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 状态卡片 */
.status-card {
  width: 100%;
  margin-top: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

/* 图标 */
.icon-wrapper {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}

.status-icon-text {
  font-size: 64rpx;
  color: #FFFFFF;
}

.icon-unpaid {
  background-color: #FAAD14;
}

.icon-unbound {
  background-color: #6F3DFF;
}

.icon-expired {
  background-color: #F5222D;
}

.icon-conflict {
  background-color: #FAAD14;
}

.icon-disabled {
  background-color: #98A1B8;
}

/* 文案 */
.status-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #101936;
  margin-bottom: 24rpx;
}

.status-desc {
  font-size: 28rpx;
  color: #64739A;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 64rpx;
  padding: 0 32rpx;
}

/* 按钮 */
.action-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
}

/* 辅助链接 */
.help-link {
  font-size: 28rpx;
  color: #6F3DFF;
  margin-top: 32rpx;
}

.info-text {
  font-size: 24rpx;
  color: #98A1B8;
  margin-top: 24rpx;
}

/* 调试区域 */
.debug-section {
  width: 100%;
  margin-top: 80rpx;
  padding: 32rpx;
  background-color: #FCFBFF;
  border-radius: 20rpx;
}

.debug-label {
  font-size: 24rpx;
  color: #98A1B8;
  display: block;
  margin-bottom: 16rpx;
}

.debug-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.debug-btn {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background-color: #FFFFFF;
  color: #64739A;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
}

.debug-btn.active {
  background-color: #6F3DFF;
  color: #FFFFFF;
  border-color: #6F3DFF;
}

/* 底部 */
.bottom-section {
  margin-top: auto;
  margin-bottom: 80rpx;
  padding-top: 48rpx;
}

.back-link {
  font-size: 28rpx;
  color: #6F3DFF;
}
