/* pages/metrics/long-text-dashboard.wxss */
.dashboard-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 32rpx 64rpx 96rpx;
  box-sizing: border-box;
}

.card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.target-card {
  background-color: rgba(111, 61, 255, 0.06);
  text-align: center;
}

.target-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #98A1B8;
}

.target-value {
  font-size: 44rpx;
  font-weight: 600;
  color: #6F3DFF;
}

.stats-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 36rpx 24rpx;
  text-align: center;
  min-width: 0;
  box-sizing: border-box;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.stat-num {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  color: #101936;
  word-break: break-all;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #98A1B8;
}

.section-label {
  display: block;
  margin: 32rpx 0 20rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #101936;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 40rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-date {
  display: block;
  font-size: 28rpx;
  color: #64739A;
  margin-bottom: 8rpx;
}

.record-meta {
  display: block;
  font-size: 26rpx;
  color: #98A1B8;
}

.record-result {
  flex-shrink: 0;
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.record-result.pass {
  color: #52C41A;
  background-color: rgba(82, 196, 26, 0.1);
}

.record-result.fail {
  color: #F5222D;
  background-color: rgba(245, 34, 45, 0.06);
}

.empty-section {
  display: flex;
  justify-content: center;
  padding-top: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #98A1B8;
}
