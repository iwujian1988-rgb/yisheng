/* pages/feedback/index.wxss */
.feedback-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 48rpx;
}

.section-label {
  font-size: 28rpx;
  color: #101936;
  font-weight: 500;
  margin-bottom: 20rpx;
  display: block;
}

/* 类型选择 */
.type-group {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.type-item {
  padding: 16rpx 36rpx;
  border-radius: 40rpx;
  background-color: #FFFFFF;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
}

.type-active {
  background-color: #F2EDFF;
  border-color: #6F3DFF;
}

.type-text {
  font-size: 28rpx;
  color: #101936;
}

.type-active .type-text {
  color: #6F3DFF;
}

/* 输入框 */
.textarea {
  width: 100%;
  height: 280rpx;
  padding: 28rpx 32rpx;
  background-color: #FFFFFF;
  border: 2rpx solid rgba(111, 61, 255, 0.14);
  border-radius: 24rpx;
  font-size: 30rpx;
  color: #101936;
  box-sizing: border-box;
  line-height: 1.6;
}

.textarea:focus {
  border-color: #6F3DFF;
}

.input {
  width: 100%;
  height: 96rpx;
  padding: 0 32rpx;
  background-color: #FFFFFF;
  border: 2rpx solid rgba(111, 61, 255, 0.14);
  border-radius: 20rpx;
  font-size: 30rpx;
  color: #101936;
  box-sizing: border-box;
}

.input:focus {
  border-color: #6F3DFF;
}

.input-placeholder {
  color: #98A1B8;
}

.char-count {
  font-size: 24rpx;
  color: #98A1B8;
  margin-top: 8rpx;
  display: block;
  text-align: right;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
  margin-top: 32rpx;
}

.btn-primary {
  background-color: #6F3DFF;
  color: #FFFFFF;
}

.btn-primary:active {
  opacity: 0.8;
}

.disabled {
  background-color: #CCCCCC;
  color: #FFFFFF;
}
