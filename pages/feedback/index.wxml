<!--pages/feedback/index.wxml-->
<view class="feedback-container">
  <view class="section">
    <text class="section-label">反馈类型</text>
    <view class="type-group">
      <view
        class="type-item {{activeType === item ? 'type-active' : ''}}"
        wx:for="{{typeOptions}}"
        wx:key="*this"
        bindtap="selectType"
        data-type="{{item}}"
      >
        <text class="type-text">{{item}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <text class="section-label">反馈内容</text>
    <textarea
      class="textarea"
      placeholder="请描述遇到的问题或建议"
      placeholder-class="input-placeholder"
      value="{{content}}"
      bindinput="onContentInput"
      maxlength="500"
    />
    <text class="char-count">{{content.length}}/500</text>
  </view>

  <view class="section">
    <text class="section-label">联系方式（选填）</text>
    <input
      class="input"
      placeholder="手机号或邮箱"
      placeholder-class="input-placeholder"
      value="{{contact}}"
      bindinput="onContactInput"
      maxlength="50"
    />
  </view>

  <button
    class="btn btn-primary submit-btn {{canSubmit ? '' : 'disabled'}}"
    disabled="{{!canSubmit}}"
    bindtap="submitFeedback"
  >
    提交反馈
  </button>
</view>
