/* pages/compliance/third-party-ai.wxss */
.ai-container { min-height: 100vh; background-color: #FCFBFF; padding: 24rpx 32rpx; }
.card { background-color: #FFFFFF; border-radius: 20rpx; padding: 40rpx; margin-bottom: 24rpx;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}
.section-header { display: flex; align-items: center; margin-bottom: 20rpx; }
.step-num { width: 48rpx; height: 48rpx; border-radius: 50%; background-color: #6F3DFF; color: #FFFFFF; font-size: 26rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; margin-right: 24rpx; flex-shrink: 0; }
.section-title { font-size: 30rpx; font-weight: 500; color: #101936; }
.section-desc { font-size: 28rpx; color: #64739A; line-height: 1.8; padding-left: 72rpx; }
