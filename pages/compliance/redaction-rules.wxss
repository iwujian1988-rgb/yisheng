/* pages/compliance/redaction-rules.wxss */
.rules-container { min-height: 100vh; background-color: #FCFBFF; padding: 24rpx 32rpx; }
.card { background-color: #FFFFFF; border-radius: 20rpx; padding: 40rpx; margin-bottom: 24rpx;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}
.card-title { font-size: 32rpx; font-weight: 500; color: #101936; display: block; margin-bottom: 28rpx; }
.card-desc { font-size: 28rpx; color: #64739A; line-height: 1.8; }
.field-item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 2rpx solid rgba(111, 61, 255, 0.08); }
.field-item:last-child { border-bottom: none; }
.field-dot { width: 12rpx; height: 12rpx; border-radius: 6rpx; background-color: #6F3DFF; margin-right: 20rpx; flex-shrink: 0; }
.field-text { font-size: 30rpx; color: #101936; }
