/* pages/compliance/redaction-rules.wxss */
.rules-container { min-height: 100vh; background-color: #F5F7FA; padding: 16px 32px; }
.card { background-color: #FFFFFF; border-radius: 8px; padding: 20px; margin-bottom: 12px; }
.card-title { font-size: 16px; font-weight: 500; color: #333333; display: block; margin-bottom: 14px; }
.card-desc { font-size: 14px; color: #666666; line-height: 1.8; }
.field-item { display: flex; align-items: center; padding: 10px 0; border-bottom: 1px solid #F0F0F0; }
.field-item:last-child { border-bottom: none; }
.field-dot { width: 6px; height: 6px; border-radius: 3px; background-color: #4A90E2; margin-right: 10px; flex-shrink: 0; }
.field-text { font-size: 15px; color: #333333; }
