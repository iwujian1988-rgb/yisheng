/* pages/purchase/records.wxss */
.records-container {
  min-height: 100vh;
  background-color: #FCFBFF;
}

/* 空状态 */
.empty-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 240rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #F2EDFF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}

.empty-icon-text {
  font-size: 72rpx;
  color: #6F3DFF;
}

.empty-title {
  font-size: 32rpx;
  color: #64739A;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #98A1B8;
}

/* 记录列表 */
.list-section {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 40rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.record-type {
  font-size: 30rpx;
  color: #101936;
  font-weight: 500;
}

.record-status {
  font-size: 26rpx;
}

.status-active {
  color: #52C41A;
}

.status-expired {
  color: #F5222D;
}

.status-pending {
  color: #FAAD14;
}

.record-time {
  font-size: 26rpx;
  color: #98A1B8;
}
