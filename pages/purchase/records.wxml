<!--pages/purchase/records.wxml-->
<view class="records-container">
  <!-- 空状态 -->
  <view class="empty-section" wx:if="{{records.length === 0}}">
    <view class="empty-icon">
      <text class="empty-icon-text">TPL</text>
    </view>
    <text class="empty-title">暂无服务记录</text>
    <text class="empty-desc">开通服务后记录会显示在这里</text>
  </view>

  <!-- 记录列表 -->
  <view class="list-section" wx:if="{{records.length > 0}}">
    <view class="record-card" wx:for="{{records}}" wx:key="id">
      <view class="record-header">
        <text class="record-type">{{item.type}}</text>
        <text class="record-status status-{{item.status}}">{{item.statusText}}</text>
      </view>
      <text class="record-time">{{item.time}}</text>
    </view>
  </view>
</view>
