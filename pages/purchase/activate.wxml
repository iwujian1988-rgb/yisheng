<view class="activate-container">
  <view class="hero-card">
    <text class="hero-title">输入激活码开通服务</text>
    <text class="hero-desc">激活后才能进入小程序首页，并连接设备使用文本传输和会员能力。</text>
  </view>

  <view class="form-section">
    <view class="input-group">
      <text class="input-label">激活码</text>
      <input
        class="input"
        placeholder="请输入激活码"
        placeholder-class="input-placeholder"
        value="{{code}}"
        bindinput="onCodeInput"
        maxlength="40"
        focus="{{true}}"
      />
      <text wx:if="{{codeError}}" class="error-text">{{codeError}}</text>
    </view>
  </view>

  <button
    class="submit-btn {{canSubmit ? 'submit-ready' : 'submit-disabled'}}"
    disabled="{{!canSubmit || isLoading}}"
    loading="{{isLoading}}"
    bindtap="submitActivation"
  >
    立即开通
  </button>

  <view class="help-card">
    <text class="help-title">没有激活码？</text>
    <text class="help-desc">请联系购买渠道或客服获取激活码。未激活前不能进入首页使用设备功能。</text>
    <button class="support-btn" bindtap="contactSupport">联系客服</button>
  </view>
</view>
