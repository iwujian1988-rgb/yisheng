.claim-page { min-height: 100vh; padding: 48rpx 32rpx; box-sizing: border-box; background: radial-gradient(circle at 100% 0, #ffe0b5 0, transparent 34%), #edf5ee; color: #17332a; }
.hero { display: flex; flex-direction: column; gap: 16rpx; margin: 24rpx 12rpx 48rpx; }
.eyebrow { color: #56806c; font-size: 24rpx; letter-spacing: 4rpx; }
.title { font-size: 52rpx; font-weight: 700; }
.desc, .card-desc, .help { font-size: 28rpx; line-height: 1.7; color: #5b6d64; }
.card { padding: 40rpx 32rpx; border: 2rpx solid #d2dfd5; border-radius: 28rpx; background: #fff; box-shadow: 0 18rpx 44rpx rgba(39, 84, 62, .12); }
.card-title { display: block; margin-bottom: 16rpx; font-size: 36rpx; font-weight: 700; }
.claim-button { margin-top: 36rpx; border-radius: 999rpx; color: #fff; background: #2d7254; font-size: 30rpx; }
.claim-button::after { border: 0; }
.success { display: block; margin-top: 28rpx; color: #28734f; font-size: 27rpx; }
.help { margin: 32rpx 12rpx; }
.help-link { display: block; margin-top: 12rpx; color: #2d7254; font-weight: 700; }
