/* pages/purchase/activate.wxss */
.activate-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px;
}

.intro-card {
  background-color: rgba(74, 144, 226, 0.08);
  border-radius: 8px;
  padding: 14px 16px;
  margin-bottom: 28px;
}

.intro-text {
  font-size: 14px;
  color: #4A90E2;
  line-height: 1.6;
}

.form-section {
  margin-bottom: 32px;
}

.input-group {
  margin-bottom: 0;
}

.input-label {
  font-size: 14px;
  color: #333333;
  font-weight: 500;
  margin-bottom: 8px;
  display: block;
}

.input {
  width: 100%;
  height: 52px;
  padding: 0 16px;
  background-color: #FFFFFF;
  border: 1px solid #E5E5E5;
  border-radius: 12px;
  font-size: 15px;
  color: #333333;
  box-sizing: border-box;
}

.input:focus {
  border-color: #4A90E2;
}

.input-placeholder {
  color: #999999;
}

.error-text {
  font-size: 12px;
  color: #F5222D;
  margin-top: 4px;
  display: block;
}

.submit-btn {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
}

.btn-primary {
  background-color: #4A90E2;
  color: #FFFFFF;
}

.btn-primary:active {
  opacity: 0.8;
}

.disabled {
  background-color: #CCCCCC;
  color: #FFFFFF;
}
