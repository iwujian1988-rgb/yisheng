.activate-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 32rpx;
  box-sizing: border-box;
}

.hero-card,
.help-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.hero-card {
  margin-bottom: 28rpx;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  line-height: 1.3;
  color: #18233C;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.hero-desc {
  display: block;
  font-size: 28rpx;
  line-height: 1.6;
  color: #5C667A;
}

.form-section {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.input-label {
  display: block;
  font-size: 28rpx;
  color: #18233C;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.input {
  width: 100%;
  height: 96rpx;
  padding: 0 24rpx;
  background-color: #F7F9FC;
  border: 2rpx solid #DCE3EE;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #18233C;
  box-sizing: border-box;
}

.input-placeholder {
  color: #9AA3B5;
}

.error-text {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #E5484D;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
  margin: 0 0 28rpx;
  border: none;
}

.submit-btn::after,
.support-btn::after {
  border: none;
}

.submit-ready {
  background-color: #1677FF;
  color: #FFFFFF;
}

.submit-disabled {
  background-color: #D8DDE6;
  color: #FFFFFF;
}

.help-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.help-title {
  font-size: 30rpx;
  color: #18233C;
  font-weight: 700;
}

.help-desc {
  font-size: 26rpx;
  line-height: 1.6;
  color: #5C667A;
}

.support-btn {
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  margin-top: 10rpx;
  background-color: #EEF5FF;
  color: #1677FF;
  font-size: 28rpx;
  font-weight: 600;
}
