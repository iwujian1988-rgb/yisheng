/* pages/purchase/index.wxss */
.purchase-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 0 32rpx 48rpx;
  box-sizing: border-box;
}

/* 开通说明 */
.intro-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
  margin-bottom: 64rpx;
}

.intro-icon {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background-color: #6F3DFF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.intro-icon-text {
  font-size: 64rpx;
  color: #FFFFFF;
}

.intro-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #101936;
  margin-bottom: 16rpx;
}

.intro-desc {
  font-size: 28rpx;
  color: #64739A;
  text-align: center;
  line-height: 1.6;
  padding: 0 32rpx;
}

/* AI 能力卡片 */
.abilities-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 80rpx;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-shadow: 0 6rpx 20rpx rgba(61, 42, 140, 0.04);
}

.steps-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #101936;
  margin-bottom: 32rpx;
  display: block;
}

.ability-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
}

.ability-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #F2EDFF;
  flex-shrink: 0;
}

.ability-title,
.ability-desc {
  display: block;
}

.ability-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #101936;
}

.ability-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #64739A;
}

/* 操作按钮 */
.action-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.action-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-primary {
  background-color: #6F3DFF;
  color: #FFFFFF;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-outline {
  background-color: transparent;
  color: #6F3DFF;
  border: 2rpx solid rgba(111, 61, 255, 0.24);
}
