<view class="page">
  <view class="toolbar">
    <t-input
      class="search"
      placeholder="搜索历史记录"
      value="{{keyword}}"
      bind:change="onSearchInput"
    />
    <t-button wx:if="{{items.length > 0}}" variant="text" theme="danger" size="small" bind:tap="clearAll">
      清空
    </t-button>
  </view>

  <view wx:if="{{!connected}}" class="warn-bar">
    <text>⚠️ 当前未连接蓝牙设备，无法重新发送（仅可复制/删除）</text>
  </view>

  <view wx:if="{{items.length === 0}}" class="empty">
    <t-empty description="还没有历史记录" />
  </view>

  <view wx:else class="list">
    <view wx:for="{{items}}" wx:key="id" class="item-card">
      <view class="item-head">
        <text class="item-preview">{{item.preview || '(空文本)'}}</text>
        <text class="item-meta">{{item.length}}字 · {{item.mode}}</text>
      </view>
      <view class="item-actions">
        <t-button
          variant="outline"
          size="small"
          data-id="{{item.id}}"
          bind:tap="resend"
        >
          去发送
        </t-button>
        <t-button variant="text" size="small" data-id="{{item.id}}" bind:tap="copy">
          复制
        </t-button>
        <t-button variant="text" theme="danger" size="small" data-id="{{item.id}}" bind:tap="remove">
          删除
        </t-button>
      </view>
    </view>
  </view>
</view>
