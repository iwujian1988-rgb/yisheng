.editor-container {
  min-height: 100vh;
  padding: 30rpx;
  padding-bottom: 150rpx;
  background: #FCFBFF;
  box-sizing: border-box;
}

.device-strip {
  min-height: 64rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #CCCCCC;
}

.status-dot.connected {
  background: #52C41A;
}

.device-strip-text {
  flex: 1;
  font-size: 26rpx;
  color: #64739A;
}

.device-strip-action {
  font-size: 26rpx;
  color: #6F3DFF;
  font-weight: 500;
}

.editor-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.editor-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.editor-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222222;
}

.char-count {
  font-size: 24rpx;
  color: #98A1B8;
}

.text-input {
  width: 100%;
  min-height: 420rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: #101936;
}

.editor-actions {
  margin-top: 20rpx;
}

.clear-btn {
  font-size: 26rpx;
  color: #6F3DFF;
}

.send-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 30rpx 44rpx;
  background: #FFFFFF;
  box-shadow: 0 -8rpx 30rpx rgba(0, 0, 0, 0.06);
  display: flex;
  gap: 18rpx;
  box-sizing: border-box;
}

.cancel-btn,
.send-btn {
  height: 92rpx;
  border-radius: 999rpx;
  border: none;
  font-size: 32rpx;
  font-weight: 600;
}

.cancel-btn::after,
.send-btn::after {
  border: none;
}

.cancel-btn {
  width: 150rpx;
  background: #FCFBFF;
  color: #64739A;
}

.send-btn {
  flex: 1;
  background: rgba(111, 61, 255, 0.12);
  color: #98A1B8;
}

.send-btn.active {
  background: #6F3DFF;
  color: #FFFFFF;
}
