/* pages/transfer/confirm.wxss */
.confirm-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 32rpx 64rpx 96rpx;
}

/* 卡片 */
.card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #101936;
}

.char-count {
  font-size: 26rpx;
  color: #98A1B8;
}

/* 文本预览 */
.text-preview {
  max-height: 480rpx;
}

.preview-text {
  font-size: 30rpx;
  line-height: 1.8;
  color: #101936;
  word-break: break-all;
}

/* 来源信息 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-label {
  font-size: 30rpx;
  color: #64739A;
}

.info-value {
  font-size: 30rpx;
  color: #101936;
}

/* 操作按钮 */
.action-section {
  margin-top: 64rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.action-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-primary {
  background-color: #6F3DFF;
  color: #FFFFFF;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-primary[disabled] {
  background-color: #CCCCCC;
  color: #FFFFFF;
}

.btn-outline {
  background-color: transparent;
  color: #6F3DFF;
  border: 2rpx solid #6F3DFF;
}
