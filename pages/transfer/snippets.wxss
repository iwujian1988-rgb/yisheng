.page { padding: 16rpx; background: #f5f6f8; min-height: 100vh; padding-bottom: 160rpx; }
.toolbar { margin-bottom: 16rpx; }
.search { background: #fff; border-radius: 12rpx; padding: 12rpx 24rpx; }
.warn-bar { background: #fff7e6; color: #d46b08; padding: 16rpx 24rpx; border-radius: 8rpx; margin-bottom: 16rpx; font-size: 26rpx; }
.empty { padding: 120rpx 0; }
.list { display: flex; flex-direction: column; gap: 16rpx; }
.item-card { background: #fff; border-radius: 12rpx; padding: 24rpx; }
.item-title { font-size: 30rpx; color: #333; font-weight: 600; margin-bottom: 12rpx; }
.item-text { font-size: 26rpx; color: #666; line-height: 1.6; margin-bottom: 16rpx; word-break: break-all; max-height: 200rpx; overflow: hidden; }
.item-foot { display: flex; justify-content: space-between; align-items: center; }
.item-ops { display: flex; gap: 8rpx; flex-wrap: wrap; }
.fab { position: fixed; right: 32rpx; bottom: 64rpx; width: 96rpx; height: 96rpx; border-radius: 50%; background: #1677ff; color: #fff; font-size: 60rpx; text-align: center; line-height: 96rpx; box-shadow: 0 8rpx 16rpx rgba(22,119,255,0.3); }
.dialog-form { padding: 16rpx 0; }
