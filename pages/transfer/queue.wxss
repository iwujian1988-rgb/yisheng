/* pages/transfer/queue.wxss */
.queue-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 32rpx 64rpx 96rpx;
}

/* 空状态 */
.empty-section {
  display: flex;
  justify-content: center;
  padding-top: 240rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #98A1B8;
}

/* 队列列表 */
.queue-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.queue-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.queue-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.queue-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #101936;
}

.queue-status {
  font-size: 26rpx;
}

.status-active {
  color: #6F3DFF;
}

.status-done {
  color: #52C41A;
}

.status-error {
  color: #F5222D;
}

/* 进度条 */
.progress-bar {
  height: 16rpx;
  background-color: rgba(111, 61, 255, 0.08);
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  background-color: #6F3DFF;
  border-radius: 20rpx;
}

.progress-text {
  font-size: 24rpx;
  color: #98A1B8;
}

/* 取消按钮 */
.action-section {
  margin-top: 64rpx;
}

.cancel-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-outline {
  background-color: transparent;
  color: #F5222D;
  border: 2rpx solid #F5222D;
}
