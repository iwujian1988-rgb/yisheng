.page { padding: 24rpx 32rpx 48rpx; background: #FCFBFF; min-height: 100vh; box-sizing: border-box; }
.toolbar { display: flex; align-items: center; gap: 12rpx; margin-bottom: 24rpx; }
.search { flex: 1; background: #fff; border: 2rpx solid rgba(111, 61, 255, 0.12); border-radius: 999rpx; padding: 18rpx 28rpx; }
.warn-bar { background: #FFF8E8; color: #8A5A00; padding: 18rpx 24rpx; border: 2rpx solid #FFE5AE; border-radius: 20rpx; margin-bottom: 24rpx; font-size: 24rpx; }
.empty { padding: 120rpx 0; }
.list { display: flex; flex-direction: column; gap: 16rpx; }
.item-card { background: #fff; border: 2rpx solid rgba(111, 61, 255, 0.12); border-radius: 24rpx; padding: 28rpx; box-shadow: 0 4rpx 14rpx rgba(61, 42, 140, 0.04); }
.item-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16rpx; gap: 16rpx; }
.item-preview { flex: 1; font-size: 28rpx; color: #101936; line-height: 1.55; word-break: break-all; }
.item-meta { font-size: 22rpx; color: #64739A; flex-shrink: 0; }
.item-actions { display: flex; gap: 16rpx; }
