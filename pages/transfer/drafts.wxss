/* pages/transfer/drafts.wxss */
.drafts-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 24rpx 32rpx;
}

/* 空状态 */
.empty-section {
  display: flex;
  justify-content: center;
  padding-top: 240rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #98A1B8;
}

/* 草稿列表 */
.draft-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.draft-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.draft-body {
  margin-bottom: 28rpx;
}

.draft-preview {
  font-size: 30rpx;
  color: #101936;
  line-height: 1.6;
  display: block;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.draft-meta {
  font-size: 24rpx;
  color: #98A1B8;
  display: block;
}

/* 操作 */
.draft-actions {
  display: flex;
  gap: 48rpx;
}

.action-link {
  font-size: 28rpx;
}

.action-edit {
  color: #6F3DFF;
}

.action-delete {
  color: #F5222D;
}
