/* pages/transfer/drafts.wxss */
.drafts-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px;
}

/* 空状态 */
.empty-section {
  display: flex;
  justify-content: center;
  padding-top: 120px;
}

.empty-text {
  font-size: 14px;
  color: #999999;
}

/* 草稿列表 */
.draft-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.draft-card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 20px;
}

.draft-body {
  margin-bottom: 14px;
}

.draft-preview {
  font-size: 15px;
  color: #333333;
  line-height: 1.6;
  display: block;
  margin-bottom: 8px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.draft-meta {
  font-size: 12px;
  color: #999999;
  display: block;
}

/* 操作 */
.draft-actions {
  display: flex;
  gap: 24px;
}

.action-link {
  font-size: 14px;
}

.action-edit {
  color: #4A90E2;
}

.action-delete {
  color: #F5222D;
}
