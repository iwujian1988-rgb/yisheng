.page { padding: 24rpx 32rpx 160rpx; background: #FCFBFF; min-height: 100vh; box-sizing: border-box; }
.cat-bar { white-space: nowrap; padding: 8rpx 0 24rpx; }
.cat-chip { display: inline-block; padding: 14rpx 24rpx; margin-right: 12rpx; background: #fff; border: 2rpx solid rgba(111, 61, 255, 0.12); border-radius: 999rpx; font-size: 24rpx; color: #64739A; }
.cat-chip.active { background: #6F3DFF; color: #fff; }
.warn-bar { background: #fff7e6; color: #d46b08; padding: 16rpx 24rpx; border-radius: 20rpx; margin-bottom: 16rpx; font-size: 26rpx; }
.empty { padding: 120rpx 0; }
.list { display: flex; flex-direction: column; gap: 16rpx; }
.item-card { background: #fff; border: 2rpx solid rgba(111, 61, 255, 0.12); border-radius: 24rpx; padding: 28rpx; box-shadow: 0 4rpx 14rpx rgba(61, 42, 140, 0.04); }
.item-text { font-size: 28rpx; color: #101936; line-height: 1.6; margin-bottom: 16rpx; word-break: break-all; }
.item-foot { display: flex; justify-content: space-between; align-items: center; }
.item-ops { display: flex; gap: 12rpx; }
.fab { position: fixed; right: 32rpx; bottom: 64rpx; width: 96rpx; height: 96rpx; border-radius: 50%; background: #6F3DFF; color: #fff; font-size: 60rpx; text-align: center; line-height: 96rpx; box-shadow: 0 12rpx 28rpx rgba(111,61,255,0.22); }
.dialog-form { padding: 16rpx 0; }
