/* pages/transfer/failure-reason.wxss */
.failure-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 32rpx 64rpx 96rpx;
}

/* 卡片 */
.card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.card-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #101936;
  display: block;
  margin-bottom: 28rpx;
}

/* 原因列表 */
.reason-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid rgba(111, 61, 255, 0.08);
}

.reason-item:last-child {
  border-bottom: none;
}

.reason-text {
  font-size: 30rpx;
  color: #101936;
  margin-left: 16rpx;
}

/* 问题描述 */
.desc-input {
  width: 100%;
  height: 240rpx;
  padding: 28rpx 32rpx;
  background-color: #FCFBFF;
  border-radius: 20rpx;
  font-size: 30rpx;
  color: #101936;
  line-height: 1.6;
  box-sizing: border-box;
}

.input-placeholder {
  color: #98A1B8;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
  margin-top: 48rpx;
  background-color: #6F3DFF;
  color: #FFFFFF;
}

.submit-btn:active {
  opacity: 0.8;
}

.submit-btn[disabled] {
  background-color: #CCCCCC;
  color: #FFFFFF;
}
