/* pages/transfer/failure-reason.wxss */
.failure-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px 48px;
}

/* 卡片 */
.card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 20px;
  margin-bottom: 12px;
}

.card-title {
  font-size: 15px;
  font-weight: 500;
  color: #333333;
  display: block;
  margin-bottom: 14px;
}

/* 原因列表 */
.reason-item {
  display: flex;
  align-items: center;
  padding: 14px 0;
  border-bottom: 1px solid #F0F0F0;
}

.reason-item:last-child {
  border-bottom: none;
}

.reason-text {
  font-size: 15px;
  color: #333333;
  margin-left: 8px;
}

/* 问题描述 */
.desc-input {
  width: 100%;
  height: 120px;
  padding: 14px 16px;
  background-color: #F5F7FA;
  border-radius: 8px;
  font-size: 15px;
  color: #333333;
  line-height: 1.6;
  box-sizing: border-box;
}

.input-placeholder {
  color: #999999;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
  margin-top: 24px;
  background-color: #4A90E2;
  color: #FFFFFF;
}

.submit-btn:active {
  opacity: 0.8;
}

.submit-btn[disabled] {
  background-color: #CCCCCC;
  color: #FFFFFF;
}
