<view class="ai-container">
  <view class="empty-section" wx:if="{{conversations.length === 0}}">
    <view class="empty-icon">
      <text class="empty-icon-text">&#9998;</text>
    </view>
    <text class="empty-title">暂无 AI 对话</text>
    <text class="empty-desc">新建对话后，可对文本进行润色、总结和格式整理。</text>
  </view>

  <view class="list-section" wx:if="{{conversations.length > 0}}">
    <view class="conversation-card" wx:for="{{conversations}}" wx:key="id">
      <text class="conversation-title">{{item.title}}</text>
      <text class="conversation-time">{{item.time}}</text>
    </view>
  </view>

  <view class="bottom-bar">
    <button class="new-chat-btn" bindtap="newConversation">新建对话</button>
  </view>
</view>
