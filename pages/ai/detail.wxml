<view class="detail-page">
  <view class="detail-chat-wrap" style="{{chatBottomStyle}}">
    <t-chat-list
      id="chatList"
      class="detail-chat-list"
      reverse="{{false}}"
      layout="both"
    >
      <view wx:if="{{messages.length === 0 && !sending}}" class="welcome-message">
        <view class="bot-avatar">智</view>
        <view class="welcome-bubble">
          <text class="welcome-title">从一段记录开始</text>
          <text class="welcome-desc">输入、粘贴、拍照或录音后，AI 会整理为可核对的内容草稿。</text>
          <view class="quick-prompts">
            <text class="quick-prompt" data-prompt="请整理以下文本记录：" bindtap="fillQuickPrompt">整理文本记录</text>
            <text class="quick-prompt" data-action="template" bindtap="fillQuickPrompt">选择模板整理</text>
            <text class="quick-prompt" data-prompt="请提取这段记录的重点：" bindtap="fillQuickPrompt">提取重点</text>
          </view>
        </view>
      </view>

      <view wx:if="{{templatesLoading}}" class="template-load-state">
        <t-loading theme="circular" size="30rpx" />
        <text>正在同步可用模板…</text>
      </view>
      <view wx:elif="{{templatesLoadError}}" class="template-load-state template-load-state--error" bindtap="prepareWorkspace">
        <text>{{templatesLoadError}}，点击重试</text>
      </view>

      <block wx:for="{{messages}}" wx:key="id">
        <view wx:if="{{item.role === 'user'}}" class="user-message-row">
          <view class="user-message-bubble">
            <view wx:if="{{item.rawAttachments && item.rawAttachments.length}}" class="user-message-images">
              <image wx:for="{{item.rawAttachments}}" wx:for-item="attachment" wx:key="id" class="user-message-image" src="{{attachment.previewUrl}}" mode="aspectFill" data-url="{{attachment.previewUrl}}" bindtap="previewSentImage" />
            </view>
            <text wx:if="{{item.content}}" selectable class="user-message-text">{{item.content}}</text>
          </view>
        </view>
        <view wx:elif="{{item.role === 'assistant' && item.isDocument && item.status === 'complete'}}" class="document-message">
          <view class="ai-msg-avatar">智</view>
          <view class="document-card">
            <view class="document-card__head">
              <view><text class="document-card__title">{{item.isPartial ? '未完成草稿' : '内容草稿'}}</text><text class="document-card__sub">AI 整理·尚未核对</text></view>
              <text class="document-card__copy" bindtap="copyResult" data-id="{{item.id}}">复制</text>
            </view>
            <text class="document-card__body">{{item.bodyText}}</text>
            <view wx:if="{{item.confirmItems.length}}" class="document-confirm-list">
              <text class="document-confirm-list__title">还可补充 {{item.confirmItems.length}} 项（均可跳过）</text>
              <view wx:for="{{item.confirmItems}}" wx:for-item="confirm" wx:key="index" class="document-confirm-item" bindtap="openConfirmEditor" data-id="{{item.id}}" data-index="{{index}}">
                <text class="document-confirm-item__check">需核实</text><text class="document-confirm-item__text">{{confirm.text}}</text><text class="document-confirm-item__edit">修订</text>
              </view>
            </view>
            <view class="document-card__actions">
              <text class="document-card__action-more" bindtap="openDocumentRevision" data-id="{{item.id}}">让 AI 修改</text>
              <text bindtap="editResult" data-id="{{item.id}}">编辑正文</text>
              <text class="document-card__action-primary" bindtap="useResult" data-id="{{item.id}}">核对并使用</text>
            </view>
          </view>
        </view>
        <view wx:elif="{{item.role === 'assistant' && item.status === 'error'}}" class="failed-message">
          <view class="ai-msg-avatar">智</view>
          <view class="failed-card"><text class="failed-card__title">生成未完成</text><text class="failed-card__desc">{{item.errorMessage}}</text><text class="failed-card__action" bindtap="restoreFailedRequest" data-id="{{item.id}}">恢复后重发</text></view>
        </view>
        <t-chat-message
          wx:else
          chatId="{{item.id}}"
          role="{{item.role}}"
          placement="{{item.role === 'user' ? 'right' : 'left'}}"
          variant="outline"
          content="{{item.chatContent}}"
          status="{{item.status || ''}}"
          animation="{{item.status === 'streaming' ? 'moving' : (item.status === 'pending' ? 'moving' : 'skeleton')}}"
        >
          <view slot="avatar" wx:if="{{item.role === 'assistant'}}" class="ai-msg-avatar">智</view>
          <view
            slot="actionbar"
            wx:if="{{item.role === 'assistant' && (item.bodyText || item.templateDraft)}}"
            class="msg-actionbar"
          >
            <text class="msg-ai-tag">{{item.isPartial ? '已停止，以下为已生成内容' : 'AI 生成'}}</text>
            <text wx:if="{{item.bodyText}}" class="msg-actionbar__btn" bindtap="copyResult" data-id="{{item.id}}">复制</text>
            <text
              wx:if="{{item.bodyText}}"
              class="msg-actionbar__btn"
              bindtap="useResult"
              data-id="{{item.id}}"
            >发送到电脑</text>
            <text
              wx:if="{{item.templateDraft}}"
              class="msg-actionbar__btn"
              bindtap="saveTemplateDraft"
              data-id="{{item.id}}"
            >保存为模板</text>
          </view>
        </t-chat-message>
      </block>

      <view wx:if="{{templateConfirmVisible}}" class="inline-confirm-row">
        <view class="ai-msg-avatar">智</view>
        <view class="inline-confirm-card">
          <text class="inline-confirm-card__title">材料无误后生成草稿</text>
          <text class="inline-confirm-card__hint">整理为：{{selectedTemplateName}}</text>
          <view class="inline-confirm-card__settings">
            <view><text class="inline-confirm-card__setting-label">详细程度</text><text class="inline-confirm-card__setting-value">{{detailLevelLabel}}</text></view>
            <view><text class="inline-confirm-card__setting-label">预计结构</text><text class="inline-confirm-card__setting-value">{{templateStructureText}}</text></view>
          </view>
          <view class="inline-confirm-card__sources"><t-icon name="check-circle" size="25rpx" color="#168761" /><text>{{templateConfirmSources}}</text></view>
          <scroll-view wx:if="{{templateConfirmImages.length}}" scroll-x class="inline-confirm-card__images" enhanced="{{true}}" show-scrollbar="{{false}}"><view class="inline-confirm-card__images-row"><image wx:for="{{templateConfirmImages}}" wx:key="id" class="inline-confirm-card__image" src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="previewPendingImage" /></view></scroll-view>
          <scroll-view scroll-y class="inline-confirm-card__preview"><text selectable>{{templateConfirmPreview}}</text></scroll-view>
          <text class="inline-confirm-card__notice">AI 只整理你提供的内容，不会猜测空缺信息。</text>
          <view class="inline-confirm-card__actions"><button class="inline-confirm-card__back" bindtap="closeTemplateConfirm">返回修改</button><button class="inline-confirm-card__submit" bindtap="confirmTemplateSubmission">材料无误，生成草稿</button></view>
        </view>
      </view>

      <view wx:if="{{sending && sendingStageLabel}}" class="sending-status">
        <text class="sending-status__text">{{sendingStageLabel}}</text>
      </view>

      <view wx:if="{{messages.length > 0}}" class="session-footer">
        <text class="new-session" bindtap="resetSession">新建对话</text>
      </view>

      <view class="disclaimer">
        <text class="disclaimer-text">AI 生成内容仅供参考，请核实后使用。</text>
      </view>
    </t-chat-list>
  </view>

  <view class="detail-composer {{pendingPreviewItems.length ? 'detail-composer--with-thumbs' : ''}}" style="{{composerBottomStyle}}">
    <view wx:if="{{selectedTemplateName}}" class="document-workbench">
      <view class="document-workbench__head">
        <view class="document-workbench__title-wrap">
          <view class="document-workbench__icon"><t-icon name="template" size="28rpx" color="#6F3DFF" /></view>
          <view><text class="document-workbench__eyebrow">整理为</text><text class="document-workbench__title">{{selectedTemplateName}}</text></view>
        </view>
        <text class="document-workbench__change" catchtap="openTemplatePicker">更换</text>
      </view>
      <text class="document-workbench__guide">文字、照片和录音会一起按模板整理</text>
      <view class="document-workbench__summary">
        <view class="document-workbench__materials {{materialReady ? 'is-ready' : ''}}"><t-icon name="{{materialReady ? 'check-circle' : 'info-circle'}}" size="26rpx" color="{{materialReady ? '#168761' : '#64739A'}}" /><text>{{materialSummaryText}}</text></view>
        <view class="document-workbench__settings-link" catchtap="toggleTemplateFieldsPanel"><text>{{detailLevelLabel}} · 设置</text><t-icon name="chevron-{{templateFieldsPanelVisible ? 'up' : 'down'}}" size="24rpx" color="#6F3DFF" /></view>
      </view>
      <view wx:if="{{templateFieldsPanelVisible}}" class="document-workbench__settings">
        <view class="document-workbench__setting-row">
          <text class="document-workbench__setting-label">详细程度</text>
          <view class="document-workbench__segments">
            <view wx:for="{{detailLevelOptions}}" wx:key="value" class="document-workbench__segment {{detailLevel === item.value ? 'is-active' : ''}}" data-value="{{item.value}}" catchtap="selectDetailLevel">{{item.label}}</view>
          </view>
        </view>
        <view class="document-workbench__structure"><text>生成结构</text><text>{{templateStructureText}}</text></view>
        <view class="document-workbench__field-toggle" catchtap="toggleTemplateFieldChoices"><view><text class="document-workbench__field-toggle-title">补充字段{{templateFieldFilledCount ? (' · 已填 ' + templateFieldFilledCount + ' 项') : ''}}</text><text class="document-workbench__field-toggle-note">点击字段后填写，可随时跳过</text></view><t-icon name="chevron-{{templateFieldChoicesVisible ? 'up' : 'down'}}" size="26rpx" color="#64739A" /></view>
        <view wx:if="{{templateFieldChoicesVisible}}" class="document-workbench__fields">
          <view wx:for="{{visibleTemplateGuideFields}}" wx:key="label" class="template-field {{item.required ? 'template-field--priority' : ''}} {{item.filled ? 'template-field--filled' : ''}}" data-label="{{item.label}}" bindtap="openTemplateFieldEditor">
            <text class="template-field__label">{{item.label}}</text><text class="template-field__add">{{item.filled ? '✓' : '＋'}}</text>
          </view>
          <view class="document-workbench__field-actions">
            <text wx:if="{{templateGuideFields.length > 8}}" bindtap="toggleTemplateGuide">{{templateGuideExpanded ? '收起' : ('查看更多 ' + templateGuideHiddenCount + ' 项')}}</text>
          </view>
          <text class="document-workbench__field-note">带 ✓ 的字段会和文字、照片、录音一起用于生成。</text>
        </view>
      </view>
    </view>

    <form class="composer-box" bindsubmit="sendMessage">
      <scroll-view
        wx:if="{{pendingPreviewItems.length}}"
        class="composer-thumbs"
        scroll-x
        enhanced="{{true}}"
        show-scrollbar="{{false}}"
      >
        <view class="composer-thumbs__row">
          <view
            wx:for="{{pendingPreviewItems}}"
            wx:key="id"
            class="composer-thumb"
          >
            <image
              class="composer-thumb__image"
              src="{{item.url}}"
              mode="aspectFill"
              catchtap="previewPendingImage"
              data-url="{{item.url}}"
            />
            <view wx:if="{{item.ocrStatus === 'recognizing'}}" class="composer-thumb__mask">
              <t-loading theme="circular" size="36rpx" />
              <text class="composer-thumb__mask-text">识别中</text>
            </view>
            <view wx:if="{{item.ocrStatus === 'failed'}}" class="composer-thumb__mask composer-thumb__mask--failed" catchtap="retryPendingImage" data-id="{{item.id}}"><text class="composer-thumb__mask-text">处理失败</text><text class="composer-thumb__mask-text">点此重试</text></view>
            <view
              class="composer-thumb__remove"
              wx:if="{{item.ocrStatus !== 'recognizing'}}"
              catchtap="onRemovePendingImage"
              data-id="{{item.id}}"
            >
              <t-icon name="close" size="24rpx" color="#ffffff" />
            </view>
          </view>
          <view
            wx:if="{{pendingPreviewItems.length < maxPendingImages}}"
            class="composer-thumb composer-thumb--add"
            catchtap="goImage"
          >
            <t-icon name="add" size="40rpx" color="rgba(0,0,0,0.45)" />
          </view>
        </view>
      </scroll-view>

      <textarea
        class="composer-textarea {{pendingPreviewItems.length ? 'composer-textarea--with-thumbs' : ''}}"
        placeholder="输入、粘贴或补充要整理的原始内容"
        placeholder-class="composer-placeholder"
        value="{{inputText}}"
        bindinput="onInput"
        bindconfirm="sendMessage"
        confirm-type="send"
        confirm-hold="false"
        maxlength="5000"
        show-confirm-bar="{{true}}"
        adjust-position="{{false}}"
        cursor-spacing="16"
        hold-keyboard="{{false}}"
      />
      <view class="composer-toolbar">
        <view class="composer-toolbar__left">
          <view class="composer-tool" catchtap="goVoice">
            <view class="composer-tool__icon"><t-icon t-class="composer-tool__glyph" name="microphone" size="38rpx" color="#47516A" /></view>
            <text class="composer-tool__label">录音</text>
          </view>
          <view class="composer-tool" catchtap="goImage">
            <view class="composer-tool__icon"><t-icon t-class="composer-tool__glyph" name="camera" size="38rpx" color="#47516A" /></view>
            <text class="composer-tool__label">拍照识别</text>
          </view>
          <view
            class="composer-tool {{selectedTemplateId ? 'composer-tool--active' : ''}}"
            catchtap="openTemplatePicker"
          >
            <view class="composer-tool__icon"><t-icon t-class="composer-tool__glyph"
              name="template"
              size="38rpx"
              color="{{selectedTemplateId ? '#6F3DFF' : 'rgba(0,0,0,0.55)'}}"
            /></view>
            <text class="composer-tool__label">模板</text>
          </view>
        </view>
        <button wx:if="{{sending}}" class="composer-stop {{selectedTemplateId ? 'composer-stop--wide' : ''}}" bindtap="stopGeneration"><t-icon name="pause" size="28rpx" color="#FFFFFF" /><text wx:if="{{selectedTemplateId}}">停止</text></button>
        <button
          wx:else
          class="composer-send {{selectedTemplateId ? 'composer-send--document' : ''}} {{canSend ? 'composer-send--active' : ''}}"
          form-type="submit"
          disabled="{{!canSend || sending}}"
        >
          <t-icon name="send-filled" size="28rpx" color="{{canSend ? '#FFFFFF' : 'rgba(0,0,0,0.28)'}}" />
          <text wx:if="{{selectedTemplateId}}">预览并生成</text>
        </button>
      </view>
    </form>
  </view>

  <view wx:if="{{templatePickerVisible}}" class="template-picker-mask" catchtap="closeTemplatePicker">
    <view class="template-picker" catchtap="noop">
      <view class="template-picker__head"><text class="template-picker__title">选择文书模板</text><text class="template-picker__close" bindtap="closeTemplatePicker">关闭</text></view>
      <input class="template-picker__search" placeholder="搜索模板名称或类型" value="{{templateSearchKeyword}}" bindinput="onTemplateSearch" />
      <scroll-view scroll-y class="template-picker__list">
        <view wx:if="{{templatesLoading}}" class="template-picker__empty">正在同步可用模板…</view>
        <view wx:elif="{{!templatePickerItems.length}}" class="template-picker__empty">未找到匹配模板</view>
        <view wx:for="{{templatePickerItems}}" wx:key="id" class="template-picker__item" bindtap="selectTemplateFromPicker" data-id="{{item.id}}">
          <view><text class="template-picker__name">{{item.name}}</text><text class="template-picker__meta">{{item.category}}</text></view>
          <text wx:if="{{item.isRecent}}" class="template-picker__recent">最近使用</text>
        </view>
      </scroll-view>
      <view class="template-picker__footer"><text bindtap="clearTemplateSelection">不使用模板</text><text bindtap="goTemplateImport">新建模板</text></view>
    </view>
  </view>

  <view wx:if="{{confirmEditorVisible}}" class="confirm-editor-mask" style="{{composerBottomStyle}}" catchtap="closeConfirmEditor">
    <view class="confirm-editor" catchtap="noop">
      <text class="confirm-editor__title">{{confirmEditorTitle}}</text>
      <text class="confirm-editor__hint">{{confirmEditorHint}}</text>
      <textarea class="confirm-editor__textarea {{confirmEditorMode === 'direct' ? 'confirm-editor__textarea--document' : ''}}" value="{{confirmEditorText}}" placeholder="例如：补充时间或结果；删除不准确表述" maxlength="10000" auto-focus="{{true}}" adjust-position="{{false}}" cursor-spacing="16" bindinput="onConfirmEditorInput" />
      <view class="confirm-editor__actions"><text bindtap="closeConfirmEditor">取消</text><text class="confirm-editor__submit" bindtap="applyDocumentChange">{{confirmEditorMode === 'direct' ? '保存正文' : '确认并更新'}}</text></view>
    </view>
  </view>

  <view wx:if="{{templateFieldEditorVisible}}" class="field-editor-mask" catchtap="closeTemplateFieldEditor">
    <view class="field-editor" catchtap="noop">
      <text class="field-editor__eyebrow">填写模板字段</text>
      <text class="field-editor__title">{{templateFieldEditorLabel}}</text>
      <textarea class="field-editor__textarea" value="{{templateFieldEditorValue}}" placeholder="输入已确认的内容，留空表示不提供" maxlength="3000" auto-focus="{{true}}" adjust-position="{{true}}" cursor-spacing="24" bindinput="onTemplateFieldEditorInput" />
      <view class="field-editor__actions"><button class="field-editor__cancel" bindtap="closeTemplateFieldEditor">取消</button><button class="field-editor__save" bindtap="saveTemplateFieldValue">保存字段</button></view>
    </view>
  </view>
</view>
