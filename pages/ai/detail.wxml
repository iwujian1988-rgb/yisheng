<view class="detail-page">
  <view class="detail-chat-wrap {{pendingPreviewItems.length ? 'detail-chat-wrap--tall-composer' : ''}}">
    <t-chat-list
      id="chatList"
      class="detail-chat-list"
      reverse="{{false}}"
      layout="both"
    >
      <view wx:if="{{messages.length === 0 && !sending}}" class="welcome-message">
        <view class="bot-avatar">AI</view>
        <view class="welcome-bubble">
          <text class="welcome-title">描述你的需求，可附带图片或语音转写内容</text>
          <text class="welcome-desc">例如：识别这张报告并整理成病程记录。系统会自动识别、整理并直接给出结果。</text>
        </view>
      </view>

      <block wx:for="{{messages}}" wx:key="id">
        <t-chat-message
          chatId="{{item.id}}"
          role="{{item.role}}"
          placement="{{item.role === 'user' ? 'right' : 'left'}}"
          variant="outline"
          content="{{item.chatContent}}"
          status="{{item.status || ''}}"
          animation="{{item.status === 'streaming' ? 'moving' : (item.status === 'pending' ? 'moving' : 'skeleton')}}"
        >
          <view slot="avatar" wx:if="{{item.role === 'assistant'}}" class="ai-msg-avatar">AI</view>
          <view
            slot="actionbar"
            wx:if="{{item.role === 'assistant' && (item.bodyText || item.templateDraft)}}"
            class="msg-actionbar"
          >
            <text class="msg-ai-tag">AI 生成</text>
            <text
              wx:if="{{item.bodyText}}"
              class="msg-actionbar__btn"
              bindtap="useResult"
              data-id="{{item.id}}"
            >使用这段</text>
            <text
              wx:if="{{item.templateDraft}}"
              class="msg-actionbar__btn"
              bindtap="saveTemplateDraft"
              data-id="{{item.id}}"
            >保存为模板</text>
          </view>
        </t-chat-message>
      </block>

      <view wx:if="{{sending && sendingStageLabel}}" class="sending-status">
        <text class="sending-status__text">{{sendingStageLabel}}</text>
      </view>

      <view wx:if="{{messages.length > 0}}" class="session-footer">
        <text class="new-session" bindtap="resetSession">新建对话</text>
      </view>

      <view class="disclaimer">
        <text class="disclaimer-text">AI 生成内容仅供参考，请核实后使用。</text>
      </view>
    </t-chat-list>
  </view>

  <view class="detail-composer {{pendingPreviewItems.length ? 'detail-composer--with-thumbs' : ''}}">
    <view wx:if="{{selectedTemplateName}}" class="composer-meta">
      <view class="composer-meta__main">
        <t-icon name="template" size="28rpx" color="#1677ff" />
        <text class="composer-meta__text">{{selectedTemplateName}}</text>
      </view>
      <text class="composer-meta__action" catchtap="clearTemplateSelection">清除</text>
    </view>

    <view class="composer-box">
      <scroll-view
        wx:if="{{pendingPreviewItems.length}}"
        class="composer-thumbs"
        scroll-x
        enhanced="{{true}}"
        show-scrollbar="{{false}}"
      >
        <view class="composer-thumbs__row">
          <view
            wx:for="{{pendingPreviewItems}}"
            wx:key="id"
            class="composer-thumb"
          >
            <image
              class="composer-thumb__image"
              src="{{item.url}}"
              mode="aspectFill"
              catchtap="previewPendingImage"
              data-url="{{item.url}}"
            />
            <view wx:if="{{item.ocrStatus === 'recognizing'}}" class="composer-thumb__mask">
              <t-loading theme="circular" size="36rpx" />
              <text class="composer-thumb__mask-text">识别中</text>
            </view>
            <view
              class="composer-thumb__remove"
              wx:if="{{item.ocrStatus !== 'recognizing'}}"
              catchtap="onRemovePendingImage"
              data-id="{{item.id}}"
            >
              <t-icon name="close" size="24rpx" color="#ffffff" />
            </view>
          </view>
          <view
            wx:if="{{pendingPreviewItems.length < maxPendingImages}}"
            class="composer-thumb composer-thumb--add"
            catchtap="goImage"
          >
            <t-icon name="add" size="40rpx" color="rgba(0,0,0,0.45)" />
          </view>
        </view>
      </scroll-view>

      <textarea
        class="composer-textarea {{pendingPreviewItems.length ? 'composer-textarea--with-thumbs' : ''}}"
        placeholder="描述需求，可粘贴原始内容；图片将作为附件上传"
        placeholder-class="composer-placeholder"
        value="{{inputText}}"
        disabled="{{sending}}"
        bindinput="onInput"
        maxlength="5000"
        show-confirm-bar="{{false}}"
        adjust-position="{{true}}"
        cursor-spacing="24"
        hold-keyboard="{{true}}"
      />
      <view class="composer-toolbar">
        <view class="composer-toolbar__left">
          <view class="composer-tool" catchtap="goVoice">
            <t-icon name="microphone" size="44rpx" color="rgba(0,0,0,0.55)" />
          </view>
          <view class="composer-tool" catchtap="goImage">
            <t-icon name="camera" size="44rpx" color="rgba(0,0,0,0.55)" />
          </view>
          <view
            class="composer-tool {{selectedTemplateId ? 'composer-tool--active' : ''}}"
            catchtap="openTemplatePicker"
          >
            <t-icon
              name="template"
              size="44rpx"
              color="{{selectedTemplateId ? '#1677ff' : 'rgba(0,0,0,0.55)'}}"
            />
          </view>
        </view>
        <view
          class="composer-send {{canSend ? 'composer-send--active' : ''}}"
          catchtap="sendMessage"
        >
          <t-loading wx:if="{{sending}}" theme="circular" size="36rpx" />
          <t-icon
            wx:else
            name="send-filled"
            size="32rpx"
            color="{{canSend ? '#ffffff' : 'rgba(0,0,0,0.35)'}}"
          />
        </view>
      </view>
    </view>
  </view>
</view>
