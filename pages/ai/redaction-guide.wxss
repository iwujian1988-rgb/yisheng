/* pages/ai/redaction-guide.wxss */
.redaction-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 32rpx 64rpx 96rpx;
}

/* 卡片 */
.card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #101936;
  display: block;
  margin-bottom: 20rpx;
}

.card-desc {
  font-size: 28rpx;
  color: #64739A;
  line-height: 1.8;
  display: block;
}

/* 字段列表 */
.field-list {
  margin-top: 8rpx;
}

.field-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(111, 61, 255, 0.08);
}

.field-item:last-child {
  border-bottom: none;
}

.field-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background-color: #6F3DFF;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.field-text {
  font-size: 30rpx;
  color: #101936;
}

/* 确认提示 */
.confirm-card {
  background-color: rgba(111, 61, 255, 0.06);
}

.confirm-text {
  font-size: 28rpx;
  color: #6F3DFF;
  line-height: 1.8;
}

/* 确认按钮 */
.confirm-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
  background-color: #6F3DFF;
  color: #FFFFFF;
  margin-top: 48rpx;
}

.confirm-btn:active {
  opacity: 0.8;
}
