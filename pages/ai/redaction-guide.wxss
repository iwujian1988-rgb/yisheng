/* pages/ai/redaction-guide.wxss */
.redaction-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px 48px;
}

/* 卡片 */
.card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 20px;
  margin-bottom: 12px;
}

.card-title {
  font-size: 16px;
  font-weight: 500;
  color: #333333;
  display: block;
  margin-bottom: 10px;
}

.card-desc {
  font-size: 14px;
  color: #666666;
  line-height: 1.8;
  display: block;
}

/* 字段列表 */
.field-list {
  margin-top: 4px;
}

.field-item {
  display: flex;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid #F0F0F0;
}

.field-item:last-child {
  border-bottom: none;
}

.field-dot {
  width: 6px;
  height: 6px;
  border-radius: 3px;
  background-color: #4A90E2;
  margin-right: 10px;
  flex-shrink: 0;
}

.field-text {
  font-size: 15px;
  color: #333333;
}

/* 确认提示 */
.confirm-card {
  background-color: rgba(74, 144, 226, 0.06);
}

.confirm-text {
  font-size: 14px;
  color: #4A90E2;
  line-height: 1.8;
}

/* 确认按钮 */
.confirm-btn {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
  background-color: #4A90E2;
  color: #FFFFFF;
  margin-top: 24px;
}

.confirm-btn:active {
  opacity: 0.8;
}
