<!--pages/ai/type-select.wxml-->
<view class="typeselect-container">
  <view class="card">
    <text class="card-title">选择 AI 功能类型</text>
    <radio-group bindchange="onTypeChange">
      <label class="type-item" wx:for="{{types}}" wx:key="value">
        <radio value="{{item.value}}" checked="{{selectedType === item.value}}" color="#4A90E2" />
        <view class="type-info">
          <text class="type-name">{{item.label}}</text>
          <text class="type-desc">{{item.desc}}</text>
        </view>
      </label>
    </radio-group>
  </view>

  <button
    class="btn btn-primary next-btn"
    disabled="{{!selectedType}}"
    bindtap="continueNext"
  >
    继续
  </button>
</view>
