/* pages/ai/review-result.wxss */
.review-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 32rpx 64rpx 96rpx;
  box-sizing: border-box;
}

.card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.card-title {
  display: block;
  margin-bottom: 24rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #101936;
}

.result-scroll {
  max-height: 640rpx;
}

.result-text {
  font-size: 30rpx;
  line-height: 1.8;
  color: #101936;
  word-break: break-all;
}

.confirm-card {
  background-color: rgba(111, 61, 255, 0.06);
}

.confirm-text {
  font-size: 28rpx;
  color: #6F3DFF;
  line-height: 1.6;
}

.action-section {
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.action-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-primary {
  background-color: #6F3DFF;
  color: #FFFFFF;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-outline {
  background-color: transparent;
  color: #6F3DFF;
  border: 2rpx solid #6F3DFF;
}
