.detail-page {
  min-height: 100vh;
  background-color: var(--td-bg-color-page, #f3f3f3);
}

.detail-chat-wrap {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: calc(300rpx + var(--app-tab-bar-height, 100rpx));
  overflow: hidden;
  z-index: 1;
}

.detail-chat-wrap.detail-chat-wrap--tall-composer {
  bottom: calc(380rpx + var(--app-tab-bar-height, 100rpx));
}

.detail-chat-list {
  height: 100%;
  width: 100%;
}

/* ---- 消息气泡 ---- */
.user-message-row {
  display: flex;
  justify-content: flex-end;
  width: 100%;
  padding: 10rpx 24rpx;
  box-sizing: border-box;
}

.user-message-bubble {
  width: auto;
  min-width: 0;
  max-width: 82%;
  padding: 18rpx 22rpx;
  box-sizing: border-box;
  overflow: visible;
  border-radius: 24rpx 6rpx 24rpx 24rpx;
  background: linear-gradient(145deg, #7445FF 0%, #6334E8 100%);
  box-shadow: 0 6rpx 16rpx rgba(75, 42, 185, 0.16);
}

.user-message-text {
  display: block;
  max-width: 100%;
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 1.62;
  white-space: pre-wrap;
  word-break: break-all;
  overflow-wrap: anywhere;
}

.user-message-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.user-message-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.12);
}

.detail-chat-list .t-chat-message.assistant.left .t-chat-message__detail {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  max-width: 80%;
}

.detail-chat-list .t-chat-message.assistant.left .t-chat-content {
  background-color: #ffffff !important;
  border: 1rpx solid #e7e7e7 !important;
  border-radius: 0 24rpx 24rpx 24rpx !important;
  padding: 20rpx 24rpx !important;
}

.ai-msg-avatar {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 50%;
  background-color: #6F3DFF;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  flex-shrink: 0;
}

.msg-actionbar {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-top: 8rpx;
}

.msg-ai-tag {
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.4);
}

.msg-actionbar__btn {
  font-size: 26rpx;
  color: var(--td-brand-color, #6F3DFF);
  font-weight: 500;
}

/* ---- 底部输入区 ---- */
.detail-composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: var(--app-tab-bar-height, 100rpx);
  z-index: 200;
  padding: 12rpx 24rpx 16rpx;
  background-color: var(--td-bg-color-page, #f3f3f3);
  box-sizing: border-box;
}

.composer-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
  font-size: 24rpx;
}

.composer-meta__main {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.composer-meta__text {
  color: var(--td-brand-color, #6F3DFF);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.composer-meta__action {
  flex-shrink: 0;
  color: var(--td-text-color-secondary, rgba(0, 0, 0, 0.6));
}

.composer-box {
  position: relative;
  background-color: #ffffff;
  border: 1rpx solid var(--td-border-level-1-color, #e7e7e7);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.composer-thumbs {
  width: 100%;
  white-space: nowrap;
  border-bottom: 1rpx solid rgba(111, 61, 255, 0.08);
}

.composer-thumbs__row {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 16rpx 12rpx;
}

.composer-thumb {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  overflow: visible;
}

.composer-thumb__image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background-color: #f3f3f3;
}

.composer-thumb__mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background-color: rgba(0, 0, 0, 0.45);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.composer-thumb__mask--failed {
  background-color: rgba(210, 74, 85, 0.78);
}

.composer-thumb__mask-text {
  font-size: 20rpx;
  color: #ffffff;
  line-height: 1.2;
}

.composer-thumb__remove {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
}

.composer-thumb--add {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border: 2rpx dashed #d9d9d9;
  box-sizing: border-box;
}

.composer-textarea {
  display: block;
  width: 100%;
  min-height: 88rpx;
  max-height: 240rpx;
  padding: 20rpx 20rpx 88rpx;
  font-size: 30rpx;
  line-height: 1.55;
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
  box-sizing: border-box;
  background-color: #ffffff;
}

.composer-textarea--with-thumbs {
  min-height: 72rpx;
  padding-top: 12rpx;
}

.composer-placeholder {
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
}

.composer-toolbar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 12rpx 12rpx;
  background-color: #ffffff;
  box-sizing: border-box;
}

.composer-toolbar__left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.composer-tool {
  width: 108rpx;
  height: 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.composer-tool__icon {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 44rpx;
  line-height: 0;
}

.composer-tool__label {
  display: block;
  width: 100%;
  font-size: 18rpx;
  line-height: 22rpx;
  color: #64739A;
  white-space: nowrap;
  text-align: center;
}

.composer-tool--active {
  background-color: rgba(111, 61, 255, 0.08);
}

.composer-tool--active .composer-tool__label {
  color: #6F3DFF;
  font-weight: 600;
}

.composer-send {
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #e8e8e8;
  flex-shrink: 0;
  line-height: 64rpx;
}

.composer-send::after {
  border: 0;
}

.composer-send--active {
  background-color: var(--td-brand-color, #6F3DFF);
}

.composer-stop {
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 20rpx;
  background-color: #D24A55;
  display: flex;
  align-items: center;
  justify-content: center;
}

.composer-stop::after { border: 0; }

.sending-status {
  display: flex;
  justify-content: center;
  padding: 8rpx 24rpx 0;
}

.sending-status__text {
  font-size: 24rpx;
  color: var(--td-text-color-secondary, rgba(0, 0, 0, 0.55));
}

/* ---- 欢迎语 ---- */
.welcome-message {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin: 12rpx 24rpx 24rpx;
}

.bot-avatar {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 20rpx;
  background-color: var(--td-brand-color, #6F3DFF);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  flex-shrink: 0;
}

.welcome-bubble {
  flex: 1;
  background-color: #ffffff;
  border-radius: var(--td-radius-large, 18rpx);
  border: 1rpx solid var(--td-brand-color-focus, #E4DAFF);
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: var(--td-shadow-1, 0 2rpx 20rpx rgba(0, 0, 0, 0.05));
}

.welcome-title {
  display: block;
  font-size: 30rpx;
  line-height: 1.5;
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
  font-weight: 700;
}

.welcome-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--td-text-color-secondary, rgba(0, 0, 0, 0.6));
}

.quick-prompts {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.quick-prompt {
  padding: 10rpx 14rpx;
  border-radius: 14rpx;
  background-color: #F2EDFF;
  color: #5C32D8;
  font-size: 23rpx;
}

.template-guide {
  margin: 16rpx 24rpx 20rpx;
  padding: 24rpx;
  border: 1rpx solid #DED3FF;
  border-radius: 22rpx;
  background: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(61, 42, 140, 0.06);
}

.template-guide__head,
.template-guide__title-wrap,
.template-guide__actions {
  display: flex;
  align-items: center;
}

.template-guide__head { justify-content: space-between; }
.template-guide__title-wrap { gap: 14rpx; min-width: 0; }
.template-guide__icon { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 16rpx; background: #F1ECFF; }
.template-guide__eyebrow, .template-guide__title { display: block; }
.template-guide__eyebrow { color: #7A849D; font-size: 20rpx; line-height: 1.3; }
.template-guide__title { margin-top: 2rpx; color: #17213D; font-size: 29rpx; line-height: 1.4; font-weight: 700; }
.template-guide__change { flex-shrink: 0; padding: 10rpx; color: #6F3DFF; font-size: 24rpx; }
.template-guide__desc { display: block; margin-top: 16rpx; color: #59657F; font-size: 25rpx; line-height: 1.55; }
.template-guide__fields { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }
.template-field { display: flex; align-items: center; gap: 4rpx; padding: 10rpx 13rpx; border-radius: 12rpx; border: 1rpx solid #E4E7EF; background: #F7F8FB; color: #46516B; font-size: 23rpx; }
.template-field--priority { border-color: #D9CCFF; background: #F3EFFF; color: #5A32CD; }
.template-field__label { max-width: 230rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.template-field__add { color: #6F3DFF; font-weight: 700; }
.template-guide__legend { display: block; margin-top: 10rpx; color: #8A93A8; font-size: 21rpx; line-height: 1.4; }
.template-guide__actions { gap: 28rpx; margin-top: 20rpx; font-size: 25rpx; }
.template-guide__primary { color: #6F3DFF; font-weight: 700; }
.template-guide__secondary { color: #66718A; }

.document-message,
.failed-message {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin: 16rpx 24rpx;
}

.document-card,
.failed-card {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  background-color: #FFFFFF;
  border: 1rpx solid #E4DAFF;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(61, 42, 140, 0.06);
}

.document-card { padding: 24rpx; }

.document-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0EBFF;
}

.document-card__title { display: block; font-size: 30rpx; font-weight: 700; color: #101936; }
.document-card__sub { display: block; margin-top: 4rpx; font-size: 22rpx; color: #64739A; }
.document-card__copy { padding: 6rpx 10rpx; font-size: 24rpx; color: #6F3DFF; }

.document-card__body {
  display: block;
  padding: 20rpx 0;
  color: #1D2948;
  font-size: 28rpx;
  line-height: 1.75;
  white-space: pre-wrap;
  word-break: break-all;
}

.document-card__actions {
  display: flex;
  justify-content: flex-end;
  gap: 28rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0EBFF;
  color: #6F3DFF;
  font-size: 26rpx;
  font-weight: 600;
}

.document-confirm-list { margin: 0 0 18rpx; padding: 18rpx; background-color: #FFF9EC; border-radius: 14rpx; }
.document-confirm-list__title { display: block; margin-bottom: 10rpx; font-size: 24rpx; color: #8A5A00; font-weight: 600; }
.document-confirm-item { display: flex; align-items: flex-start; gap: 10rpx; padding: 12rpx 0; font-size: 24rpx; color: #624F30; line-height: 1.45; border-bottom: 1rpx solid rgba(179, 123, 0, 0.12); }
.document-confirm-item:last-child { border-bottom: 0; }
.document-confirm-item__check { flex-shrink: 0; padding: 2rpx 8rpx; border-radius: 8rpx; background: #F7E2AF; color: #8A5A00; font-size: 20rpx; line-height: 1.3; }
.document-confirm-item__text { flex: 1; }
.document-confirm-item__edit { flex-shrink: 0; color: #6F3DFF; font-weight: 600; }

.failed-card { padding: 22rpx 24rpx; border-color: #F3C8CC; background-color: #FFF9F9; }
.failed-card__title, .failed-card__desc, .failed-card__action { display: block; }
.failed-card__title { font-size: 28rpx; font-weight: 700; color: #9C2F39; }
.failed-card__desc { margin-top: 6rpx; font-size: 24rpx; color: #7E5960; line-height: 1.5; }
.failed-card__action { margin-top: 14rpx; font-size: 26rpx; color: #B43B45; font-weight: 600; }

.template-picker-mask { position: fixed; inset: 0; z-index: 500; display: flex; align-items: flex-end; background-color: rgba(13, 20, 45, 0.42); }
.template-picker { width: 100%; max-height: 78vh; padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); background-color: #FCFBFF; border-radius: 28rpx 28rpx 0 0; box-sizing: border-box; }
.template-picker__head, .template-picker__footer, .template-picker__item { display: flex; align-items: center; justify-content: space-between; }
.template-picker__title { font-size: 34rpx; color: #101936; font-weight: 700; }.template-picker__close { font-size: 26rpx; color: #64739A; }
.template-picker__search { height: 72rpx; margin: 22rpx 0 16rpx; padding: 0 20rpx; border-radius: 16rpx; background-color: #F1EEFA; font-size: 27rpx; box-sizing: border-box; }
.template-picker__list { max-height: 760rpx; }.template-picker__item { min-height: 100rpx; padding: 16rpx 4rpx; border-bottom: 1rpx solid #ECE8F7; }
.template-picker__name, .template-picker__meta { display: block; }.template-picker__name { font-size: 29rpx; color: #1D2948; font-weight: 600; }.template-picker__meta { margin-top: 5rpx; font-size: 23rpx; color: #64739A; }
.template-picker__recent { padding: 5rpx 10rpx; border-radius: 10rpx; font-size: 21rpx; color: #6F3DFF; background-color: #F0EBFF; }.template-picker__empty { padding: 80rpx 0; text-align: center; color: #98A1B8; font-size: 26rpx; }
.template-picker__footer { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #E9E4F4; color: #6F3DFF; font-size: 27rpx; font-weight: 600; }

.confirm-editor-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 600; display: flex; align-items: flex-end; background-color: rgba(13, 20, 45, 0.48); }
.confirm-editor { width: 100%; padding: 32rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 28rpx 28rpx 0 0; background: #FFFFFF; }
.confirm-editor__title, .confirm-editor__hint { display: block; }.confirm-editor__title { font-size: 34rpx; color: #101936; font-weight: 700; }.confirm-editor__hint { margin-top: 12rpx; font-size: 25rpx; line-height: 1.5; color: #64739A; }
.confirm-editor__textarea { width: 100%; height: 220rpx; margin-top: 22rpx; padding: 20rpx; box-sizing: border-box; border-radius: 16rpx; background: #F6F4FB; color: #1D2948; font-size: 28rpx; line-height: 1.55; }
.confirm-editor__actions { display: flex; justify-content: flex-end; align-items: center; gap: 34rpx; margin-top: 24rpx; font-size: 28rpx; color: #64739A; }.confirm-editor__submit { color: #6F3DFF; font-weight: 700; }

.template-confirm-mask { position: fixed; inset: 0; z-index: 650; display: flex; align-items: flex-end; background: rgba(13, 20, 45, 0.5); }
.template-confirm { width: 100%; padding: 14rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 30rpx 30rpx 0 0; background: #FFFFFF; }
.template-confirm__handle { width: 72rpx; height: 8rpx; margin: 0 auto 24rpx; border-radius: 8rpx; background: #D9DCE5; }
.template-confirm__title, .template-confirm__hint { display: block; }
.template-confirm__title { color: #101936; font-size: 34rpx; font-weight: 700; }
.template-confirm__hint { margin-top: 12rpx; color: #5E6981; font-size: 25rpx; line-height: 1.55; }
.template-confirm__preview { max-height: 300rpx; min-height: 96rpx; margin-top: 22rpx; padding: 20rpx; box-sizing: border-box; border-radius: 16rpx; background: #F6F4FB; color: #27324D; font-size: 27rpx; line-height: 1.65; white-space: pre-wrap; word-break: break-all; }
.template-confirm__notice { display: flex; align-items: center; gap: 8rpx; margin-top: 16rpx; padding: 14rpx 16rpx; border-radius: 12rpx; background: #FFF8E9; color: #795720; font-size: 23rpx; }
.template-confirm__actions { display: grid; grid-template-columns: 1fr 1.5fr; gap: 16rpx; margin-top: 24rpx; }
.template-confirm__back, .template-confirm__submit { height: 84rpx; margin: 0; padding: 0; border-radius: 16rpx; font-size: 28rpx; font-weight: 600; line-height: 84rpx; }
.template-confirm__back { background: #F0F1F5; color: #4D5870; }
.template-confirm__submit { background: #6F3DFF; color: #FFFFFF; }
.template-confirm__back::after, .template-confirm__submit::after { border: 0; }

.session-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
}

.new-session {
  font-size: 26rpx;
  color: var(--td-brand-color, #6F3DFF);
  font-weight: 500;
}

.disclaimer {
  padding: 8rpx 24rpx 16rpx;
  text-align: center;
}

.disclaimer-text {
  font-size: 22rpx;
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
}
