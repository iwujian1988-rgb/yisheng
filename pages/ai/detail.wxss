.detail-page {
  min-height: 100vh;
  background-color: var(--td-bg-color-page, #f3f3f3);
}

.detail-chat-wrap {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: calc(300rpx + var(--app-tab-bar-height, 100rpx));
  overflow: hidden;
  z-index: 1;
}

.detail-chat-wrap.detail-chat-wrap--tall-composer {
  bottom: calc(380rpx + var(--app-tab-bar-height, 100rpx));
}

.detail-chat-list {
  height: 100%;
  width: 100%;
}

/* ---- 消息气泡 ---- */
.detail-chat-list .t-chat-message.user.right .t-chat-message__detail {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  max-width: 72%;
  background-color: #1677ff;
  border-radius: 24rpx 0 24rpx 24rpx;
  padding: 12rpx 16rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.detail-chat-list .t-chat-message.user.right .t-chat-content {
  background: transparent !important;
  border: none !important;
  padding: 8rpx 0 0 !important;
  border-radius: 0 !important;
  max-width: 100%;
}

.detail-chat-list .t-chat-message.user.right .t-chat-content:first-child {
  padding-top: 0 !important;
}

.detail-chat-list .t-chat-message.user.right .t-chat-content__user,
.detail-chat-list .t-chat-message.user.right .t-chat-content__user ._pre {
  color: #ffffff !important;
}

.detail-chat-list .t-chat-message.user.right .t-attachments + .t-chat-content:not(:empty) {
  margin-top: 12rpx;
}

.detail-chat-list .t-chat-message.user.right .t-attachments--chatting.all_images .file-image .image {
  max-width: 360rpx;
  max-height: 360rpx;
  border-radius: 12rpx;
}

.detail-chat-list .t-chat-message.assistant.left .t-chat-message__detail {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  max-width: 80%;
}

.detail-chat-list .t-chat-message.assistant.left .t-chat-content {
  background-color: #ffffff !important;
  border: 1rpx solid #e7e7e7 !important;
  border-radius: 0 24rpx 24rpx 24rpx !important;
  padding: 20rpx 24rpx !important;
}

.ai-msg-avatar {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 50%;
  background-color: #1677ff;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  flex-shrink: 0;
}

.msg-actionbar {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-top: 8rpx;
}

.msg-ai-tag {
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.4);
}

.msg-actionbar__btn {
  font-size: 26rpx;
  color: var(--td-brand-color, #1677ff);
  font-weight: 500;
}

/* ---- 底部输入区 ---- */
.detail-composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: var(--app-tab-bar-height, 100rpx);
  z-index: 200;
  padding: 12rpx 24rpx 16rpx;
  background-color: var(--td-bg-color-page, #f3f3f3);
  box-sizing: border-box;
}

.composer-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
  font-size: 24rpx;
}

.composer-meta__main {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.composer-meta__text {
  color: var(--td-brand-color, #1677ff);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.composer-meta__action {
  flex-shrink: 0;
  color: var(--td-text-color-secondary, rgba(0, 0, 0, 0.6));
}

.composer-box {
  position: relative;
  background-color: #ffffff;
  border: 1rpx solid var(--td-border-level-1-color, #e7e7e7);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.composer-thumbs {
  width: 100%;
  white-space: nowrap;
  border-bottom: 1rpx solid #f0f0f0;
}

.composer-thumbs__row {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 16rpx 12rpx;
}

.composer-thumb {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  overflow: visible;
}

.composer-thumb__image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background-color: #f3f3f3;
}

.composer-thumb__mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background-color: rgba(0, 0, 0, 0.45);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.composer-thumb__mask-text {
  font-size: 20rpx;
  color: #ffffff;
  line-height: 1.2;
}

.composer-thumb__remove {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
}

.composer-thumb--add {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border: 2rpx dashed #d9d9d9;
  box-sizing: border-box;
}

.composer-textarea {
  display: block;
  width: 100%;
  min-height: 88rpx;
  max-height: 240rpx;
  padding: 20rpx 20rpx 88rpx;
  font-size: 30rpx;
  line-height: 1.55;
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
  box-sizing: border-box;
  background-color: #ffffff;
}

.composer-textarea--with-thumbs {
  min-height: 72rpx;
  padding-top: 12rpx;
}

.composer-placeholder {
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
}

.composer-toolbar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 12rpx 12rpx;
  background-color: #ffffff;
  box-sizing: border-box;
}

.composer-toolbar__left {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.composer-tool {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.composer-tool--active {
  background-color: rgba(22, 119, 255, 0.08);
  border-radius: 50%;
}

.composer-send {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #e8e8e8;
  flex-shrink: 0;
}

.composer-send--active {
  background-color: var(--td-brand-color, #1677ff);
}

.sending-status {
  display: flex;
  justify-content: center;
  padding: 8rpx 24rpx 0;
}

.sending-status__text {
  font-size: 24rpx;
  color: var(--td-text-color-secondary, rgba(0, 0, 0, 0.55));
}

/* ---- 欢迎语 ---- */
.welcome-message {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin: 12rpx 24rpx 24rpx;
}

.bot-avatar {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 12rpx;
  background-color: var(--td-brand-color, #1677ff);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  flex-shrink: 0;
}

.welcome-bubble {
  flex: 1;
  background-color: #ffffff;
  border-radius: var(--td-radius-large, 18rpx);
  border: 1rpx solid var(--td-brand-color-focus, #bae0ff);
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: var(--td-shadow-1, 0 1px 10px rgba(0, 0, 0, 0.05));
}

.welcome-title {
  display: block;
  font-size: 30rpx;
  line-height: 1.5;
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
  font-weight: 700;
}

.welcome-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--td-text-color-secondary, rgba(0, 0, 0, 0.6));
}

.session-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
}

.new-session {
  font-size: 26rpx;
  color: var(--td-brand-color, #1677ff);
  font-weight: 500;
}

.disclaimer {
  padding: 8rpx 24rpx 16rpx;
  text-align: center;
}

.disclaimer-text {
  font-size: 22rpx;
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
}
