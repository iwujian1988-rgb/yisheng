.detail-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #F5F7FA;
}

.message-list {
  flex: 1;
  padding: 28rpx 28rpx 440rpx;
  box-sizing: border-box;
}

.welcome-message {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 18rpx;
}

.bot-avatar {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 16rpx;
  background-color: #1677FF;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}

.welcome-bubble {
  flex: 1;
  background-color: #FFFFFF;
  border-radius: 18rpx;
  border-top-left-radius: 6rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.welcome-title {
  display: block;
  font-size: 30rpx;
  line-height: 1.5;
  color: #18233C;
  font-weight: 700;
}

.welcome-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: #6B7486;
}

.message {
  display: flex;
  margin-bottom: 22rpx;
}

.message-user {
  justify-content: flex-end;
}

.message-ai {
  justify-content: flex-start;
}

.message-bubble {
  max-width: 82%;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  box-sizing: border-box;
}

.message-user .message-bubble {
  background-color: #1677FF;
  border-top-right-radius: 6rpx;
}

.message-ai .message-bubble {
  background-color: #FFFFFF;
  border-top-left-radius: 6rpx;
}

.message-text {
  font-size: 30rpx;
  line-height: 1.7;
  word-break: break-all;
  white-space: pre-wrap;
}

.message-user .message-text {
  color: #FFFFFF;
}

.message-ai .message-text {
  color: #333333;
}

.message-actions {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #EEF1F5;
  display: flex;
  justify-content: flex-end;
}

.use-result {
  font-size: 26rpx;
  color: #1677FF;
  font-weight: 500;
}

.composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx 42rpx;
  background-color: #FFFFFF;
  border-top: 1rpx solid #EEF1F5;
  box-sizing: border-box;
}

.action-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.action-chip {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 26rpx;
  margin-right: 14rpx;
  border-radius: 32rpx;
  background-color: #F3F5F8;
  color: #26324D;
  font-size: 28rpx;
}

.action-chip.active {
  background-color: #1677FF;
  color: #FFFFFF;
}

.input-field {
  width: 100%;
  height: 220rpx;
  padding: 22rpx 24rpx;
  background-color: #F3F5F8;
  border-radius: 18rpx;
  font-size: 30rpx;
  line-height: 1.5;
  color: #333333;
  box-sizing: border-box;
}

.input-placeholder {
  color: #999999;
}

.composer-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
}

.tool-btn {
  width: 96rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  border-radius: 36rpx;
  font-size: 26rpx;
  background-color: #F3F5F8;
  color: #26324D;
  border: none;
}

.send-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 700;
  background-color: #D8DDE6;
  color: #FFFFFF;
  border: none;
}

.send-btn.active {
  background-color: #1677FF;
}

.tool-btn::after,
.send-btn::after {
  border: none;
}

.mode-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 12rpx;
}

.mode-label {
  font-size: 24rpx;
  color: #999;
}

.mode-clear {
  font-size: 24rpx;
  color: #1677FF;
}
