.detail-page {
  min-height: 100vh;
  background-color: var(--td-bg-color-page, #f3f3f3);
}

.detail-chat-wrap {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: calc(300rpx + var(--app-tab-bar-height, 100rpx));
  overflow: hidden;
  z-index: 1;
}

.detail-chat-list {
  height: 100%;
  width: 100%;
}

/* ---- 消息气泡 ---- */
.user-message-row {
  display: flex;
  justify-content: flex-end;
  width: 100%;
  padding: 10rpx 24rpx;
  box-sizing: border-box;
}

.user-message-bubble {
  width: auto;
  min-width: 0;
  max-width: 82%;
  padding: 18rpx 22rpx;
  box-sizing: border-box;
  overflow: visible;
  border-radius: 24rpx 6rpx 24rpx 24rpx;
  background: linear-gradient(145deg, #7445FF 0%, #6334E8 100%);
  box-shadow: 0 6rpx 16rpx rgba(75, 42, 185, 0.16);
}

.user-message-text {
  display: block;
  max-width: 100%;
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 1.62;
  white-space: pre-wrap;
  word-break: break-all;
  overflow-wrap: anywhere;
}

.user-message-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.user-message-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.12);
}

.assistant-message-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  width: 100%;
  padding: 10rpx 24rpx;
  box-sizing: border-box;
}

.assistant-message-content {
  min-width: 0;
  max-width: 82%;
}

.assistant-message-bubble {
  background-color: #ffffff !important;
  border: 1rpx solid #e7e7e7 !important;
  border-radius: 0 24rpx 24rpx 24rpx !important;
  padding: 20rpx 24rpx !important;
  box-sizing: border-box;
}

.assistant-message-text,
.assistant-thinking {
  display: block;
  color: #17213A;
  font-size: 28rpx;
  line-height: 1.62;
  white-space: pre-wrap;
  word-break: break-all;
  overflow-wrap: anywhere;
}

.assistant-thinking {
  margin-bottom: 10rpx;
  color: #7A849D;
  font-size: 24rpx;
}

.assistant-message-loading {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #7A849D;
  font-size: 25rpx;
}

.chat-bottom-anchor { height: 24rpx; }

.ai-msg-avatar {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 50%;
  background-color: #6F3DFF;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  flex-shrink: 0;
}

.msg-actionbar {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-top: 8rpx;
}

.msg-ai-tag {
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.4);
}

.msg-actionbar__btn {
  font-size: 26rpx;
  color: var(--td-brand-color, #6F3DFF);
  font-weight: 500;
}

/* ---- 底部输入区 ---- */
.detail-composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: var(--app-tab-bar-height, 100rpx);
  z-index: 200;
  padding: 12rpx 24rpx 16rpx;
  background-color: var(--td-bg-color-page, #f3f3f3);
  box-sizing: border-box;
}

.document-workbench { margin-bottom: 10rpx; padding: 14rpx 16rpx; border: 1rpx solid #DDD5F5; border-radius: 18rpx; background: #FFFFFF; box-sizing: border-box; }
.document-workbench__head, .document-workbench__title-wrap, .document-workbench__materials, .document-workbench__summary, .document-workbench__field-actions { display: flex; align-items: center; }
.document-workbench__head { min-height: 64rpx; justify-content: space-between; }
.document-workbench__title-wrap { flex: 1; gap: 12rpx; min-width: 0; }
.document-workbench__title-content { flex: 1; min-width: 0; }
.document-workbench__icon { width: 46rpx; height: 46rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 12rpx; background: #F2EDFF; }
.document-workbench__eyebrow, .document-workbench__title, .document-workbench__guide, .document-workbench__explain, .document-workbench__feedback { display: block; }
.document-workbench__eyebrow { color: #7A849D; font-size: 21rpx; line-height: 1.2; }
.document-workbench__title { color: #101936; font-size: 28rpx; line-height: 1.25; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.document-workbench__compact-status { display: -webkit-box; margin-top: 4rpx; color: #667089; font-size: 24rpx; line-height: 1.4; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.document-workbench__change { min-height: 52rpx; padding: 0 4rpx 0 16rpx; display: flex; align-items: center; flex-shrink: 0; color: #6F3DFF; font-size: 25rpx; font-weight: 600; }
.document-workbench__guide { margin-top: 10rpx; color: #59657F; font-size: 24rpx; line-height: 1.45; }
.document-workbench__summary { justify-content: space-between; gap: 14rpx; margin-top: 12rpx; }
.document-workbench__materials { min-width: 0; gap: 7rpx; padding: 9rpx 12rpx; border-radius: 11rpx; background: #F6F4FB; color: #59657F; font-size: 23rpx; line-height: 1.35; }
.document-workbench__materials.is-ready { background: rgba(24, 210, 139, 0.09); color: #236E55; }
.document-workbench__close { width: 56rpx; height: 56rpx; margin-left: 4rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; }
.document-workbench__optional { min-height: 68rpx; margin-top: 10rpx; padding: 10rpx 12rpx; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; border-radius: 12rpx; background: #F7F5FC; box-sizing: border-box; }
.document-workbench__optional-copy { min-width: 0; flex: 1; }
.document-workbench__optional-title, .document-workbench__optional-note { display: block; }
.document-workbench__optional-title { color: #5B35CE; font-size: 24rpx; line-height: 1.35; font-weight: 700; }
.document-workbench__optional-note { margin-top: 2rpx; overflow: hidden; color: #667089; font-size: 22rpx; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.document-workbench__material-entry { min-height: 66rpx; margin-top: 8rpx; padding: 8rpx 12rpx; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; border-radius: 12rpx; background: #F7F8FB; box-sizing: border-box; }
.workspace-material-list { max-height: 280rpx; margin-top: 8rpx; overflow-y: auto; border: 1rpx solid #ECE8F5; border-radius: 12rpx; background: #FFFFFF; }
.workspace-material { min-height: 82rpx; padding: 10rpx 12rpx; display: flex; align-items: center; gap: 12rpx; border-bottom: 1rpx solid #F1EEF7; box-sizing: border-box; }
.workspace-material:last-child { border-bottom: 0; }
.workspace-material.is-excluded { opacity: 0.62; }
.workspace-material.needs-review { background: #FFF9EA; }
.workspace-material__copy { min-width: 0; flex: 1; }
.workspace-material__title, .workspace-material__summary { display: block; }
.workspace-material__title { color: #27324D; font-size: 23rpx; line-height: 1.35; font-weight: 600; }
.workspace-material__summary { margin-top: 2rpx; overflow: hidden; color: #788198; font-size: 21rpx; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.workspace-material__action { min-width: 88rpx; height: 52rpx; padding: 0 14rpx; border-radius: 26rpx; background: #F1EDFF; color: #6335DF; font-size: 22rpx; line-height: 1; }
.document-workbench__settings { margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx solid #ECE8F5; }
.document-workbench__setting-row { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.document-workbench__setting-label { flex-shrink: 0; color: #27324D; font-size: 24rpx; font-weight: 600; }
.document-workbench__segments { display: flex; min-width: 0; padding: 3rpx; border-radius: 12rpx; background: #F2F0F7; }
.document-workbench__segment { min-width: 76rpx; height: 50rpx; padding: 0 12rpx; border-radius: 9rpx; color: #64739A; font-size: 23rpx; line-height: 50rpx; text-align: center; box-sizing: border-box; }
.document-workbench__segment.is-active { background: #FFFFFF; color: #5B2FD2; font-weight: 700; box-shadow: 0 2rpx 8rpx rgba(36, 25, 74, 0.12); }
.document-workbench__structure-entry { min-height: 76rpx; margin-top: 10rpx; padding-top: 10rpx; border-top: 1rpx solid #F1EEF7; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.document-workbench__row-action { min-height: 56rpx; display: flex; align-items: center; gap: 3rpx; flex-shrink: 0; color: #6F3DFF; font-size: 23rpx; font-weight: 600; }
.document-workbench__structure-detail { padding: 12rpx 14rpx; border-radius: 10rpx; background: #F7F5FC; color: #59657F; font-size: 22rpx; line-height: 1.55; }
.document-workbench__field-toggle-title, .document-workbench__field-toggle-note { display: block; }
.document-workbench__field-toggle-title { color: #27324D; font-size: 24rpx; font-weight: 600; }
.document-workbench__field-toggle-note { margin-top: 2rpx; color: #788198; font-size: 23rpx; }
.document-workbench__fields { max-height: 360rpx; margin-top: 8rpx; padding-top: 12rpx; overflow-y: auto; border-top: 1rpx solid #F1EEF7; display: flex; flex-direction: column; gap: 8rpx; }
.document-workbench__field-actions { width: 100%; justify-content: flex-end; margin-top: 8rpx; color: #6F3DFF; font-size: 24rpx; font-weight: 600; }
.document-workbench__field-note { width: 100%; color: #788198; font-size: 23rpx; line-height: 1.45; }

.composer-box {
  position: relative;
  background-color: #ffffff;
  border: 1rpx solid var(--td-border-level-1-color, #e7e7e7);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.composer-thumbs {
  width: 100%;
  white-space: nowrap;
  border-bottom: 1rpx solid rgba(111, 61, 255, 0.08);
}

.composer-thumbs__row {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 16rpx 12rpx;
}

.composer-thumb {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  overflow: visible;
}

.composer-thumb__image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background-color: #f3f3f3;
}

.composer-thumb__mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background-color: rgba(0, 0, 0, 0.45);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.composer-thumb__mask--failed {
  background-color: rgba(210, 74, 85, 0.78);
}

.composer-thumb__mask-text {
  font-size: 20rpx;
  color: #ffffff;
  line-height: 1.2;
}

.composer-thumb__remove {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
}

.composer-thumb--add {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border: 2rpx dashed #d9d9d9;
  box-sizing: border-box;
}

.composer-textarea {
  display: block;
  width: 100%;
  min-height: 88rpx;
  max-height: 240rpx;
  padding: 20rpx;
  font-size: 30rpx;
  line-height: 1.55;
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
  box-sizing: border-box;
  background-color: #ffffff;
}

.composer-textarea--with-thumbs {
  min-height: 72rpx;
  padding-top: 12rpx;
}

.composer-placeholder {
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
}

.composer-toolbar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 8rpx 12rpx 12rpx;
  border-top: 1rpx solid rgba(111, 61, 255, 0.08);
  background-color: #ffffff;
  box-sizing: border-box;
}

.voice-materials { width: 100%; border-bottom: 1rpx solid rgba(111, 61, 255, 0.08); white-space: nowrap; }
.voice-materials__row { display: inline-flex; align-items: stretch; gap: 12rpx; padding: 14rpx 16rpx; }
.voice-material { width: 300rpx; min-height: 76rpx; padding: 12rpx 12rpx 12rpx 14rpx; display: flex; align-items: center; gap: 10rpx; border: 1rpx solid #DDD5F5; border-radius: 16rpx; background: #F8F6FF; box-sizing: border-box; }
.voice-material__content { flex: 1; min-width: 0; }
.voice-material__title, .voice-material__preview { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.voice-material__title { color: #27324D; font-size: 23rpx; font-weight: 700; }
.voice-material__preview { margin-top: 3rpx; color: #6F7890; font-size: 23rpx; }
.voice-material__remove { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.voice-material--add { width: auto; min-width: 174rpx; justify-content: center; color: #6F3DFF; font-size: 23rpx; font-weight: 600; }

.composer-toolbar__left {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.composer-plus { width: 62rpx; height: 62rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 62rpx; border: 1rpx solid #D8DCE6; border-radius: 50%; background: #FFFFFF; box-sizing: border-box; }
.composer-plus.is-active { border-color: #6F3DFF; background: #6F3DFF; }
.composer-plus__hint { margin-left: 10rpx; color: #7A849D; font-size: 23rpx; white-space: nowrap; }

.composer-extension, .composer-template-panel { border-top: 1rpx solid #E8E5EF; background: #F7F7FA; }
.composer-extension { padding: 22rpx 20rpx calc(24rpx + env(safe-area-inset-bottom)); }
.composer-extension__group-title { display: block; color: #59657F; font-size: 25rpx; font-weight: 700; }
.composer-extension__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10rpx; margin-top: 16rpx; }
.composer-extension__grid--three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.composer-extension__item { min-width: 0; min-height: 118rpx; padding: 8rpx 2rpx; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 8rpx; color: #27324D; font-size: 23rpx; line-height: 1.25; font-weight: 600; text-align: center; box-sizing: border-box; }
.composer-extension__icon { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 1rpx solid #E2DFE9; border-radius: 16rpx; background: #FFFFFF; }
.composer-extension__icon--template { background: #F2EDFF; }
.composer-extension__relation { display: block; margin-top: 14rpx; color: #667089; font-size: 23rpx; line-height: 1.45; text-align: center; }

.composer-template-panel { max-height: 58vh; padding: 0 18rpx calc(18rpx + env(safe-area-inset-bottom)); overflow-y: auto; box-sizing: border-box; }
.composer-template-panel__head { min-height: 78rpx; display: grid; grid-template-columns: 1fr auto; align-items: center; border-bottom: 1rpx solid #E8E5EF; }
.composer-template-panel__title { overflow: hidden; color: #27324D; font-size: 29rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.composer-template-panel__done { min-height: 60rpx; color: #6F3DFF; font-size: 24rpx; font-weight: 700; line-height: 60rpx; text-align: right; }
.composer-template-panel .document-workbench__fields { max-height: 300rpx; }
.composer-template-panel__summary { margin: 14rpx 0 4rpx; padding: 14rpx 16rpx; border-radius: 12rpx; background: #F7F5FC; color: #59657F; font-size: 24rpx; line-height: 1.5; }
.composer-template-panel__summary text { display: block; }
.composer-template-panel__template { margin-bottom: 3rpx; color: #27324D; font-size: 26rpx; font-weight: 700; }
.composer-template-panel__settings { padding: 12rpx 0 4rpx; }
.composer-template-panel__footer { position: sticky; bottom: 0; z-index: 2; margin: 8rpx -2rpx 0; padding: 12rpx 2rpx 2rpx; border-top: 1rpx solid #E8E5EF; background: #FFFFFF; }
.composer-template-panel__footer > text { display: block; margin-bottom: 10rpx; color: #788198; font-size: 23rpx; line-height: 1.4; text-align: center; }
.composer-template-panel__primary { width: 100%; height: 76rpx; margin: 0; border-radius: 16rpx; background: #E7E3EF; color: #9A94A8; font-size: 27rpx; font-weight: 700; line-height: 76rpx; }
.composer-template-panel__primary.is-active { background: #6F3DFF; color: #FFFFFF; }
.composer-template-panel__primary::after { border: none; }

.composer-tool {
  width: 92rpx;
  min-width: 92rpx;
  flex: 0 0 92rpx;
  height: 76rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 0;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.composer-tool__icon {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 44rpx;
  line-height: 0;
}

.composer-tool__glyph {
  display: flex !important;
  width: 38rpx !important;
  height: 38rpx !important;
  flex: 0 0 38rpx;
  line-height: 1 !important;
  vertical-align: top !important;
}

.composer-tool__label {
  display: block;
  width: 100%;
  font-size: 22rpx;
  height: 24rpx;
  margin-top: 2rpx;
  line-height: 24rpx;
  color: #64739A;
  white-space: nowrap;
  text-align: center;
}

.composer-tool--active {
  background-color: rgba(111, 61, 255, 0.08);
}

.composer-tool--active .composer-tool__label {
  color: #6F3DFF;
  font-weight: 600;
}

.composer-send {
  width: 72rpx;
  min-width: 72rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #e8e8e8;
  flex-shrink: 0;
  line-height: 64rpx;
  justify-self: end;
  margin-left: auto;
  gap: 8rpx;
  padding: 0;
  color: rgba(0, 0, 0, 0.34);
  font-size: 25rpx;
  font-weight: 700;
}

.composer-send::after {
  border: 0;
}

.composer-send--active {
  background-color: var(--td-brand-color, #6F3DFF);
  color: #FFFFFF;
}

.composer-send--document { width: 176rpx; min-width: 176rpx; flex: 0 0 176rpx; border-radius: 999rpx; }

.composer-stop {
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 20rpx;
  background-color: #D24A55;
  display: flex;
  align-items: center;
  justify-content: center;
}

.composer-stop--wide { width: auto; padding: 0 20rpx; gap: 8rpx; color: #FFFFFF; font-size: 23rpx; }

.composer-stop::after { border: 0; }

.sending-status {
  display: flex;
  justify-content: center;
  padding: 8rpx 24rpx 0;
}

.sending-status__text {
  font-size: 24rpx;
  color: var(--td-text-color-secondary, rgba(0, 0, 0, 0.55));
}

/* ---- 欢迎语 ---- */
.welcome-message {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin: 12rpx 24rpx 24rpx;
}

.bot-avatar {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 20rpx;
  background-color: var(--td-brand-color, #6F3DFF);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  flex-shrink: 0;
}

.welcome-bubble {
  flex: 1;
  background-color: #ffffff;
  border-radius: var(--td-radius-large, 18rpx);
  border: 1rpx solid var(--td-brand-color-focus, #E4DAFF);
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: var(--td-shadow-1, 0 2rpx 20rpx rgba(0, 0, 0, 0.05));
}

.welcome-title {
  display: block;
  font-size: 30rpx;
  line-height: 1.5;
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
  font-weight: 700;
}

.welcome-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--td-text-color-secondary, rgba(0, 0, 0, 0.6));
}

.template-field { width: 100%; min-height: 78rpx; padding: 11rpx 13rpx 11rpx 16rpx; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; border-radius: 12rpx; border: 1rpx solid #E4E1EC; background: #FFFFFF; color: #46516B; box-sizing: border-box; }
.template-field--priority { border-color: #D9CCFF; background: #FAF8FF; }
.template-field--filled { border-color: #CFC2F8; background: #F7F3FF; }
.template-field__content { flex: 1; min-width: 0; }
.template-field__label, .template-field__value { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.template-field__label { color: #27324D; font-size: 25rpx; font-weight: 600; }
.template-field__value { margin-top: 3rpx; color: #788198; font-size: 23rpx; }
.template-field--filled .template-field__value { color: #5B35CE; }
.template-field__status { min-height: 52rpx; display: flex; align-items: center; gap: 2rpx; flex-shrink: 0; color: #6F3DFF; font-size: 22rpx; font-weight: 600; }

.document-message,
.failed-message {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin: 16rpx 24rpx;
}

.document-card,
.failed-card {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  background-color: #FFFFFF;
  border: 1rpx solid #E4DAFF;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(61, 42, 140, 0.06);
}

.document-card { padding: 24rpx; }

.document-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0EBFF;
}

.document-card__title { display: block; font-size: 30rpx; font-weight: 700; color: #101936; }
.document-card__sub { display: block; margin-top: 4rpx; font-size: 22rpx; color: #64739A; }
.document-card__copy { padding: 6rpx 10rpx; font-size: 24rpx; color: #6F3DFF; }

.document-card__body {
  display: block;
  padding: 20rpx 0;
  color: #1D2948;
  font-size: 28rpx;
  line-height: 1.75;
  white-space: pre-wrap;
  word-break: break-all;
}

.document-card__actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0EBFF;
  color: #6F3DFF;
  font-size: 26rpx;
  font-weight: 600;
}
.document-card__action-more { color: #64739A; font-weight: 500; }
.document-card__action-primary { padding: 12rpx 18rpx; border-radius: 999rpx; background: #6F3DFF; color: #FFFFFF; }

.document-confirm-list { margin: 0 0 18rpx; padding: 18rpx; background-color: #FFF9EC; border-radius: 14rpx; }
.document-confirm-list__title { display: block; margin-bottom: 10rpx; font-size: 24rpx; color: #8A5A00; font-weight: 600; }
.document-confirm-item { display: flex; align-items: flex-start; gap: 10rpx; padding: 12rpx 0; font-size: 24rpx; color: #624F30; line-height: 1.45; border-bottom: 1rpx solid rgba(179, 123, 0, 0.12); }
.document-confirm-item:last-child { border-bottom: 0; }
.document-confirm-item__check { flex-shrink: 0; padding: 2rpx 8rpx; border-radius: 8rpx; background: #F7E2AF; color: #8A5A00; font-size: 20rpx; line-height: 1.3; }
.document-confirm-item__text { flex: 1; }
.document-confirm-item__edit { flex-shrink: 0; color: #6F3DFF; font-weight: 600; }

.failed-card { padding: 22rpx 24rpx; border-color: #F3C8CC; background-color: #FFF9F9; }
.failed-card__title, .failed-card__desc, .failed-card__action { display: block; }
.failed-card__title { font-size: 28rpx; font-weight: 700; color: #9C2F39; }
.failed-card__desc { margin-top: 6rpx; font-size: 24rpx; color: #7E5960; line-height: 1.5; }
.failed-card__action { margin-top: 14rpx; font-size: 26rpx; color: #B43B45; font-weight: 600; }

.template-picker-mask { position: fixed; inset: 0; z-index: 12000; display: flex; align-items: flex-end; background-color: rgba(13, 20, 45, 0.42); }
.template-picker { width: 100%; max-height: 78vh; padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); background-color: #FCFBFF; border-radius: 28rpx 28rpx 0 0; box-sizing: border-box; }
.template-picker__head, .template-picker__footer, .template-picker__item { display: flex; align-items: center; justify-content: space-between; }
.template-picker__title { font-size: 34rpx; color: #101936; font-weight: 700; }.template-picker__close { font-size: 26rpx; color: #64739A; }
.template-picker__search { height: 72rpx; margin: 22rpx 0 16rpx; padding: 0 20rpx; border-radius: 16rpx; background-color: #F1EEFA; font-size: 27rpx; box-sizing: border-box; }
.template-picker__list { max-height: 760rpx; }.template-picker__item { min-height: 100rpx; padding: 16rpx 4rpx; border-bottom: 1rpx solid #ECE8F7; }
.template-picker__name, .template-picker__meta { display: block; }.template-picker__name { font-size: 29rpx; color: #1D2948; font-weight: 600; }.template-picker__meta { margin-top: 5rpx; font-size: 23rpx; color: #64739A; }
.template-picker__recent { padding: 5rpx 10rpx; border-radius: 10rpx; font-size: 21rpx; color: #6F3DFF; background-color: #F0EBFF; }.template-picker__empty { padding: 80rpx 0; text-align: center; color: #98A1B8; font-size: 26rpx; }
.template-picker__footer { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #E9E4F4; color: #6F3DFF; font-size: 27rpx; font-weight: 600; }

.confirm-editor-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 12000; display: flex; align-items: flex-end; background-color: rgba(13, 20, 45, 0.48); }
.confirm-editor { display: flex; width: 100%; max-height: 100%; flex-direction: column; overflow: hidden; padding: 32rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 28rpx 28rpx 0 0; background: #FFFFFF; }
.confirm-editor__title, .confirm-editor__hint { display: block; }.confirm-editor__title { font-size: 34rpx; color: #101936; font-weight: 700; }.confirm-editor__hint { margin-top: 12rpx; font-size: 25rpx; line-height: 1.5; color: #64739A; }
.confirm-editor__textarea { width: 100%; height: 220rpx; margin-top: 22rpx; padding: 20rpx; box-sizing: border-box; border-radius: 16rpx; background: #F6F4FB; color: #1D2948; font-size: 28rpx; line-height: 1.55; }
.confirm-editor__textarea--document { height: 56vh; min-height: 280rpx; flex: 1; }
.confirm-editor__actions { display: flex; flex-shrink: 0; justify-content: flex-end; align-items: center; gap: 34rpx; margin-top: 24rpx; font-size: 28rpx; color: #64739A; }.confirm-editor__submit { color: #6F3DFF; font-weight: 700; }

.field-editor-mask { position: fixed; inset: 0; z-index: 12000; display: flex; align-items: flex-end; background: rgba(13, 20, 45, 0.48); }
.field-editor { width: 100%; padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 28rpx 28rpx 0 0; background: #FFFFFF; }
.field-editor__eyebrow, .field-editor__title { display: block; }
.field-editor__eyebrow { color: #7A849D; font-size: 23rpx; }
.field-editor__title { margin-top: 5rpx; color: #101936; font-size: 34rpx; line-height: 1.35; font-weight: 700; }
.field-editor__textarea { width: 100%; height: 220rpx; margin-top: 20rpx; padding: 20rpx; box-sizing: border-box; border: 1rpx solid #E2DDF0; border-radius: 16rpx; background: #F8F7FB; color: #1D2948; font-size: 29rpx; line-height: 1.55; }
.field-editor__actions { display: flex; gap: 16rpx; margin-top: 22rpx; }
.field-editor__cancel, .field-editor__save { height: 76rpx; margin: 0; padding: 0 18rpx; border-radius: 15rpx; font-size: 27rpx; font-weight: 600; line-height: 76rpx; }
.field-editor__cancel { flex: 1; background: #F0F1F5; color: #4D5870; }
.field-editor__save { flex: 1.6; background: #6F3DFF; color: #FFFFFF; }
.field-editor__cancel::after, .field-editor__save::after { border: 0; }


.session-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
}

.new-session {
  font-size: 26rpx;
  color: var(--td-brand-color, #6F3DFF);
  font-weight: 500;
}

.disclaimer {
  padding: 8rpx 24rpx 16rpx;
  text-align: center;
}

.disclaimer-text {
  font-size: 22rpx;
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
}
.template-load-state {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  color: #64739A;
  font-size: 22rpx;
}

.template-load-state--error {
  color: #6F3DFF;
}
.composer-mode-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 14rpx 18rpx 4rpx;
  color: #64739a;
  font-size: 24rpx;
  line-height: 1.4;
}

.composer-mode-strip__switch {
  flex: none;
  color: #6f3dff;
  font-weight: 600;
}

/* V3 single-action composer: the input, plus and contextual action share one axis. */
.composer-input-row {
  display: flex;
  min-height: 84rpx;
  padding: 10rpx 12rpx;
  align-items: flex-end;
  gap: 10rpx;
  box-sizing: border-box;
  background: #FFFFFF;
}

.composer-input-row .composer-textarea {
  min-width: 0;
  min-height: 64rpx;
  max-height: 224rpx;
  flex: 1;
  padding: 11rpx 14rpx;
  border-radius: 12rpx;
  background: #F4F5F7;
  font-size: 28rpx;
  line-height: 42rpx;
}

.composer-input-row .composer-plus,
.composer-input-row .composer-send,
.composer-input-row .composer-stop {
  margin-bottom: 0;
  align-self: flex-end;
}

.composer-input-row .composer-plus {
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
}

.composer-input-row .composer-send {
  height: 64rpx;
  line-height: 1.2;
}

.composer-input-row .composer-send--document {
  width: 124rpx;
  min-width: 124rpx;
  flex-basis: 124rpx;
}
