/* pages/ai/detail.wxss */
.detail-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #F5F7FA;
}

.message-list {
  flex: 1;
  padding: 16px 32px;
  box-sizing: border-box;
}

.empty-hint {
  display: flex;
  justify-content: center;
  padding-top: 80px;
}

.empty-text {
  font-size: 14px;
  color: #999999;
}

.message {
  display: flex;
  margin-bottom: 16px;
}

.message-user {
  justify-content: flex-end;
}

.message-ai {
  justify-content: flex-start;
}

.message-bubble {
  max-width: 75%;
  padding: 12px 16px;
  border-radius: 12px;
  box-sizing: border-box;
}

.message-user .message-bubble {
  background-color: #4A90E2;
  border-top-right-radius: 4px;
}

.message-ai .message-bubble {
  background-color: #FFFFFF;
  border-top-left-radius: 4px;
}

.message-text {
  font-size: 15px;
  line-height: 1.6;
  word-break: break-all;
}

.message-user .message-text {
  color: #FFFFFF;
}

.message-ai .message-text {
  color: #333333;
}

.review-bar {
  padding: 8px 32px 12px;
  background-color: #FFFFFF;
  border-top: 1px solid #F0F0F0;
}

.review-btn {
  width: 100%;
  height: 44px;
  line-height: 44px;
  border-radius: 12px;
  font-size: 15px;
  color: #4A90E2;
  background-color: rgba(74, 144, 226, 0.08);
  border: 1px solid rgba(74, 144, 226, 0.18);
}

.input-bar {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 32px 40px;
  background-color: #FFFFFF;
  border-top: 1px solid #F0F0F0;
  box-sizing: border-box;
}

.input-field {
  flex: 1;
  height: 44px;
  padding: 0 14px;
  background-color: #F5F7FA;
  border-radius: 22px;
  font-size: 15px;
  color: #333333;
  box-sizing: border-box;
}

.input-placeholder {
  color: #999999;
}

.send-btn {
  width: 72px;
  height: 44px;
  line-height: 44px;
  padding: 0;
  border-radius: 22px;
  font-size: 15px;
  font-weight: 500;
  background-color: #4A90E2;
  color: #FFFFFF;
  border: none;
  flex-shrink: 0;
}

.send-btn-disabled {
  background-color: #CCCCCC;
  color: #FFFFFF;
}
