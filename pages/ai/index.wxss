/* pages/ai/index.wxss */
.ai-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  display: flex;
  flex-direction: column;
}

/* 空状态 */
.empty-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 120px;
}

.empty-icon {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background-color: #E8E8E8;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24px;
}

.empty-icon-text {
  font-size: 36px;
  color: #999999;
}

.empty-title {
  font-size: 16px;
  color: #666666;
  margin-bottom: 8px;
}

.empty-desc {
  font-size: 14px;
  color: #999999;
}

/* 对话列表 */
.list-section {
  flex: 1;
  padding: 16px 32px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.conversation-card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 16px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.conversation-title {
  font-size: 15px;
  color: #333333;
  flex: 1;
}

.conversation-time {
  font-size: 12px;
  color: #999999;
  flex-shrink: 0;
  margin-left: 12px;
}

/* 底部按钮 */
.bottom-bar {
  padding: 16px 32px 40px;
}

.new-chat-btn {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
  background-color: #4A90E2;
  color: #FFFFFF;
  border: none;
  line-height: 52px;
}

.new-chat-btn:active {
  opacity: 0.8;
}
