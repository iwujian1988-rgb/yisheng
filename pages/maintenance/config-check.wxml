<!--pages/maintenance/config-check.wxml-->
<view class="config-container">
  <view class="section-title"><text class="section-text">配置检查</text></view>
  <view class="check-list">
    <view class="check-card">
      <text class="check-name">蓝牙配置</text>
      <text class="check-status {{bleConfig==='ok'?'status-ok':'status-err'}}">{{bleConfig==='ok'?'正常':'异常'}}</text>
    </view>
    <view class="check-card">
      <text class="check-name">API 地址</text>
      <text class="check-status {{apiConfig==='ok'?'status-ok':'status-err'}}">{{apiConfig==='ok'?'正常':'异常'}}</text>
    </view>
    <view class="check-card">
      <text class="check-name">存储空间</text>
      <text class="check-status {{storageConfig==='ok'?'status-ok':'status-err'}}">{{storageConfig==='ok'?'正常':'异常'}}</text>
    </view>
    <view class="check-card">
      <text class="check-name">安全证书</text>
      <text class="check-status {{certConfig==='ok'?'status-ok':'status-err'}}">{{certConfig==='ok'?'正常':'异常'}}</text>
    </view>
  </view>
</view>
