/* pages/maintenance/logs.wxss */
.logs-container { min-height: 100vh; background-color: #FCFBFF; padding: 24rpx 32rpx; }
.filter-bar { display: flex; gap: 20rpx; margin-bottom: 32rpx; }
.filter-item { padding: 16rpx 32rpx; border-radius: 40rpx; background-color: #FFFFFF; }
.filter-active { background-color: #6F3DFF; }
.filter-active .filter-text { color: #FFFFFF; }
.filter-text { font-size: 28rpx; color: #64739A; }
.empty-section { display: flex; justify-content: center; padding-top: 240rpx; }
.empty-text { font-size: 28rpx; color: #98A1B8; }
.log-list { display: flex; flex-direction: column; gap: 20rpx; }
.log-card { background-color: #FFFFFF; border-radius: 20rpx; padding: 32rpx 40rpx; display: flex; flex-direction: column;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}
.log-header { display: flex; justify-content: space-between; align-items: center; }
.log-level { font-size: 24rpx; padding: 4rpx 16rpx; border-radius: 20rpx; }
.level-error { background-color: #FFEBEE; color: #C62828; }
.level-warn { background-color: #FFF8E1; color: #F57F17; }
.level-info { background-color: #F2EDFF; color: #6F3DFF; }
.log-time { font-size: 24rpx; color: #CCCCCC; }
.log-msg { font-size: 28rpx; color: #101936; margin-top: 16rpx; }
