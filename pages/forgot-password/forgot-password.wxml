<!--pages/forgot-password/forgot-password.wxml-->
<view class="forgot-container">
  <!-- 标题 -->
  <view class="header-section">
    <text class="page-title">找回密码</text>
    <text class="page-desc">通过手机验证码重置密码</text>
  </view>

  <!-- 步骤 1: 验证手机号 -->
  <view class="form-section" wx:if="{{step === 1}}">
    <!-- 手机号 -->
    <view class="input-group">
      <text class="input-label">手机号</text>
      <view class="input-wrapper">
        <input
          class="input"
          type="number"
          placeholder="请输入注册时使用的手机号"
          placeholder-class="input-placeholder"
          value="{{phone}}"
          bindinput="onPhoneInput"
          maxlength="11"
        />
        <text
          wx:if="{{phone.length > 0}}"
          class="clear-icon"
          bindtap="clearPhone"
        >×</text>
      </view>
      <text wx:if="{{phoneError}}" class="error-text">{{phoneError}}</text>
    </view>

    <!-- 验证码 -->
    <view class="input-group">
      <text class="input-label">验证码</text>
      <view class="input-wrapper code-wrapper">
        <input
          class="input code-input"
          type="number"
          placeholder="请输入验证码"
          placeholder-class="input-placeholder"
          value="{{code}}"
          bindinput="onCodeInput"
          maxlength="6"
        />
        <button
          class="code-btn {{canSendCode && !countingDown ? '' : 'disabled'}}"
          disabled="{{!canSendCode || countingDown}}"
          bindtap="sendCode"
        >
          {{countingDown ? countdown + 's' : '获取验证码'}}
        </button>
      </view>
      <text wx:if="{{codeError}}" class="error-text">{{codeError}}</text>
    </view>

    <button
      class="btn btn-primary action-btn {{canNext ? '' : 'disabled'}}"
      disabled="{{!canNext}}"
      bindtap="goToStep2"
    >
      下一步
    </button>
  </view>

  <!-- 步骤 2: 设置新密码 -->
  <view class="form-section" wx:if="{{step === 2}}">
    <!-- 新密码 -->
    <view class="input-group">
      <text class="input-label">新密码</text>
      <view class="input-wrapper password-wrapper">
        <input
          class="input password-input"
          type="{{showPassword ? 'text' : 'password'}}"
          placeholder="请设置6-20位新密码"
          placeholder-class="input-placeholder"
          value="{{password}}"
          bindinput="onPasswordInput"
          maxlength="20"
        />
        <image
          class="eye-icon"
          src="{{showPassword ? '/assets/icons/eye-open.png' : '/assets/icons/eye-close.png'}}"
          mode="aspectFit"
          bindtap="togglePassword"
        />
      </view>
    </view>

    <!-- 确认新密码 -->
    <view class="input-group">
      <text class="input-label">确认新密码</text>
      <view class="input-wrapper password-wrapper">
        <input
          class="input password-input"
          type="{{showConfirmPassword ? 'text' : 'password'}}"
          placeholder="请再次输入新密码"
          placeholder-class="input-placeholder"
          value="{{confirmPassword}}"
          bindinput="onConfirmPasswordInput"
          maxlength="20"
        />
        <image
          class="eye-icon"
          src="{{showConfirmPassword ? '/assets/icons/eye-open.png' : '/assets/icons/eye-close.png'}}"
          mode="aspectFit"
          bindtap="toggleConfirmPassword"
        />
      </view>
      <text wx:if="{{confirmError}}" class="error-text">{{confirmError}}</text>
    </view>

    <button
      class="btn btn-primary action-btn {{canReset ? '' : 'disabled'}}"
      disabled="{{!canReset || isLoading}}"
      bindtap="onResetPassword"
      loading="{{isLoading}}"
    >
      {{isLoading ? '提交中...' : '重置密码'}}
    </button>
  </view>

  <!-- 步骤 3: 成功 -->
  <view class="success-section" wx:if="{{step === 3}}">
    <text class="success-icon">✓</text>
    <text class="success-title">密码重置成功</text>
    <text class="success-desc">请使用新密码登录</text>
    <button class="btn btn-primary action-btn" bindtap="goToLogin">
      返回登录
    </button>
  </view>

  <!-- 返回登录 -->
  <view class="back-section" wx:if="{{step < 3}}">
    <text class="back-text" bindtap="goToLogin">返回登录</text>
  </view>
</view>
