/* pages/error/index.wxss */
.error-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.error-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 100px;
  margin-bottom: 48px;
}

.error-icon-circle {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background-color: #FAAD14;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24px;
}

.error-icon-text {
  font-size: 40px;
  color: #FFFFFF;
}

.error-title {
  font-size: 20px;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8px;
}

.error-message {
  font-size: 14px;
  color: #666666;
  text-align: center;
  line-height: 1.6;
  padding: 0 32px;
}

/* 操作按钮 */
.action-section {
  width: calc(100% - 64px);
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.action-btn {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
}

.btn-primary {
  background-color: #4A90E2;
  color: #FFFFFF;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-outline {
  background-color: transparent;
  color: #4A90E2;
  border: 1px solid #4A90E2;
}
