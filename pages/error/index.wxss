/* pages/error/index.wxss */
.error-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 32rpx 48rpx;
  box-sizing: border-box;
}

.error-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  margin-bottom: 96rpx;
}

.error-icon-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #FAAD14;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}

.error-icon-text {
  font-size: 80rpx;
  color: #FFFFFF;
}

.error-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #101936;
  margin-bottom: 16rpx;
}

.error-message {
  font-size: 28rpx;
  color: #64739A;
  text-align: center;
  line-height: 1.6;
  padding: 0 32rpx;
}

/* 操作按钮 */
.action-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.action-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-primary {
  background-color: #6F3DFF;
  color: #FFFFFF;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-outline {
  background-color: transparent;
  color: #6F3DFF;
  border: 2rpx solid rgba(111, 61, 255, 0.24);
}
