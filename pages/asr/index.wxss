.asr-container {
  min-height: 100vh;
  background-color: #F6F8FB;
  padding: 28rpx;
  box-sizing: border-box;
}

.record-panel {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 34rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.panel-title {
  font-size: 38rpx;
  color: #18233C;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.panel-desc {
  font-size: 26rpx;
  color: #626D7F;
  line-height: 1.55;
  text-align: center;
  margin-bottom: 34rpx;
}

.record-btn {
  width: 184rpx;
  height: 184rpx;
  border-radius: 50%;
  background-color: #1677FF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 22rpx;
}

.record-btn.recording {
  background-color: #E5484D;
  animation: pulse 1.2s infinite;
}

.record-btn.disabled {
  opacity: 0.55;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.05); }
  100% { transform: scale(1); }
}

.record-icon {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.record-status {
  font-size: 29rpx;
  color: #18233C;
  font-weight: 700;
  text-align: center;
  margin-bottom: 8rpx;
}

.record-hint {
  font-size: 24rpx;
  color: #8A94A6;
  text-align: center;
}

.result-section {
  margin-bottom: 24rpx;
}

.result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.result-label {
  font-size: 30rpx;
  color: #18233C;
  font-weight: 700;
}

.result-meta {
  font-size: 24rpx;
  color: #7A8499;
}

.result-box {
  background-color: #FFFFFF;
  border-radius: 14rpx;
  padding: 24rpx;
  min-height: 360rpx;
  border: 2rpx solid #E6EBF2;
  box-sizing: border-box;
}

.result-textarea {
  width: 100%;
  min-height: 320rpx;
  font-size: 30rpx;
  line-height: 1.65;
  color: #18233C;
  box-sizing: border-box;
}

.result-empty {
  font-size: 30rpx;
  line-height: 1.7;
  color: #8B95A7;
  white-space: pre-wrap;
  word-break: break-all;
}

.action-section {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.primary-btn,
.secondary-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0;
}

.primary-btn {
  background-color: #1677FF;
  color: #FFFFFF;
}

.secondary-btn {
  background-color: #FFFFFF;
  color: #1677FF;
  border: 2rpx solid #D9E8FA;
}

.primary-btn[disabled],
.secondary-btn[disabled] {
  opacity: 0.45;
}

.primary-btn::after,
.secondary-btn::after {
  border: none;
}
