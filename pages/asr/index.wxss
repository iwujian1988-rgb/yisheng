.asr-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.record-panel {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 34rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-shadow: 0 6rpx 20rpx rgba(61, 42, 140, 0.05);
}

.panel-title {
  font-size: 38rpx;
  color: #101936;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.panel-desc {
  font-size: 26rpx;
  color: #64739A;
  line-height: 1.55;
  text-align: center;
  margin-bottom: 34rpx;
}

.record-btn {
  width: 184rpx;
  height: 184rpx;
  border-radius: 50%;
  background-color: #6F3DFF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 22rpx;
}

.record-btn.recording {
  background-color: #E5484D;
  animation: pulse 1.2s infinite;
}

.record-btn.disabled {
  opacity: 0.55;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.05); }
  100% { transform: scale(1); }
}

.record-icon {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.record-status {
  font-size: 29rpx;
  color: #101936;
  font-weight: 700;
  text-align: center;
  margin-bottom: 8rpx;
}

.record-hint {
  font-size: 24rpx;
  color: #64739A;
  text-align: center;
}

.result-section {
  margin-bottom: 24rpx;
}

.result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.result-label {
  font-size: 30rpx;
  color: #101936;
  font-weight: 700;
}

.result-meta {
  font-size: 24rpx;
  color: #64739A;
}

.result-box {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  min-height: 360rpx;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.result-textarea {
  width: 100%;
  min-height: 320rpx;
  font-size: 30rpx;
  line-height: 1.65;
  color: #101936;
  box-sizing: border-box;
}

.result-empty {
  font-size: 30rpx;
  line-height: 1.7;
  color: #64739A;
  white-space: pre-wrap;
  word-break: break-all;
}

.action-section {
  position: sticky;
  bottom: 0;
  z-index: 20;
  display: flex;
  gap: 18rpx;
  padding: 18rpx 0 calc(12rpx + env(safe-area-inset-bottom));
  background-color: #FCFBFF;
  box-sizing: border-box;
}

.action-section--standard .primary-btn,
.action-section--standard .secondary-btn {
  flex: 1;
  min-width: 0;
}

.action-section--ai .action-retry {
  width: 220rpx;
  flex: 0 0 220rpx;
}

.action-section--ai .action-confirm {
  flex: 1;
  min-width: 0;
}

.primary-btn,
.secondary-btn {
  height: 94rpx;
  min-height: 94rpx;
  margin: 0;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
  box-sizing: border-box;
}

.primary-btn {
  background-color: #6238E6;
  color: #FFFFFF;
  box-shadow: 0 8rpx 18rpx rgba(98, 56, 230, 0.20);
}

.secondary-btn {
  background-color: #FFFFFF;
  color: #45506B;
  border: 2rpx solid #D9D3E8;
  box-shadow: none;
}

.primary-btn[disabled],
.secondary-btn[disabled] {
  background-color: #ECEAF1;
  border-color: #ECEAF1;
  color: #9CA3B4;
  box-shadow: none;
  opacity: 1;
}

.primary-btn:not([disabled]):active,
.secondary-btn:not([disabled]):active {
  transform: scale(0.98);
}

.primary-btn::after,
.secondary-btn::after {
  border: none;
}

@media (prefers-reduced-motion: reduce) {
  .record-btn.recording {
    animation: none;
  }
}
