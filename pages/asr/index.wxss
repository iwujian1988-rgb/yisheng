/* pages/asr/index.wxss */
.asr-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.record-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 60px;
  margin-bottom: 40px;
}

.record-btn {
  width: 88px;
  height: 88px;
  border-radius: 50%;
  background-color: #4A90E2;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
}

.record-btn.recording {
  background-color: #F5222D;
  animation: pulse 1.2s infinite;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.08); }
  100% { transform: scale(1); }
}

.record-icon {
  font-size: 32px;
  color: #FFFFFF;
}

.record-status {
  font-size: 16px;
  color: #333333;
  font-weight: 500;
  margin-bottom: 4px;
}

.record-hint {
  font-size: 13px;
  color: #999999;
}

.result-section {
  width: calc(100% - 64px);
  margin-bottom: 20px;
}

.result-label {
  display: block;
  margin-bottom: 8px;
  font-size: 14px;
  color: #333333;
  font-weight: 500;
}

.result-box {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 16px;
  min-height: 80px;
  border: 1px solid #E5E5E5;
  box-sizing: border-box;
}

.result-text {
  font-size: 14px;
  color: #333333;
  line-height: 1.8;
  word-break: break-all;
}

.result-empty {
  font-size: 14px;
  color: #999999;
  line-height: 1.8;
}

.action-section {
  width: calc(100% - 64px);
}

.action-btn {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
}

.btn-primary {
  background-color: #4A90E2;
  color: #FFFFFF;
}

.btn-primary:active {
  opacity: 0.8;
}
