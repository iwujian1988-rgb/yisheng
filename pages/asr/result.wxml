<view class="asr-result-container">
  <view class="audio-section">
    <view class="audio-card">
      <text class="audio-icon">音频</text>
      <text class="audio-status">{{audioStatus || '录音已完成'}}</text>
    </view>
  </view>

  <view class="result-section">
    <text class="result-label">生成文本</text>
    <view wx:if="{{resultMeta}}" class="meta-row">
      <text class="meta-item">{{resultMeta.provider || 'ASR'}}</text>
      <text class="meta-item">{{resultMeta.elapsedMs}}ms</text>
      <text class="meta-item">可信度 {{resultMeta.confidence}}</text>
      <text wx:if="{{resultMeta.durationMs}}" class="meta-item">音频 {{resultMeta.durationMs}}ms</text>
    </view>
    <view class="safety-note">
      <text>请核对生成内容，确认无误后再使用。</text>
    </view>
    <view class="result-box">
      <textarea
        wx:if="{{resultText}}"
        class="result-textarea"
        value="{{resultText}}"
        maxlength="-1"
        bindinput="updateResultText"
      />
      <text class="result-empty" wx:else>暂无生成文本</text>
    </view>
  </view>

  <view class="action-section">
    <button class="btn btn-primary action-btn" disabled="{{!resultText}}" bindtap="confirmResult">
      发送到电脑
    </button>
    <button class="btn btn-outline action-btn" disabled="{{!resultText}}" bindtap="copyResult">复制文本</button>
    <button class="btn btn-outline action-btn" bindtap="reRecord">
      重新录音
    </button>
  </view>
</view>
