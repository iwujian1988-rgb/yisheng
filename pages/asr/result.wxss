/* pages/asr/result.wxss */
.asr-result-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.audio-section {
  margin-bottom: 20px;
}

.audio-card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 20px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.audio-icon {
  font-size: 24px;
  color: #4A90E2;
}

.audio-status {
  font-size: 15px;
  color: #333333;
}

.result-section {
  flex: 1;
  margin-bottom: 24px;
}

.result-label {
  display: block;
  margin-bottom: 8px;
  font-size: 14px;
  color: #333333;
  font-weight: 500;
}

.result-box {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 16px;
  min-height: 120px;
  border: 1px solid #E5E5E5;
  box-sizing: border-box;
}

.result-text {
  font-size: 15px;
  color: #333333;
  line-height: 1.8;
  word-break: break-all;
}

.result-empty {
  font-size: 14px;
  color: #999999;
}

.action-section {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding-bottom: 40px;
}

.action-btn {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
}

.btn-primary {
  background-color: #4A90E2;
  color: #FFFFFF;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-outline {
  background-color: transparent;
  color: #4A90E2;
  border: 1px solid #4A90E2;
}
