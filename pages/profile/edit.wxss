/* pages/profile/edit.wxss */
.edit-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 24rpx 32rpx;
}

.form-section {
  margin-bottom: 64rpx;
}

.input-group {
  margin-bottom: 48rpx;
}

.input-label {
  font-size: 28rpx;
  color: #101936;
  font-weight: 500;
  margin-bottom: 16rpx;
  display: block;
}

.input {
  width: 100%;
  height: 104rpx;
  padding: 0 32rpx;
  background-color: #FFFFFF;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  border-radius: 24rpx;
  font-size: 30rpx;
  color: #101936;
  box-sizing: border-box;
}

.input:focus {
  border-color: #6F3DFF;
}

.input-placeholder {
  color: #98A1B8;
}

.readonly-field {
  width: 100%;
  height: 104rpx;
  padding: 0 32rpx;
  background-color: #FCFBFF;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.readonly-text {
  font-size: 30rpx;
  color: #98A1B8;
}

.save-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-primary {
  background-color: #6F3DFF;
  color: #FFFFFF;
}

.btn-primary:active {
  opacity: 0.8;
}

.disabled {
  background-color: #CCCCCC;
  color: #FFFFFF;
}
