<view class="profile-page">
  <view class="profile-hero" style="padding-top: {{statusBarHeight + 24}}px;">
    <view class="profile-hero__body" bindtap="goEditProfile">
      <view class="profile-hero__info">
        <text class="profile-hero__name">{{nickName || '用户'}}</text>
        <text class="profile-hero__phone">{{phone || '未绑定手机号'}}</text>
      </view>
      <t-avatar size="large" shape="circle" t-class="profile-hero__avatar">
        {{nickNameInitial || '?'}}
      </t-avatar>
    </view>
  </view>

  <view class="vip-card {{isMember ? 'vip-card--active' : ''}}">
    <view class="vip-card__badge">
      <t-icon name="user-vip" size="48rpx" color="#D4A017" />
    </view>
    <view class="vip-card__content">
      <view class="vip-card__row vip-card__row--head">
        <text class="vip-card__title">{{planTitle}}</text>
        <view class="vip-card__head-right">
          <t-tag
            wx:if="{{(isMember || isExpired) && memberRemainingLabel}}"
            theme="{{remainingTagTheme}}"
            variant="light"
            size="small"
          >{{memberRemainingLabel}}</t-tag>
        </view>
      </view>
      <text wx:if="{{!isMember && !isExpired && planDesc}}" class="vip-card__desc">{{planDesc}}</text>
      <text wx:if="{{isExpired && memberExpireText}}" class="vip-card__desc">{{memberExpireText}}</text>
      <text wx:if="{{isExpired && planDesc}}" class="vip-card__desc vip-card__desc--sub">{{planDesc}}</text>
      <text wx:elif="{{isMember && memberExpireText}}" class="vip-card__desc">{{memberExpireText}}</text>
    </view>
  </view>

  <view class="profile-body">
    <t-cell-group
      wx:for="{{menuGroups}}"
      wx:for-item="group"
      wx:key="id"
      theme="card"
      t-class="menu-group"
    >
      <t-cell
        wx:for="{{group.items}}"
        wx:for-item="item"
        wx:key="id"
        title="{{item.title}}"
        note="{{item.desc}}"
        leftIcon="{{item.icon}}"
        arrow
        hover
        t-class-note="menu-cell-note"
        data-action="{{item.action}}"
        bind:click="onMenuTap"
      />
    </t-cell-group>

    <view class="logout-wrap">
      <t-button theme="danger" variant="outline" block bind:tap="logout">退出登录</t-button>
    </view>
  </view>
</view>
