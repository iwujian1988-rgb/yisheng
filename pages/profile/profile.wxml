<view class="profile-container">
  <view class="user-card">
    <view class="avatar">
      <text class="avatar-text">{{nickNameInitial || '?'}}</text>
    </view>
    <view class="user-info">
      <text class="nick-name">{{nickName || '用户'}}</text>
      <text class="phone-number">{{phone || '未绑定手机号'}}</text>
    </view>
  </view>

  <view class="plan-card">
    <view class="plan-main">
      <text class="plan-title">{{planTitle}}</text>
      <text class="plan-desc">{{planDesc}}</text>
    </view>
    <button class="plan-btn" bindtap="contactCustomerService">{{planActionText}}</button>
  </view>

  <view class="menu-section">
    <view class="menu-item" bindtap="goToAccountStatus">
      <text class="menu-label">服务状态</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToPurchaseRecords">
      <text class="menu-label">套餐记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToDevice">
      <text class="menu-label">设备管理</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToSettings">
      <text class="menu-label">传输设置</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToHistory">
      <text class="menu-label">发送记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToDebug">
      <text class="menu-label">调试中心</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item" bindtap="goToAgreement">
      <text class="menu-label">用户协议与隐私</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="contactCustomerService">
      <text class="menu-label">联系客服</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <button class="logout-btn" bindtap="logout">退出登录</button>
</view>
