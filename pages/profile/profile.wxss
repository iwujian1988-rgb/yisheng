.profile-page {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding-bottom: var(--app-tab-bar-height, 100rpx);
  box-sizing: border-box;
}

.profile-hero {
  background: linear-gradient(180deg, #F2EDFF 0%, #FCFBFF 100%);
  padding-left: var(--td-spacer-2, 32rpx);
  padding-right: var(--td-spacer-2, 32rpx);
  padding-bottom: 32rpx;
  box-sizing: border-box;
}

.profile-hero__body {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 176rpx;
  padding: 24rpx 28rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  border-radius: 28rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 20rpx rgba(61, 42, 140, 0.05);
}

.profile-hero__info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}

.profile-hero__name {
  font: var(--td-font-title-large, 600 36rpx / 52rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: #101936;
}

.profile-hero__phone {
  font: var(--td-font-body-medium, 28rpx / 44rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: #64739A;
}

.profile-hero__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  margin-left: var(--td-spacer-2, 32rpx);
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 0 0 2rpx rgba(111, 61, 255, 0.16);
}

.vip-card {
  display: flex;
  align-items: stretch;
  margin: 0 32rpx 32rpx;
  border-radius: 28rpx;
  overflow: hidden;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-shadow: 0 6rpx 20rpx rgba(61, 42, 140, 0.05);
  min-height: 120rpx;
}

.vip-card__badge {
  width: 25%;
  min-width: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F2EDFF;
}

.vip-card__content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx var(--td-spacer-2, 32rpx);
  background-color: #FFFFFF;
  min-width: 0;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.vip-card--active .vip-card__content {
  background-color: #F8F5FF;
}

.vip-card__row--head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-width: 0;
}

.vip-card__title {
  flex: 1;
  min-width: 0;
  font: var(--td-font-title-small, 600 28rpx / 44rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vip-card__head-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.vip-card__cta {
  font: var(--td-font-body-small, 24rpx / 40rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: #6F3DFF;
  white-space: nowrap;
}

.vip-card__desc {
  font: var(--td-font-body-small, 24rpx / 40rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: var(--td-text-color-secondary, rgba(0, 0, 0, 0.6));
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-body {
  box-sizing: border-box;
  padding: 0 32rpx;
}

.menu-group {
  display: block;
  margin-bottom: 24rpx !important;
  overflow: hidden;
  border: 2rpx solid rgba(111, 61, 255, 0.10);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(61, 42, 140, 0.03);
}

.menu-cell-note {
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font: var(--td-font-body-small, 24rpx / 40rpx PingFang SC, Microsoft YaHei, Arial Regular) !important;
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4)) !important;
}

.logout-wrap {
  padding: 8rpx 0 48rpx;
}
