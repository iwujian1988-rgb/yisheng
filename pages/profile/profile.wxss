.profile-page {
  min-height: 100vh;
  background-color: var(--td-bg-color-page, #f3f3f3);
  padding-bottom: var(--app-tab-bar-height, 100rpx);
  box-sizing: border-box;
}

.profile-hero {
  background: linear-gradient(135deg, #1677ff 0%, #0958d9 100%);
  padding-left: var(--td-spacer-2, 32rpx);
  padding-right: var(--td-spacer-2, 32rpx);
  padding-bottom: 80rpx;
  box-sizing: border-box;
}

.profile-hero__body {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 160rpx;
}

.profile-hero__info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}

.profile-hero__name {
  font: var(--td-font-title-large, 600 36rpx / 52rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: #ffffff;
}

.profile-hero__phone {
  font: var(--td-font-body-medium, 28rpx / 44rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: rgba(255, 255, 255, 0.75);
}

.profile-hero__avatar {
  flex-shrink: 0;
  margin-left: var(--td-spacer-2, 32rpx);
  background-color: rgba(255, 255, 255, 0.22) !important;
  color: #ffffff !important;
  font-size: 40rpx !important;
  font-weight: 700;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
}

.vip-card {
  display: flex;
  align-items: stretch;
  margin: -48rpx var(--td-spacer-2, 32rpx) var(--td-spacer-2, 32rpx);
  border-radius: var(--td-radius-large, 18rpx);
  overflow: hidden;
  box-shadow: var(--td-shadow-2, 0 3px 14px rgba(0, 0, 0, 0.08));
  min-height: 120rpx;
}

.vip-card__badge {
  width: 25%;
  min-width: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #242424;
}

.vip-card__content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx var(--td-spacer-2, 32rpx);
  background-color: #fff8e7;
  min-width: 0;
}

.vip-card--active .vip-card__content {
  background-color: var(--td-brand-color-light, #e6f4ff);
}

.vip-card__row--head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-width: 0;
}

.vip-card__title {
  flex: 1;
  min-width: 0;
  font: var(--td-font-title-small, 600 28rpx / 44rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vip-card__head-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.vip-card__cta {
  font: var(--td-font-body-small, 24rpx / 40rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: var(--td-brand-color, #1677ff);
  white-space: nowrap;
}

.vip-card__desc {
  font: var(--td-font-body-small, 24rpx / 40rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: var(--td-text-color-secondary, rgba(0, 0, 0, 0.6));
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-body {
  box-sizing: border-box;
}

.menu-group {
  margin-bottom: var(--td-spacer-2, 32rpx) !important;
}

.menu-cell-note {
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font: var(--td-font-body-small, 24rpx / 40rpx PingFang SC, Microsoft YaHei, Arial Regular) !important;
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4)) !important;
}

.logout-wrap {
  padding: var(--td-spacer, 16rpx) var(--td-spacer-2, 32rpx) var(--td-spacer-3, 48rpx);
}
