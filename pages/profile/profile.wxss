/* pages/profile/profile.wxss */
.profile-container {
  min-height: 100vh;
  background-color: #F5F7FA;
}

/* 用户信息 */
.user-section {
  display: flex;
  align-items: center;
  padding: 32px;
  background-color: #FFFFFF;
  margin-bottom: 12px;
}

.avatar {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background-color: #4A90E2;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16px;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 24px;
  color: #FFFFFF;
  font-weight: 500;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.nick-name {
  font-size: 18px;
  font-weight: 500;
  color: #333333;
  margin-bottom: 4px;
}

.phone-number {
  font-size: 14px;
  color: #999999;
}

/* 菜单 */
.menu-section {
  background-color: #FFFFFF;
  padding: 0 32px;
  margin-bottom: 12px;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 0;
  border-bottom: 1px solid #F0F0F0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 18px;
  margin-right: 12px;
  width: 24px;
  text-align: center;
}

.status-icon {
  color: #52C41A;
}

.device-icon {
  color: #4A90E2;
}

.settings-icon {
  color: #FAAD14;
}

.history-icon {
  color: #999999;
}

.help-icon {
  color: #4A90E2;
  font-weight: bold;
}

.menu-label {
  font-size: 15px;
  color: #333333;
}

.menu-arrow {
  font-size: 12px;
  color: #CCCCCC;
}

/* 退出按钮 */
.logout-btn {
  width: calc(100% - 64px);
  margin: 24px 32px;
  height: 52px;
  border-radius: 12px;
  font-size: 16px;
  color: #F5222D;
  background-color: #FFFFFF;
  border: 1px solid #F5222D;
  line-height: 52px;
}
