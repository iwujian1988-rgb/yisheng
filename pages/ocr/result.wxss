/* pages/ocr/result.wxss */
.ocr-result-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.image-section {
  margin-bottom: 40rpx;
}

.preview-image {
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
  background-color: #FFFFFF;
}

.image-placeholder {
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
  background-color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-text {
  font-size: 28rpx;
  color: #98A1B8;
}

.result-section {
  flex: 1;
  margin-bottom: 48rpx;
}

.result-label {
  display: block;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #101936;
  font-weight: 500;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.meta-item {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background-color: #EAF3FF;
  color: #357ABD;
  font-size: 22rpx;
  line-height: 1.4;
}

.safety-note {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background-color: #FFF7E6;
  color: #8A5A00;
  font-size: 24rpx;
  line-height: 1.5;
}

.result-box {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  min-height: 240rpx;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.result-text {
  font-size: 30rpx;
  color: #101936;
  line-height: 1.8;
  word-break: break-all;
}

.result-textarea {
  width: 100%;
  min-height: 440rpx;
  font-size: 30rpx;
  color: #101936;
  line-height: 1.8;
  word-break: break-all;
}

.result-empty {
  font-size: 28rpx;
  color: #98A1B8;
}

.action-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 80rpx;
}

.action-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-primary {
  background-color: #6F3DFF;
  color: #FFFFFF;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-outline {
  background-color: transparent;
  color: #6F3DFF;
  border: 2rpx solid #6F3DFF;
}
