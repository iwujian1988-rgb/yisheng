<view class="ocr-container">
  <view class="image-section">
    <view class="image-area" bindtap="chooseImage">
      <image
        wx:if="{{imageUrl}}"
        class="preview-image"
        src="{{imageUrl}}"
        mode="aspectFit"
      />
      <view wx:else class="image-placeholder">
        <text class="placeholder-icon">OCR</text>
        <text class="placeholder-text">拍照或选择图片</text>
      </view>
    </view>
  </view>

  <view class="result-section">
    <view class="result-head">
      <text class="result-label">识别结果</text>
      <text wx:if="{{resultMeta}}" class="result-meta">{{resultMeta.elapsedMs}}ms</text>
    </view>
    <view class="result-box">
      <text wx:if="{{recognizing}}" class="result-empty">正在提取文字...</text>
      <textarea
        wx:elif="{{resultText}}"
        class="result-textarea"
        value="{{resultText}}"
        maxlength="5000"
        bindinput="updateResultText"
        placeholder="识别出的文字会显示在这里，可以直接修改"
        placeholder-class="input-placeholder"
      />
      <text wx:elif="{{errorMessage}}" class="result-empty">{{errorMessage}}</text>
      <text wx:else class="result-empty">选择图片后自动识别文字</text>
    </view>
  </view>

  <view class="action-section">
    <button class="secondary-btn" bindtap="chooseImage">
      {{resultText ? '重新选择' : '选择图片'}}
    </button>
    <button
      wx:if="{{!returnToAi}}"
      class="secondary-btn"
      disabled="{{!resultText || formatting}}"
      loading="{{formatting}}"
      bindtap="goSmartEdit"
    >
      专业整理
    </button>
    <button
      class="primary-btn"
      disabled="{{!resultText}}"
      bindtap="confirmResult"
    >
      {{returnToAi ? '填入 AI' : '使用这段'}}
    </button>
  </view>
</view>
