.container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #000000;
}

.bottom-toolbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  height: 120rpx;
  background: #1A1A1A;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  gap: 20rpx;
  safe-area-inset-bottom: env(safe-area-inset-bottom);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.toolbar-btn {
  height: 80rpx;
  border-radius: 40rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.toolbar-btn::after {
  border: none;
}

.rotate-btn {
  width: 80rpx;
  background: #FFFFFF;
}

.rotate-icon {
  font-size: 40rpx;
  color: #1A1A1A;
}

.confirm-btn {
  flex: 1;
  background: #4A90E2;
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.confirm-btn.disabled {
  background: #3A3A3A;
  color: #666666;
}
