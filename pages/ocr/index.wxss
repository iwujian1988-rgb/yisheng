/* pages/ocr/index.wxss */
.ocr-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px;
  box-sizing: border-box;
}

.image-section {
  margin-bottom: 20px;
}

.image-area {
  width: 100%;
  height: 240px;
  background-color: #FFFFFF;
  border: 2px dashed #E5E5E5;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.placeholder-icon {
  font-size: 40px;
  margin-bottom: 8px;
}

.placeholder-text {
  font-size: 14px;
  color: #999999;
}

.result-section {
  margin-bottom: 20px;
}

.result-label {
  display: block;
  margin-bottom: 8px;
  font-size: 14px;
  color: #333333;
  font-weight: 500;
}

.result-box {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 16px;
  min-height: 80px;
  border: 1px solid #E5E5E5;
  box-sizing: border-box;
}

.result-text {
  font-size: 14px;
  color: #333333;
  line-height: 1.8;
  word-break: break-all;
}

.result-empty {
  font-size: 14px;
  color: #999999;
  line-height: 1.8;
}

.action-section {
  margin-top: 20px;
}

.action-btn {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
}

.btn-primary {
  background-color: #4A90E2;
  color: #FFFFFF;
}

.btn-primary:active {
  opacity: 0.8;
}
