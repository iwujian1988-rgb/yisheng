.ocr-page {
  min-height: 100vh;
  padding: var(--td-spacer-2, 32rpx);
  padding-bottom: calc(var(--td-spacer-3, 48rpx) + 120rpx);
  background-color: var(--td-bg-color-page, #f3f3f3);
  box-sizing: border-box;
}

.image-section {
  margin-bottom: var(--td-spacer-2, 32rpx);
}

.image-card {
  width: 100%;
  height: 320rpx;
  background-color: var(--td-bg-color-container, #ffffff);
  border-radius: var(--td-radius-large, 18rpx);
  border: 2rpx dashed var(--td-component-border, #dcdcdc);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-sizing: border-box;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--td-spacer, 16rpx);
  padding: 0 40rpx;
}

.placeholder-title {
  font: var(--td-font-title-small, 600 28rpx / 44rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
}

.placeholder-desc,
.image-tip {
  font: var(--td-font-body-small, 24rpx / 40rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: var(--td-text-color-secondary, rgba(0, 0, 0, 0.6));
  line-height: 1.6;
}

.image-tip {
  margin-top: var(--td-spacer, 16rpx);
}

.image-repick {
  display: flex;
  justify-content: center;
  margin-top: var(--td-spacer, 16rpx);
}

.result-section {
  margin-bottom: var(--td-spacer-2, 32rpx);
}

.result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--td-spacer, 16rpx);
  padding: 0 4rpx;
}

.result-title {
  font: var(--td-font-title-small, 600 28rpx / 44rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
}

.result-meta {
  font: var(--td-font-body-small, 24rpx / 40rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
}

.result-card {
  background-color: var(--td-bg-color-container, #ffffff);
  border-radius: var(--td-radius-large, 18rpx);
  padding: var(--td-spacer-2, 32rpx);
  box-sizing: border-box;
}

.result-card--center {
  min-height: 240rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--td-spacer, 16rpx);
}

.result-card--list {
  padding: 0;
  overflow: hidden;
}

.result-hint {
  font: var(--td-font-body-medium, 28rpx / 44rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
}

.result-error {
  font: var(--td-font-body-medium, 28rpx / 44rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: var(--td-error-color, #d54941);
  line-height: 1.6;
}

.line-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--td-spacer-1, 24rpx) var(--td-spacer-2, 32rpx);
  border-bottom: 1rpx solid var(--td-component-stroke, #e7e7e7);
}

.tool-summary {
  font: var(--td-font-body-small, 24rpx / 40rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
}

.line-list {
  max-height: 640rpx;
  overflow-y: auto;
}

.line-item {
  padding: var(--td-spacer-1, 24rpx) var(--td-spacer-2, 32rpx);
  border-bottom: 1rpx solid var(--td-gray-color-1, #f3f3f3);
}

.line-item:last-child {
  border-bottom: none;
}

.line-item--checked {
  background-color: var(--td-brand-color-light, #e6f4ff);
}

.line-checkbox {
  align-items: flex-start;
}

.line-text {
  font: var(--td-font-body-medium, 28rpx / 44rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
  word-break: break-all;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: var(--td-spacer-2, 32rpx);
  padding-bottom: calc(var(--td-spacer-2, 32rpx) + env(safe-area-inset-bottom));
  background-color: var(--td-bg-color-container, #ffffff);
  border-top: 1rpx solid var(--td-component-stroke, #e7e7e7);
  box-sizing: border-box;
}
