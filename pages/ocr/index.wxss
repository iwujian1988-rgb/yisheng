.ocr-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 24rpx 28rpx 40rpx;
  box-sizing: border-box;
}

.image-section {
  margin-bottom: 24rpx;
}

.image-area {
  width: 100%;
  height: 360rpx;
  background-color: #FFFFFF;
  border: 2rpx dashed #DCE3EE;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.placeholder-icon {
  font-size: 36rpx;
  color: #1677FF;
  font-weight: 700;
}

.placeholder-text {
  font-size: 28rpx;
  color: #7A8499;
}

.result-section {
  margin-bottom: 24rpx;
}

.result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.result-label {
  font-size: 30rpx;
  color: #18233C;
  font-weight: 700;
}

.result-meta {
  font-size: 24rpx;
  color: #7A8499;
}

.result-box {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 22rpx;
  min-height: 420rpx;
  border: 2rpx solid #E6EBF2;
  box-sizing: border-box;
}

.result-textarea {
  width: 100%;
  min-height: 380rpx;
  font-size: 30rpx;
  line-height: 1.65;
  color: #18233C;
}

.input-placeholder,
.result-empty {
  font-size: 28rpx;
  color: #9AA3B5;
  line-height: 1.7;
}

.action-section {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.primary-btn,
.secondary-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0;
  border: none;
}

.primary-btn {
  grid-column: 1 / span 2;
  background-color: #1677FF;
  color: #FFFFFF;
}

.secondary-btn {
  background-color: #FFFFFF;
  color: #1677FF;
  border: 2rpx solid #D9E8FA;
}

.primary-btn::after,
.secondary-btn::after {
  border: none;
}
