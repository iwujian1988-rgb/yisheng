.ocr-page {
  min-height: 100vh;
  padding: var(--td-spacer-2, 32rpx);
  padding-bottom: calc(var(--td-spacer-3, 48rpx) + 120rpx);
  background-color: #FCFBFF;
  box-sizing: border-box;
}

.image-section {
  margin-bottom: var(--td-spacer-2, 32rpx);
}

.image-card {
  width: 100%;
  height: 320rpx;
  background: linear-gradient(160deg, #FFFFFF 0%, #F8F5FF 100%);
  border-radius: 28rpx;
  border: 2rpx dashed rgba(111, 61, 255, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-sizing: border-box;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 0 40rpx;
}

.placeholder-title {
  font: var(--td-font-title-small, 600 28rpx / 44rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: #101936;
}

.placeholder-desc,
.image-tip {
  font: var(--td-font-body-small, 24rpx / 40rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: #64739A;
  line-height: 1.6;
}

.image-tip {
  margin-top: var(--td-spacer, 16rpx);
}

.image-repick {
  display: flex;
  justify-content: center;
  margin-top: var(--td-spacer, 16rpx);
}

.result-section {
  margin-bottom: var(--td-spacer-2, 32rpx);
}

.result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--td-spacer, 16rpx);
  padding: 0 4rpx;
}

.result-title {
  font: var(--td-font-title-small, 600 28rpx / 44rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: #101936;
}

.result-meta {
  font: var(--td-font-body-small, 24rpx / 40rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: #64739A;
}

.result-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: var(--td-spacer-2, 32rpx);
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-shadow: 0 4rpx 16rpx rgba(61, 42, 140, 0.04);
  box-sizing: border-box;
}

.result-card--center {
  min-height: 240rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--td-spacer, 16rpx);
}

.result-card--list {
  padding: 0;
  overflow: hidden;
}

.result-hint {
  font: var(--td-font-body-medium, 28rpx / 44rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: #64739A;
}

.result-error {
  font: var(--td-font-body-medium, 28rpx / 44rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: var(--td-error-color, #d54941);
  line-height: 1.6;
}

.line-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--td-spacer-1, 24rpx) var(--td-spacer-2, 32rpx);
  border-bottom: 1rpx solid rgba(111, 61, 255, 0.10);
}

.tool-summary {
  font: var(--td-font-body-small, 24rpx / 40rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: #64739A;
}

.line-list {
  max-height: 640rpx;
  overflow-y: auto;
}

.line-item {
  padding: var(--td-spacer-1, 24rpx) var(--td-spacer-2, 32rpx);
  border-bottom: 1rpx solid rgba(111, 61, 255, 0.08);
}

.line-item:last-child {
  border-bottom: none;
}

.line-item--checked {
  background-color: #F2EDFF;
}

.line-checkbox {
  align-items: flex-start;
}

.line-text {
  font: var(--td-font-body-medium, 28rpx / 44rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: #101936;
  word-break: break-all;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: var(--td-spacer-2, 32rpx);
  padding-bottom: calc(var(--td-spacer-2, 32rpx) + env(safe-area-inset-bottom));
  background-color: rgba(252, 251, 255, 0.96);
  border-top: 1rpx solid rgba(111, 61, 255, 0.10);
  box-sizing: border-box;
}
