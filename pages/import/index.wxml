<view class="import-container">
  <view class="entry-list">
    <view class="entry-card" bindtap="goManualInput">
      <view class="entry-icon icon-manual">
        <text class="icon-text">TXT</text>
      </view>
      <view class="entry-info">
        <text class="entry-title">直接编辑</text>
        <text class="entry-desc">粘贴或输入文字，确认后发送到电脑。</text>
      </view>
      <text class="entry-arrow">›</text>
    </view>

    <view class="entry-card" bindtap="goOcr">
      <view class="entry-icon icon-ocr">
        <text class="icon-text">OCR</text>
      </view>
      <view class="entry-info">
        <text class="entry-title">图片识别</text>
        <text class="entry-desc">从照片、截图或文档图片中提取文字。</text>
      </view>
      <text class="entry-arrow">›</text>
    </view>

    <view class="entry-card" bindtap="goAsr">
      <view class="entry-icon icon-asr">
        <text class="icon-text">ASR</text>
      </view>
      <view class="entry-info">
        <text class="entry-title">语音转写</text>
        <text class="entry-desc">把录音内容转成可编辑文本。</text>
      </view>
      <text class="entry-arrow">›</text>
    </view>

    <view class="entry-card" bindtap="goAi">
      <view class="entry-icon icon-ai">
        <text class="icon-text">AI</text>
      </view>
      <view class="entry-info">
        <text class="entry-title">智能创作</text>
        <text class="entry-desc">根据快捷指令整理、生成或优化文本。</text>
      </view>
      <text class="entry-arrow">›</text>
    </view>

    <view class="entry-card" bindtap="goTemplate">
      <view class="entry-icon icon-template">
        <text class="icon-text">TPL</text>
      </view>
      <view class="entry-info">
        <text class="entry-title">场景模板</text>
        <text class="entry-desc">选择常用场景，按字段补充关键信息。</text>
      </view>
      <text class="entry-arrow">›</text>
    </view>
  </view>
</view>
