.page { padding: 32rpx; background: #f5f6f8; min-height: 100vh; }

.header {
  background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  border-radius: 18rpx;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  color: #fff;
  margin-bottom: 32rpx;
}

.header-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.header-title { font-size: 36rpx; font-weight: bold; margin-bottom: 8rpx; }
.header-desc { font-size: 24rpx; opacity: 0.9; margin-bottom: 16rpx; }
.header-status { padding: 4rpx 16rpx; }

.section-label {
  padding: 0 8rpx 16rpx;
  color: #888;
  font-size: 26rpx;
}

.feature-list {
  background: #fff;
  border-radius: 18rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.feature-item:last-child { border-bottom: none; }

.feature-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #e6f4ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.feature-body { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.feature-title { font-size: 30rpx; color: #333; }
.feature-desc { font-size: 24rpx; color: #999; }
.feature-arrow { color: #ccc; font-size: 40rpx; }

.upgrade-card {
  background: #fff;
  border-radius: 18rpx;
  padding: 32rpx;
}

.upgrade-title { font-size: 30rpx; font-weight: bold; margin-bottom: 16rpx; color: #333; }
.upgrade-desc { font-size: 26rpx; color: #666; line-height: 1.6; margin-bottom: 32rpx; }

.tips-card {
  background: #fff7e6;
  border-radius: 18rpx;
  padding: 24rpx 32rpx;
}

.tips-title { font-size: 26rpx; color: #d46b08; margin-bottom: 8rpx; }
.tips-desc { font-size: 24rpx; color: #8c6e2a; line-height: 1.6; }
