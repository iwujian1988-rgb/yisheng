.page { padding: 32rpx; background: #FCFBFF; min-height: 100vh; }

.header {
  background: linear-gradient(135deg, #6F3DFF 0%, #4096ff 100%);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  color: #fff;
  margin-bottom: 32rpx;
}

.header-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.header-title { font-size: 36rpx; font-weight: bold; margin-bottom: 8rpx; }
.header-desc { font-size: 24rpx; opacity: 0.9; margin-bottom: 16rpx; }
.header-status { padding: 4rpx 16rpx; }

.section-label {
  padding: 0 8rpx 16rpx;
  color: #64739A;
  font-size: 26rpx;
}

.feature-list {
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid rgba(111, 61, 255, 0.08);
}

.feature-item:last-child { border-bottom: none; }

.feature-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #F2EDFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.feature-body { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.feature-title { font-size: 30rpx; color: #101936; }
.feature-desc { font-size: 24rpx; color: #98A1B8; }
.feature-arrow { color: #ccc; font-size: 40rpx; }

.upgrade-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.upgrade-title { font-size: 30rpx; font-weight: bold; margin-bottom: 16rpx; color: #101936; }
.upgrade-desc { font-size: 26rpx; color: #64739A; line-height: 1.6; margin-bottom: 32rpx; }

.tips-card {
  background: #fff7e6;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
}

.tips-title { font-size: 26rpx; color: #d46b08; margin-bottom: 8rpx; }
.tips-desc { font-size: 24rpx; color: #8c6e2a; line-height: 1.6; }
