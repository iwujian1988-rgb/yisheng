<!--pages/home/home.wxml-->
<view class="container">
  <!-- 顶部状态栏 -->
  <view class="status-bar">
    <view class="status-dot {{connected ? 'connected' : ''}}"></view>
    <text class="status-text">{{statusText}}</text>
  </view>

  <!-- 设备卡片 -->
  <view class="card device-card">
    <view class="card-header">
      <text class="card-title">设备连接</text>
      <text class="device-id" wx:if="{{deviceId}}">{{deviceId.slice(-4)}}</text>
    </view>
    <view class="device-info">
      <text class="info-label">连接状态</text>
      <text class="info-value {{connected ? 'success' : ''}}">{{statusText}}</text>
    </view>
    <button
      class="btn {{connected ? 'btn-disconnect' : 'btn-connect'}}"
      bindtap="onConnectTap"
    >
      {{connected ? '断开连接' : '搜索设备'}}
    </button>
  </view>

  <!-- 输入卡片 -->
  <view class="card input-card">
    <view class="card-header">
      <text class="card-title">输入文本</text>
      <text class="char-count">{{inputText.length}}/5000</text>
    </view>
    <textarea
      class="text-input"
      placeholder="请输入要传输的病历内容..."
      value="{{inputText}}"
      bindinput="onTextInput"
      maxlength="5000"
      auto-height
      disable-default-padding
    />
    <view class="input-actions">
      <text class="clear-btn" bindtap="onClearTap" wx:if="{{inputText}}">清空</text>
    </view>
  </view>

  <!-- 转换预览 -->
  <view class="card preview-card" wx:if="{{convertedText}}">
    <view class="card-header">
      <text class="card-title">VUC转换预览</text>
    </view>
    <text class="preview-text">{{convertedText}}</text>
  </view>

  <!-- 发送按钮 -->
  <view class="send-row">
    <button
      class="btn-cancel"
      bindtap="onCancelTap"
      wx:if="{{sending}}"
    >
      取消
    </button>
    <button
      class="btn-send {{connected && inputText && !sending ? 'active' : ''}}"
      bindtap="onSendTap"
      disabled="{{!connected || !inputText || sending}}"
    >
      {{sending ? '发送中 ' + sendProgress + '%' : '发送到电脑'}}
    </button>
  </view>

  <!-- 日志区域 -->
  <view class="card log-card" wx:if="{{logs.length > 0}}">
    <view class="card-header">
      <text class="card-title">操作日志</text>
    </view>
    <scroll-view class="log-scroll" scroll-y scroll-into-view="log-top">
      <view id="log-top"></view>
      <view class="log-item" wx:for="{{logs}}" wx:key="index">
        <text class="log-time">{{item.time}}</text>
        <text class="log-msg">{{item.message}}</text>
      </view>
    </scroll-view>
  </view>
</view>
