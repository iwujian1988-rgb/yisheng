<view class="page-home">
  <view class="connect-guide section-block" wx:if="{{!connected}}">
    <view class="connect-guide__head">
      <t-icon name="bluetooth" size="40rpx" color="#1677FF" />
      <text class="connect-guide__title">尚未连接电脑端设备</text>
    </view>
    <text class="connect-guide__desc">连接蓝牙设备后，内容将自动输入到电脑</text>
    <t-button theme="primary" block bind:tap="goConnect" t-class="connect-guide__btn">
      立即连接设备
    </t-button>
  </view>

  <t-cell-group wx:else theme="card" t-class="section-block device-status-group">
    <t-cell
      title="{{statusTitle}}"
      description="{{statusDesc}}{{isMember ? ' · AI 助手有效期至 ' + memberExpiry : ''}}"
      arrow
      hover
      bind:click="onConnectTap"
      t-class-left="device-status-left"
    >
      <view slot="left-icon" class="status-dot-wrap">
        <view class="status-dot connected"></view>
      </view>
      <view slot="note">
        <t-tag wx:if="{{connected}}" theme="success" variant="light" size="small">已连接</t-tag>
        <t-tag wx:else theme="default" variant="light" size="small">未连接</t-tag>
      </view>
    </t-cell>
  </t-cell-group>

  <view class="composer-card section-block">
    <view class="composer-head">
      <text class="composer-title">发送内容</text>
      <text class="char-count">{{inputText.length}}/5000</text>
    </view>
    <t-textarea
      placeholder="输入或粘贴要发送到电脑的内容"
      value="{{inputText}}"
      maxlength="5000"
      autosize="{{textareaAutosize}}"
      disable-default-padding
      bind:change="onTextInput"
      t-class="composer-textarea"
    />
    <view class="composer-actions" wx:if="{{inputText}}">
      <t-button variant="text" size="small" bind:tap="onClearTap">清空</t-button>
    </view>
    <view class="composer-send">
      <view class="speed-mode-hint" wx:if="{{speedModeText}}" bindtap="goTransferSettings">
        <text class="speed-mode-hint__text">{{speedModeText}}</text>
        <text class="speed-mode-hint__link">调整</text>
      </view>
      <view class="composer-send-actions">
      <t-button
        wx:if="{{sending}}"
        variant="outline"
        size="medium"
        bind:tap="onCancelSendTap"
        t-class="cancel-send-btn"
      >
        取消
      </t-button>
      <t-button
        wx:if="{{!connected && !sending}}"
        theme="light"
        block
        bind:tap="goConnect"
        t-class="send-action-btn"
      >
        请先连接设备
      </t-button>
      <t-button
        wx:else
        theme="primary"
        block
        loading="{{sending}}"
        disabled="{{!canSend || sending || !connected}}"
        bind:tap="onSendTap"
        t-class="send-action-btn"
      >
        {{sending ? '发送中 ' + sendProgress + '%' : '发送到电脑'}}
      </t-button>
      </view>
    </view>
  </view>

  <view class="section-label">文本工具</view>
  <view class="tool-grid section-block">
    <view class="tool-item" bindtap="goHistory">
      <view class="tool-icon icon-history">📋</view>
      <text class="tool-title">历史记录</text>
    </view>
    <view class="tool-item" bindtap="goPhrases">
      <view class="tool-icon icon-phrases">⚡</view>
      <text class="tool-title">快速短语</text>
    </view>
    <view class="tool-item" bindtap="goSnippets">
      <view class="tool-icon icon-snippets">📦</view>
      <text class="tool-title">文本片段</text>
    </view>
    <view class="tool-item" bindtap="onConnectTap">
      <view class="tool-icon icon-device">🔧</view>
      <text class="tool-title">设备管理</text>
    </view>
  </view>

  <view class="section-label">AI 助手{{isMember ? ' · 已开通' : ' · 升级解锁'}}</view>
  <view wx:if="{{isMember}}" class="ai-grid section-block">
    <view class="ai-item" bindtap="goAiText">
      <view class="ai-icon icon-text">✨</view>
      <view class="ai-body">
        <text class="ai-title">智能整理</text>
        <text class="ai-desc">AI 帮你整理文本结构</text>
      </view>
    </view>
    <view class="ai-item" bindtap="goAiTemplate">
      <view class="ai-icon icon-template">📑</view>
      <view class="ai-body">
        <text class="ai-title">模板库</text>
        <text class="ai-desc">按模板生成结构化内容</text>
      </view>
    </view>
    <view class="ai-item" bindtap="goOcr">
      <view class="ai-icon icon-ocr">📷</view>
      <view class="ai-body">
        <text class="ai-title">图片识别</text>
        <text class="ai-desc">图片转文字</text>
      </view>
    </view>
    <view class="ai-item" bindtap="goAsr">
      <view class="ai-icon icon-asr">🎤</view>
      <view class="ai-body">
        <text class="ai-title">语音转写</text>
        <text class="ai-desc">语音转文字</text>
      </view>
    </view>
  </view>

  <view wx:else class="ai-upgrade-card section-block" bindtap="goAiAssistant">
    <view class="upgrade-icon">🤖</view>
    <view class="upgrade-body">
      <text class="upgrade-title">升级 AI 助手</text>
      <text class="upgrade-desc">AI 帮你整理文本、识别图片、转写语音</text>
    </view>
    <t-icon name="chevron-right" size="40rpx" color="rgba(0,0,0,0.26)" />
  </view>

  <view class="banner section-block" wx:if="{{banner}}" bindtap="openBanner">
    <t-icon name="info-circle" size="36rpx" color="#1677FF" t-class="banner-icon" />
    <view class="banner-copy">
      <text class="banner-title">{{banner.title}}</text>
      <text class="banner-subtitle">{{banner.subtitle}}</text>
    </view>
    <t-icon name="chevron-right" size="32rpx" color="rgba(0,0,0,0.26)" />
  </view>
</view>
