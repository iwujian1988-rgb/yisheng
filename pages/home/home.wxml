<view class="container">
  <view class="device-strip">
    <view class="status-dot {{connected ? 'connected' : ''}}"></view>
    <text class="device-strip-text">设备：{{statusText}}</text>
    <text class="device-strip-action" bindtap="onConnectTap">{{connected ? '查看' : '连接'}}</text>
  </view>

  <view class="card creation-card">
    <view class="card-header">
      <text class="card-title">准备要发送的内容</text>
    </view>

    <view class="template-feature" bindtap="goTemplates">
      <view class="feature-copy">
        <text class="feature-title">场景模板</text>
        <text class="feature-desc">按场景快速生成可编辑文本</text>
      </view>
      <text class="feature-arrow">›</text>
    </view>

    <view class="edit-entry" bindtap="goManualInput">
      <text class="edit-icon">TXT</text>
      <view class="edit-copy">
        <text class="edit-title">直接编辑</text>
        <text class="edit-desc">手动输入或粘贴文本，然后发送到电脑</text>
      </view>
      <text class="feature-arrow">›</text>
    </view>

    <view class="source-title-row">
      <text class="source-title">AI 辅助输入</text>
    </view>
    <view class="source-grid">
      <view class="source-item" bindtap="goAi">
        <text class="quick-icon">AI</text>
        <text class="quick-title">智能创作</text>
      </view>
      <view class="source-item" bindtap="goOcr">
        <text class="quick-icon">OCR</text>
        <text class="quick-title">图片识别</text>
      </view>
      <view class="source-item" bindtap="goAsr">
        <text class="quick-icon">ASR</text>
        <text class="quick-title">语音转写</text>
      </view>
    </view>
  </view>

  <view class="banner" wx:if="{{banner}}" bindtap="openBanner">
    <view class="banner-copy">
      <text class="banner-title">{{banner.title}}</text>
      <text class="banner-subtitle">{{banner.subtitle}}</text>
    </view>
    <text class="banner-arrow">›</text>
  </view>

  <view class="section-head">
    <text class="section-title">最近发送</text>
    <text class="quick-more" bindtap="goHistory">全部</text>
  </view>

  <view class="recent-list" wx:if="{{recentRecords.length > 0}}">
    <view
      class="recent-item"
      wx:for="{{recentRecords}}"
      wx:key="id"
      bindtap="openHistoryRecord"
      data-id="{{item.id}}"
    >
      <view class="recent-main">
        <text class="recent-type">{{item.type}}</text>
        <text class="recent-time">{{item.time}}</text>
      </view>
      <text class="recent-meta">{{item.length}}</text>
    </view>
  </view>

  <view class="empty-recent" wx:elif="{{!loadingRecords}}">
    <text class="empty-title">还没有发送记录</text>
    <text class="empty-desc">完成一次发送后，会在这里快速查看。</text>
  </view>
</view>
