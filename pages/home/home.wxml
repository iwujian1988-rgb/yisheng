<view class="page-home">

  <!-- ============ Status bar spacer (custom 导航避让状态栏 + 胶囊) ============ -->
  <view class="status-bar-spacer"></view>

  <!-- ============ Top greeting ============ -->
  <view class="top-header">
    <view class="brand">
      <text class="brand__greeting">{{greeting}}</text>
      <text class="brand__greeting-note">{{greetingNote}}</text>
    </view>
  </view>

  <!-- ============ Connection capsule ============ -->
  <view class="conn-capsule" bindtap="onConnectTap" hover-class="conn-capsule--hover">
    <view class="conn-dot {{connected ? 'is-on' : ''}}"></view>
    <view class="conn-text">
      {{connected ? '已连接｜蓝牙设备已就绪' : (statusTitle || '未连接｜点击连接设备')}}
    </view>
    <t-icon name="chevron-right" size="32rpx" color="#64739A" />
  </view>

  <!-- ============ Composer (无外层卡片，标题在输入框外) ============ -->
  <view class="composer">
    <view class="composer__head">
      <view class="composer__title-row">
        <text class="composer__title">发送内容</text>
        <text class="composer__guide-link" bindtap="openGuidePoster">？如何使用</text>
      </view>
    </view>

    <view class="composer__field">
      <t-textarea
        class="composer__textarea"
        placeholder="输入或粘贴要发送的内容..."
        value="{{inputText}}"
        maxlength="5000"
        autosize="{{ {minHeight: 160, maxHeight: 160} }}"
        disable-default-padding
        bind:change="onTextInput"
        t-class="composer__textarea-inner"
      />

      <view class="composer__bar">
        <text class="composer__count">{{inputText.length || 0}}/5000</text>
        <view class="composer__bar-right">
          <view class="composer__tool" bindtap="openFullscreen"><t-icon name="fullscreen" size="34rpx" color="#8B95AA" /></view>
          <view class="composer__tool" wx:if="{{inputText}}" bindtap="onClearTap"><t-icon name="delete" size="34rpx" color="#8B95AA" /></view>
          <view
            wx:if="{{sending}}"
            class="composer__send composer__send--stop"
            bindtap="openTransferModal"
          >
            <text>发送中 {{sendProgress}}%</text>
          </view>
          <view
            wx:else
            class="composer__send {{(!canSend || sending || !connected) ? 'is-disabled' : ''}}"
            bindtap="onSendTap"
          >
            <text wx:if="{{!connected}}">未连接</text>
            <text wx:else>发送</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="fullscreen-composer" wx:if="{{isFullscreen}}">
    <view class="fullscreen-composer__header">
      <view>
        <text class="fullscreen-composer__title">全屏输入</text>
        <text class="fullscreen-composer__hint">文字将发送到电脑当前光标位置</text>
      </view>
    </view>
    <view class="fullscreen-composer__editor">
      <view class="fullscreen-composer__textarea-wrap">
        <t-textarea
          class="fullscreen-composer__textarea"
          placeholder="输入或粘贴要发送的内容..."
          value="{{inputText}}"
          maxlength="5000"
          autosize="{{ {minHeight: 360, maxHeight: 800} }}"
          disable-default-padding
          bind:change="onTextInput"
          t-class="fullscreen-composer__textarea-inner"
        />
      </view>
      <view class="fullscreen-composer__tools">
        <text class="fullscreen-composer__count">{{inputText.length || 0}}/5000</text>
        <view class="fullscreen-composer__toolset">
          <view class="fullscreen-composer__tool" bindtap="closeFullscreen"><t-icon name="fullscreen-exit" size="38rpx" color="#8B95AA" /></view>
          <view class="fullscreen-composer__tool" bindtap="onClearTap"><t-icon name="delete" size="38rpx" color="#8B95AA" /></view>
          <view wx:if="{{sending}}" class="fullscreen-composer__tool fullscreen-composer__tool--stop" bindtap="openTransferModal"><t-icon name="send" size="38rpx" color="#FFFFFF" /></view>
          <view wx:else class="fullscreen-composer__tool fullscreen-composer__tool--send {{(!canSend || !connected) ? 'is-disabled' : ''}}" bindtap="onSendTap"><t-icon name="send" size="38rpx" color="#8B95AA" /></view>
        </view>
      </view>
    </view>
  </view>

  <view class="transfer-modal" wx:if="{{sending && showTransferModal}}" catchtap="stopTransferModalTap">
    <view class="transfer-sheet" catchtap="stopTransferModalTap">
      <view class="transfer-sheet__topline">
        <view class="transfer-sheet__status">
          <view class="transfer-sheet__status-icon {{sendPaused ? 'is-paused' : ''}}">
            <t-icon name="{{sendPaused ? 'pause' : 'send'}}" size="32rpx" color="{{sendPaused ? '#6F3DFF' : '#FFFFFF'}}" />
          </view>
          <view>
            <text class="transfer-sheet__eyebrow">{{sendPaused ? '传输已暂停' : '正在发送到电脑'}}</text>
            <text class="transfer-sheet__status-note">{{sendPaused ? '确认光标位置后再继续' : '请保持当前操作状态'}}</text>
          </view>
        </view>
        <view class="transfer-sheet__collapse" bindtap="closeTransferModal" hover-class="transfer-sheet__collapse--hover">
          <text>收起</text>
        </view>
      </view>

      <view class="transfer-sheet__progress-head">
        <text class="transfer-sheet__progress-value">{{sendProgress}}</text>
        <text class="transfer-sheet__progress-unit">%</text>
      </view>
      <view class="transfer-sheet__progress-track">
        <view class="transfer-sheet__progress-bar {{sendPaused ? 'is-paused' : ''}}" style="width: {{sendProgress}}%;"></view>
      </view>
      <text class="transfer-sheet__progress-caption">{{sendPaused ? '发送进度已停在这里' : '文字正在逐步输入，请耐心等待'}}</text>

      <view class="transfer-sheet__warning">
        <view class="transfer-sheet__warning-icon"><text>!</text></view>
        <view class="transfer-sheet__warning-copy">
          <text class="transfer-sheet__warning-title">请不要移动或点击鼠标</text>
          <text class="transfer-sheet__warning-text">保持电脑光标停留在目标输入框中，也不要操作键盘。切换窗口或移动光标，文字可能输入到错误位置。</text>
        </view>
      </view>

      <view class="transfer-sheet__steps">
        <view class="transfer-sheet__step"><text class="transfer-sheet__step-no">1</text><text>光标放在输入框</text></view>
        <view class="transfer-sheet__step-line"></view>
        <view class="transfer-sheet__step"><text class="transfer-sheet__step-no">2</text><text>双手离开设备</text></view>
        <view class="transfer-sheet__step-line"></view>
        <view class="transfer-sheet__step"><text class="transfer-sheet__step-no">3</text><text>等待发送完成</text></view>
      </view>

      <view class="transfer-sheet__actions">
        <view class="transfer-sheet__primary" bindtap="onPauseSendTap" hover-class="transfer-sheet__primary--hover">
          <t-icon name="{{sendPaused ? 'play' : 'pause'}}" size="32rpx" color="#FFFFFF" />
          <text>{{sendPaused ? '继续发送' : '暂停发送'}}</text>
        </view>
        <view class="transfer-sheet__danger" bindtap="onTransferCancelTap" hover-class="transfer-sheet__danger--hover"><text>停止发送</text></view>
      </view>
    </view>
  </view>

  <!-- ============ Transfer mode inline row ============ -->
  <view class="mode-row" wx:if="{{speedModeText}}" bindtap="goTransferSettings" hover-class="mode-row--hover">
    <t-icon name="thunder" size="28rpx" color="#6F3DFF" />
    <text class="mode-row__text">{{speedModeText}}</text>
    <t-icon name="chevron-right" size="28rpx" color="#64739A" />
  </view>

  <!-- ============ Quick access (无外层卡片，4 等宽) ============ -->
  <view class="quick-grid">
    <view class="quick-item" bindtap="goHistory" hover-class="quick-item--hover">
      <view class="quick-icon">
        <t-icon name="time" size="40rpx" color="#6F3DFF" />
      </view>
      <text class="quick-label">历史</text>
    </view>
    <view class="quick-item" bindtap="goPhrases" hover-class="quick-item--hover">
      <view class="quick-icon">
        <t-icon name="star" size="40rpx" color="#6F3DFF" />
      </view>
      <text class="quick-label">短语</text>
    </view>
    <view class="quick-item" bindtap="goSnippets" hover-class="quick-item--hover">
      <view class="quick-icon">
        <t-icon name="folder" size="40rpx" color="#6F3DFF" />
      </view>
      <text class="quick-label">片段</text>
    </view>
    <view class="quick-item" bindtap="onConnectTap" hover-class="quick-item--hover">
      <view class="quick-icon">
        <t-icon name="bluetooth" size="40rpx" color="#6F3DFF" />
        <view class="quick-badge" wx:if="{{connected}}"></view>
      </view>
      <text class="quick-label">设备</text>
    </view>
  </view>

  <!-- ============ AI 工具 bento (左 44% 右 56%) ============ -->
  <view class="ai-section">
    <text class="ai-section__title">AI 工具</text>

    <view class="ai-bento">
      <!-- LEFT: big card 智能整理 -->
      <view class="ai-main" bindtap="goAiText" hover-class="ai-main--hover">
        <view class="ai-main__icon">
          <t-icon name="robot" size="48rpx" color="#6F3DFF" />
        </view>
        <text class="ai-main__title">智能整理</text>
        <text class="ai-main__desc">AI 帮你重构文本结构，自动分段与润色</text>
        <view class="ai-main__cta">
          <text>立即使用</text>
          <t-icon name="chevron-right" size="22rpx" color="#6F3DFF" />
        </view>
      </view>

      <!-- RIGHT: 3 stacked small cards -->
      <view class="ai-side-col">
        <view class="ai-side" bindtap="goAiTemplate" hover-class="ai-side--hover">
          <view class="ai-side__icon">
            <t-icon name="catalog" size="32rpx" color="#6F3DFF" />
          </view>
          <view class="ai-side__body">
            <text class="ai-side__title">模板生成</text>
            <text class="ai-side__desc">按模板产出</text>
          </view>
          <t-icon name="chevron-right" size="24rpx" color="#64739A" />
        </view>

        <view class="ai-side" bindtap="goOcr" hover-class="ai-side--hover">
          <view class="ai-side__icon">
            <t-icon name="image" size="32rpx" color="#6F3DFF" />
          </view>
          <view class="ai-side__body">
            <text class="ai-side__title">图片识别</text>
            <text class="ai-side__desc">图片转文字</text>
          </view>
          <t-icon name="chevron-right" size="24rpx" color="#64739A" />
        </view>

        <view class="ai-side" bindtap="goAsr" hover-class="ai-side--hover">
          <view class="ai-side__icon">
            <t-icon name="sound" size="32rpx" color="#6F3DFF" />
          </view>
          <view class="ai-side__body">
            <text class="ai-side__title">语音转写</text>
            <text class="ai-side__desc">语音转文字</text>
          </view>
          <t-icon name="chevron-right" size="24rpx" color="#64739A" />
        </view>
      </view>
    </view>
  </view>

  <!-- ============ Pro upsell banner (浅紫克制版) ============ -->
  <view class="pro-banner" wx:if="{{!isMember}}" bindtap="goAiAssistant" hover-class="pro-banner--hover">
    <view class="pro-banner__icon">
      <t-icon name="star" size="36rpx" color="#6F3DFF" />
    </view>
    <view class="pro-banner__body">
      <text class="pro-banner__title">AI 助手 Pro</text>
      <text class="pro-banner__desc">解锁智能整理 · 模板 · 图片 · 语音</text>
    </view>
    <view class="pro-banner__cta">
      <text>立即升级</text>
      <t-icon name="chevron-right" size="24rpx" color="#6F3DFF" />
    </view>
  </view>

  <view class="guide-modal" wx:if="{{showGuidePoster}}" catchtap="closeGuidePoster">
    <view class="guide-poster" catchtap="stopGuidePoster">
      <view class="guide-poster__close" bindtap="closeGuidePoster"><t-icon name="close" size="32rpx" color="#6B7288" /></view>
      <view class="guide-poster__hero">
        <text class="guide-poster__eyebrow">XIAOKE TYPING APE</text>
        <text class="guide-poster__title">小科打字猿</text>
        <text class="guide-poster__title guide-poster__title--accent">使用指南</text>
        <image class="guide-poster__art" src="/assets/guide/hero-art.png" mode="aspectFit" />
      </view>
      <view class="guide-poster__body">
        <text>三步完成设置</text>
        <view><text>01 输入法</text><text>02 连接设备</text><text>03 开始输入</text></view>
        <text class="guide-poster__wish">♥ 主任，记得早点下班 ♥</text>
        <view class="guide-poster__button" bindtap="openGuideH5"><text>查看完整指南</text><t-icon name="chevron-right" size="30rpx" color="#FFFFFF" /></view>
      </view>
    </view>
  </view>
</view>
