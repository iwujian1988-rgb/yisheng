<view class="page-home">

  <!-- ============ Status bar spacer (custom 导航避让状态栏 + 胶囊) ============ -->
  <view class="status-bar-spacer"></view>

  <!-- ============ Top header: logo + brand + settings ============ -->
  <view class="top-header">
    <view class="brand">
      <view class="brand__logo">
        <t-icon name="bluetooth" size="36rpx" color="#FFFFFF" />
      </view>
      <text class="brand__name">小科打字猿</text>
    </view>
    <view class="icon-btn" bindtap="onConnectTap" hover-class="icon-btn--hover">
      <t-icon name="setting" size="36rpx" color="#101936" />
    </view>
  </view>

  <!-- ============ Connection capsule ============ -->
  <view class="conn-capsule" bindtap="onConnectTap" hover-class="conn-capsule--hover">
    <view class="conn-dot {{connected ? 'is-on' : ''}}"></view>
    <text class="conn-text">
      {{connected ? '已连接｜蓝牙设备已就绪' : (statusTitle || '未连接｜点击连接设备')}}
    </text>
    <t-icon name="chevron-right" size="32rpx" color="#64739A" />
  </view>

  <!-- ============ Composer (无外层卡片，标题在输入框外) ============ -->
  <view class="composer">
    <view class="composer__head">
      <text class="composer__title">发送内容</text>
      <text class="composer__subtitle">输入或粘贴要发送到电脑的文字</text>
    </view>

    <view class="composer__field">
      <t-textarea
        class="composer__textarea"
        placeholder="输入或粘贴要发送的内容..."
        value="{{inputText}}"
        maxlength="5000"
        autosize="{{ {minHeight: 160, maxHeight: 160} }}"
        disable-default-padding
        bind:change="onTextInput"
        t-class="composer__textarea-inner"
      />

      <view class="composer__bar">
        <text class="composer__count">{{inputText.length || 0}}/5000</text>
        <view class="composer__bar-right">
          <view class="composer__cancel" wx:if="{{sending}}" bindtap="onCancelSendTap">取消</view>
          <view
            class="composer__send {{(!canSend || sending || !connected) ? 'is-disabled' : ''}}"
            bindtap="onSendTap"
          >
            <text wx:if="{{sending}}">发送中 {{sendProgress}}%</text>
            <text wx:elif="{{!connected}}">未连接</text>
            <text wx:else>发送</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ============ Transfer mode inline row ============ -->
  <view class="mode-row" wx:if="{{speedModeText}}" bindtap="goTransferSettings" hover-class="mode-row--hover">
    <t-icon name="thunder" size="28rpx" color="#6F3DFF" />
    <text class="mode-row__text">{{speedModeText}}</text>
    <t-icon name="chevron-right" size="28rpx" color="#64739A" />
  </view>

  <!-- ============ Quick access (无外层卡片，4 等宽) ============ -->
  <view class="quick-grid">
    <view class="quick-item" bindtap="goHistory" hover-class="quick-item--hover">
      <view class="quick-icon">
        <t-icon name="time" size="40rpx" color="#6F3DFF" />
      </view>
      <text class="quick-label">历史</text>
    </view>
    <view class="quick-item" bindtap="goPhrases" hover-class="quick-item--hover">
      <view class="quick-icon">
        <t-icon name="star" size="40rpx" color="#6F3DFF" />
      </view>
      <text class="quick-label">短语</text>
    </view>
    <view class="quick-item" bindtap="goSnippets" hover-class="quick-item--hover">
      <view class="quick-icon">
        <t-icon name="folder" size="40rpx" color="#6F3DFF" />
      </view>
      <text class="quick-label">片段</text>
    </view>
    <view class="quick-item" bindtap="onConnectTap" hover-class="quick-item--hover">
      <view class="quick-icon">
        <t-icon name="bluetooth" size="40rpx" color="#6F3DFF" />
        <view class="quick-badge" wx:if="{{connected}}"></view>
      </view>
      <text class="quick-label">设备</text>
    </view>
  </view>

  <!-- ============ AI 工具 bento (左 44% 右 56%) ============ -->
  <view class="ai-section">
    <text class="ai-section__title">AI 工具</text>

    <view class="ai-bento">
      <!-- LEFT: big card 智能整理 -->
      <view class="ai-main" bindtap="goAiText" hover-class="ai-main--hover">
        <view class="ai-main__icon">
          <t-icon name="robot" size="48rpx" color="#6F3DFF" />
        </view>
        <text class="ai-main__title">智能整理</text>
        <text class="ai-main__desc">AI 帮你重构文本结构，自动分段与润色</text>
        <view class="ai-main__cta">
          <text>立即使用</text>
          <t-icon name="chevron-right" size="22rpx" color="#6F3DFF" />
        </view>
      </view>

      <!-- RIGHT: 3 stacked small cards -->
      <view class="ai-side-col">
        <view class="ai-side" bindtap="goAiTemplate" hover-class="ai-side--hover">
          <view class="ai-side__icon">
            <t-icon name="catalog" size="32rpx" color="#6F3DFF" />
          </view>
          <view class="ai-side__body">
            <text class="ai-side__title">模板生成</text>
            <text class="ai-side__desc">按模板产出</text>
          </view>
          <t-icon name="chevron-right" size="24rpx" color="#64739A" />
        </view>

        <view class="ai-side" bindtap="goOcr" hover-class="ai-side--hover">
          <view class="ai-side__icon">
            <t-icon name="image" size="32rpx" color="#6F3DFF" />
          </view>
          <view class="ai-side__body">
            <text class="ai-side__title">图片识别</text>
            <text class="ai-side__desc">图片转文字</text>
          </view>
          <t-icon name="chevron-right" size="24rpx" color="#64739A" />
        </view>

        <view class="ai-side" bindtap="goAsr" hover-class="ai-side--hover">
          <view class="ai-side__icon">
            <t-icon name="sound" size="32rpx" color="#6F3DFF" />
          </view>
          <view class="ai-side__body">
            <text class="ai-side__title">语音转写</text>
            <text class="ai-side__desc">语音转文字</text>
          </view>
          <t-icon name="chevron-right" size="24rpx" color="#64739A" />
        </view>
      </view>
    </view>
  </view>

  <!-- ============ Pro upsell banner (浅紫克制版) ============ -->
  <view class="pro-banner" wx:if="{{!isMember}}" bindtap="goAiAssistant" hover-class="pro-banner--hover">
    <view class="pro-banner__icon">
      <t-icon name="star" size="36rpx" color="#6F3DFF" />
    </view>
    <view class="pro-banner__body">
      <text class="pro-banner__title">AI 助手 Pro</text>
      <text class="pro-banner__desc">解锁智能整理 · 模板 · 图片 · 语音</text>
    </view>
    <view class="pro-banner__cta">
      <text>立即升级</text>
      <t-icon name="chevron-right" size="24rpx" color="#6F3DFF" />
    </view>
  </view>

</view>
