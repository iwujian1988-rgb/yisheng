.page-home {
  min-height: 100vh;
  padding-top: var(--td-spacer-2, 32rpx);
  padding-bottom: calc(var(--td-spacer-3, 48rpx) + var(--app-tab-bar-height, 100rpx));
  background-color: var(--td-bg-color-page, #f3f3f3);
  box-sizing: border-box;
}

.section-block {
  margin-bottom: var(--td-spacer-2, 32rpx);
}

.connect-guide {
  margin-left: var(--td-spacer-2, 32rpx);
  margin-right: var(--td-spacer-2, 32rpx);
  padding: var(--td-spacer-2, 32rpx);
  border-radius: var(--td-radius-large, 18rpx);
  background-color: var(--td-brand-color-light, #e6f4ff);
  box-sizing: border-box;
}

.connect-guide__head {
  display: flex;
  align-items: center;
  gap: var(--td-spacer, 16rpx);
  margin-bottom: var(--td-spacer, 16rpx);
}

.connect-guide__title {
  font: var(--td-font-title-small, 600 28rpx / 44rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
}

.connect-guide__desc {
  display: block;
  margin-bottom: var(--td-spacer-2, 32rpx);
  font: var(--td-font-body-medium, 28rpx / 44rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: var(--td-text-color-secondary, rgba(0, 0, 0, 0.6));
}

.connect-guide__btn {
  margin-top: 0;
}

.status-dot-wrap {
  display: flex;
  align-items: center;
  align-self: stretch;
  height: 100%;
  padding-right: 4rpx;
}

.device-status-left {
  display: flex;
  align-items: center;
  align-self: stretch;
}

.device-status-group {
  margin-bottom: var(--td-spacer-2, 32rpx) !important;
}

.status-dot {
  width: var(--td-spacer, 16rpx);
  height: var(--td-spacer, 16rpx);
  border-radius: var(--td-radius-circle, 50%);
  background-color: var(--td-gray-color-5, #c5c5c5);
  flex-shrink: 0;
}

.status-dot.connected {
  background-color: var(--td-success-color, #2ba471);
}

.composer-card {
  margin-left: var(--td-spacer-2, 32rpx);
  margin-right: var(--td-spacer-2, 32rpx);
  margin-top: 0;
  border-radius: var(--td-radius-large, 18rpx);
  background-color: var(--td-bg-color-container, #ffffff);
  padding: var(--td-spacer-2, 32rpx);
  box-sizing: border-box;
}

.composer-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--td-spacer, 16rpx);
}

.composer-title {
  font: var(--td-font-title-small, 600 28rpx / 44rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
}

.char-count {
  font: var(--td-font-body-small, 24rpx / 40rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
}

.composer-textarea {
  --td-textarea-padding: 0;
}

.composer-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: var(--td-spacer, 16rpx);
}

.composer-send {
  margin-top: var(--td-spacer-2, 32rpx);
  display: flex;
  flex-direction: column;
  gap: var(--td-spacer, 16rpx);
}

.composer-send-actions {
  display: flex;
  gap: var(--td-spacer, 16rpx);
}

.speed-mode-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  border-radius: var(--td-radius-default, 12rpx);
  background-color: var(--td-bg-color-secondarycontainer, #f3f3f3);
}

.speed-mode-hint__text {
  font: var(--td-font-body-small, 24rpx / 40rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: var(--td-text-color-secondary, rgba(0, 0, 0, 0.6));
}

.speed-mode-hint__link {
  font: var(--td-font-body-small, 24rpx / 40rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: var(--td-brand-color, #0052d9);
}

.cancel-send-btn {
  flex-shrink: 0;
  width: 150rpx !important;
}

.send-action-btn {
  flex: 1;
}

.section-label {
  margin: 0 var(--td-spacer-2, 32rpx) var(--td-spacer, 16rpx);
  font: var(--td-font-body-medium, 28rpx / 44rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
}

.tool-group {
  margin-bottom: var(--td-spacer, 16rpx);
}

.banner {
  margin-left: var(--td-spacer-2, 32rpx);
  margin-right: var(--td-spacer-2, 32rpx);
  border-radius: var(--td-radius-large, 18rpx);
  padding: var(--td-spacer-2, 32rpx);
  background-color: var(--td-bg-color-container, #ffffff);
  border: 1rpx solid var(--td-component-stroke, #e7e7e7);
  display: flex;
  align-items: center;
  gap: var(--td-spacer, 16rpx);
  box-sizing: border-box;
}

.banner-icon {
  flex-shrink: 0;
}

.banner-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.banner-title {
  font: var(--td-font-body-medium, 28rpx / 44rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
}

.banner-subtitle {
  font: var(--td-font-body-small, 24rpx / 40rpx PingFang SC, Microsoft YaHei, Arial Regular);
  color: var(--td-text-color-secondary, rgba(0, 0, 0, 0.6));
}

.tool-grid {
  margin-left: var(--td-spacer-2, 32rpx);
  margin-right: var(--td-spacer-2, 32rpx);
  background-color: var(--td-bg-color-container, #ffffff);
  border-radius: var(--td-radius-large, 18rpx);
  padding: var(--td-spacer-2, 32rpx) var(--td-spacer, 16rpx);
  display: flex;
  flex-wrap: wrap;
  box-sizing: border-box;
}

.tool-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--td-spacer, 16rpx) 0;
  box-sizing: border-box;
}

.tool-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-bottom: 12rpx;
}

.icon-history { background: #e6f4ff; }
.icon-phrases { background: #fff7e6; }
.icon-snippets { background: #f9f0ff; }
.icon-device { background: #e6fffb; }

.tool-title {
  font-size: 24rpx;
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
}

.ai-grid {
  margin-left: var(--td-spacer-2, 32rpx);
  margin-right: var(--td-spacer-2, 32rpx);
  background-color: var(--td-bg-color-container, #ffffff);
  border-radius: var(--td-radius-large, 18rpx);
  padding: var(--td-spacer, 16rpx) var(--td-spacer-2, 32rpx);
  box-sizing: border-box;
}

.ai-item {
  display: flex;
  align-items: center;
  padding: var(--td-spacer-2, 24rpx) 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.ai-item:last-child {
  border-bottom: none;
}

.ai-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--td-radius-default, 12rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: var(--td-spacer-2, 24rpx);
  background: #e6f4ff;
  flex-shrink: 0;
}

.icon-text { background: #e6f4ff; }
.icon-template { background: #f9f0ff; }
.icon-ocr { background: #fff7e6; }
.icon-asr { background: #e6fffb; }

.ai-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.ai-title {
  font-size: 28rpx;
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
}

.ai-desc {
  font-size: 22rpx;
  color: var(--td-text-color-secondary, rgba(0, 0, 0, 0.6));
}

.ai-upgrade-card {
  margin-left: var(--td-spacer-2, 32rpx);
  margin-right: var(--td-spacer-2, 32rpx);
  background: linear-gradient(135deg, #f0f5ff 0%, #e6f4ff 100%);
  border-radius: var(--td-radius-large, 18rpx);
  padding: var(--td-spacer-2, 32rpx);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.upgrade-icon {
  font-size: 56rpx;
  margin-right: var(--td-spacer-2, 24rpx);
}

.upgrade-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.upgrade-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1677ff;
}

.upgrade-desc {
  font-size: 24rpx;
  color: #666;
}
