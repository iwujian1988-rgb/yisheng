/* === 高保真首页样式 v2
   - 严格配色：#6F3DFF / #F2EDFF / #101936 / #64739A / #18D28B
   - 无橙黄粉蓝，无外层卡片堆叠，无装饰占位
   - 左右 32rpx，间距 8rpx 倍数
============================================================ */

.page-home {
  min-height: 100vh;
  padding: 0 32rpx calc(48rpx + var(--app-tab-bar-height, 100rpx));
  background: #FCFBFF;
  box-sizing: border-box;
  color: #101936;

  /* Brand tokens（受限色板） */
  --brand: #6F3DFF;
  --brand-deep: #4A2BB8;
  --brand-soft: #F2EDFF;
  --brand-soft-2: #F4EEFF;
  --brand-soft-3: #EDE5FF;
  --brand-border: rgba(111, 61, 255, 0.12);
  --brand-border-strong: rgba(111, 61, 255, 0.20);

  --fg: #101936;
  --muted: #64739A;

  --success: #18D28B;
  --success-soft: rgba(24, 210, 139, 0.14);

  --surface: #FFFFFF;
  --hairline: rgba(16, 25, 54, 0.06);

  --radius-sm: 12rpx;
  --radius: 20rpx;
  --radius-md: 24rpx;
  --radius-lg: 28rpx;
  --radius-pill: 999rpx;

  /* TDesign 跟随主色 */
  --td-brand-color: var(--brand);
  --td-brand-color-active: var(--brand-deep);
  --td-brand-color-light: var(--brand-soft);
  --td-brand-color-focus: var(--brand-border);
  --td-brand-color-disabled: #C9BCF0;
  --td-success-color: var(--success);
}

/* 全局字体只作用在 text 标签，避免被 t-icon 继承 */
.page-home text {
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'PingFang SC', system-ui, sans-serif;
  letter-spacing: -0.1rpx;
}

/* 防御性兜底 */
.page-home .t-icon {
  font-family: t !important;
  letter-spacing: 0 !important;
}

/* === Custom 导航下的状态栏占位 === */
.status-bar-spacer {
  width: 100%;
  /* 等同于 iOS 标准状态栏 44pt = 88rpx，避开刘海 + 与原生胶囊底部对齐 */
  height: 88rpx;
}

/* === Top header === */
.top-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  margin-bottom: 24rpx;
}

.brand {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
}

.brand__logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 24rpx;
  background: #6F3DFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand__name {
  font-size: 40rpx;
  font-weight: 800;
  color: #101936;
  letter-spacing: -0.5rpx;
  line-height: 1;
}

.brand__greeting {
  color: #101936;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
  line-height: 1.05;
}

.brand__greeting-note {
  color: #64739A;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1;
}

.icon-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--brand-border);
  box-sizing: border-box;
}

.icon-btn--hover {
  background: var(--brand-soft);
}

/* === Connection capsule === */
.conn-capsule {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 24rpx;
  background: #FFFFFF;
  border-radius: var(--radius-pill);
  border: 2rpx solid var(--brand-border);
  margin-bottom: 32rpx;
  line-height: 1;
  box-sizing: border-box;
}

.conn-capsule--hover {
  background: var(--brand-soft);
}

.conn-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #C4CAD6;
  flex-shrink: 0;
}

.conn-dot.is-on {
  background: var(--success);
  box-shadow: 0 0 0 6rpx var(--success-soft);
}

.conn-text {
  flex: 1;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 500;
  color: #101936;
  line-height: 36rpx;
}

.conn-capsule .t-icon {
  line-height: 1;
}

.guide-modal { position: fixed; z-index: 1000; inset: 0; display: flex; align-items: center; justify-content: center; padding: 48rpx; background: rgba(16, 18, 39, .56); box-sizing: border-box; }
.guide-poster { position: relative; width: 100%; overflow: hidden; border-radius: 34rpx; background: #FFFFFF; box-shadow: 0 28rpx 80rpx rgba(8, 8, 28, .30); }
.guide-poster__close { position: absolute; z-index: 2; top: 18rpx; right: 18rpx; display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; border-radius: 50%; background: rgba(255,255,255,.78); }
.guide-poster__hero { position: relative; min-height: 330rpx; padding: 48rpx 42rpx; overflow: hidden; background: linear-gradient(135deg, #FFFFFF 6%, #EEE7FF 100%); }
.guide-poster__eyebrow { display: block; margin-bottom: 16rpx; color: #907BDD; font-size: 18rpx; font-weight: 700; letter-spacing: 3rpx; }
.guide-poster__title { position: relative; z-index: 1; display: block; color: #121B39; font-size: 48rpx; font-weight: 800; line-height: 1.18; }
.guide-poster__title--accent { color: #6F3DFF; }
.guide-poster__art { position: absolute; right: -4rpx; bottom: 0; width: 58%; height: 100%; }
.guide-poster__body { padding: 34rpx 42rpx 42rpx; }.guide-poster__body > text:first-child { display: block; color: #17203D; font-size: 32rpx; font-weight: 800; }.guide-poster__body > view:first-of-type { display: flex; justify-content: space-between; margin: 24rpx 0; color: #6653B9; font-size: 22rpx; }.guide-poster__wish { display: block; margin: 12rpx 0 30rpx; color: #64739A; font-size: 22rpx; text-align: center; }.guide-poster__button { display: flex; align-items: center; justify-content: center; gap: 8rpx; height: 86rpx; border-radius: 999rpx; background: linear-gradient(90deg, #6338F4, #8B5BFF); color: #FFFFFF; font-size: 28rpx; font-weight: 700; }

/* === Composer（无外层卡片） === */
.composer {
  margin-bottom: 16rpx;
}

.composer__head {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-bottom: 16rpx;
  padding: 0;
}

.composer__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #101936;
}

.composer__title-row { display: flex; align-items: center; justify-content: space-between; }
.composer__guide-link { color: #6F3DFF; font-size: 24rpx; font-weight: 600; }

.composer__subtitle {
  font-size: 22rpx;
  color: #64739A;
}

.composer__field {
  position: relative;
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  padding: 24rpx;
  border: 2rpx solid var(--brand-border);
  height: 280rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;

  --td-textarea-padding: 0;
  --td-textarea-border-color: transparent;
  --td-textarea-bg-color: transparent;
  --td-textarea-placeholder-color: #64739A;
  --td-textarea-text-color: #101936;
}

.composer__field .t-textarea,
.composer__field .t-textarea__wrapper {
  padding: 0 !important;
  background: transparent !important;
  border: none !important;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.composer__field .t-textarea__wrapper-inner,
.composer__field .composer__textarea-inner {
  padding: 0 !important;
  background: transparent !important;
  border: none !important;
  font-size: 28rpx;
  line-height: 1.55;
  color: #101936 !important;
  width: 100%;
  flex: 1;
  min-height: 160rpx;
}

.composer__field .t-textarea__placeholder {
  color: #64739A !important;
  font-size: 28rpx;
}

.composer__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.composer__count {
  font-size: 22rpx;
  color: #64739A;
  font-variant-numeric: tabular-nums;
}

.composer__bar-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.composer__tool {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #f5f6f8;
}

.fullscreen-composer {
  position: fixed;
  z-index: 1000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  padding: calc(env(safe-area-inset-top) + 32rpx) 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
  background: #fcfbff;
}
.fullscreen-composer__header { display: flex; align-items: flex-start; justify-content: space-between; padding-bottom: 28rpx; }
.fullscreen-composer__title { display: block; color: #101936; font-size: 40rpx; font-weight: 800; }
.fullscreen-composer__hint { display: block; margin-top: 10rpx; color: #64739a; font-size: 24rpx; }
.fullscreen-composer__editor { position: relative; flex: 1; min-height: 0; display: flex; flex-direction: column; padding: 28rpx; border: 2rpx solid var(--brand-border); border-radius: 28rpx; background: #fff; overflow: hidden; }
.fullscreen-composer__textarea-wrap { flex: 1; min-height: 0; }
.fullscreen-composer__textarea-wrap .t-textarea,
.fullscreen-composer__editor .t-textarea__wrapper { height: 100%; padding: 0 !important; background: transparent !important; border: 0 !important; }
.fullscreen-composer__textarea-wrap .t-textarea__wrapper-inner,
.fullscreen-composer__editor .fullscreen-composer__textarea-inner { min-height: 100% !important; padding: 0 !important; color: #101936 !important; font-size: 32rpx; line-height: 1.65; }
.fullscreen-composer__tools { position: absolute; right: 28rpx; bottom: 28rpx; left: 28rpx; display: flex; align-items: center; justify-content: space-between; pointer-events: none; }
.fullscreen-composer__count { color: #8b95aa; font-size: 24rpx; }
.fullscreen-composer__toolset { display: flex; align-items: center; gap: 14rpx; pointer-events: auto; }
.fullscreen-composer__tool { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; border-radius: 20rpx; background: #f5f6f8; }
.fullscreen-composer__tool--send { background: #eef0f4; }
.fullscreen-composer__tool--send.is-disabled { opacity: .42; }

/* === Sending task sheet === */
.transfer-modal {
  position: fixed;
  z-index: 1200;
  inset: 0;
  display: flex;
  align-items: flex-end;
  padding: 32rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(16, 25, 54, .54);
}

.transfer-sheet {
  width: 100%;
  padding: 32rpx;
  border: 2rpx solid rgba(111, 61, 255, .12);
  border-radius: 36rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  box-shadow: 0 28rpx 80rpx rgba(16, 25, 54, .24);
}

.transfer-sheet__topline,
.transfer-sheet__status,
.transfer-sheet__actions {
  display: flex;
  align-items: center;
}

.transfer-sheet__topline {
  justify-content: space-between;
}

.transfer-sheet__status {
  min-width: 0;
  gap: 16rpx;
}

.transfer-sheet__status-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: #6F3DFF;
}

.transfer-sheet__status-icon.is-paused {
  background: #F2EDFF;
}

.transfer-sheet__eyebrow,
.transfer-sheet__status-note,
.transfer-sheet__progress-caption,
.transfer-sheet__warning-title,
.transfer-sheet__warning-text {
  display: block;
}

.transfer-sheet__eyebrow {
  color: #101936;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.transfer-sheet__status-note {
  margin-top: 2rpx;
  color: #64739A;
  font-size: 22rpx;
  line-height: 30rpx;
}

.transfer-sheet__collapse {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  background: #F5F3FA;
  color: #64739A;
  font-size: 24rpx;
  font-weight: 600;
}

.transfer-sheet__collapse--hover {
  background: #F2EDFF;
  color: #6F3DFF;
}

.transfer-sheet__progress-head {
  display: flex;
  align-items: baseline;
  margin-top: 32rpx;
  color: #101936;
  line-height: 1;
}

.transfer-sheet__progress-value {
  font-size: 76rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  letter-spacing: -3rpx;
}

.transfer-sheet__progress-unit {
  margin-left: 6rpx;
  color: #6F3DFF;
  font-size: 34rpx;
  font-weight: 800;
}

.transfer-sheet__progress-track {
  width: 100%;
  height: 16rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #ECE8F7;
}

.transfer-sheet__progress-bar {
  min-width: 12rpx;
  height: 100%;
  border-radius: inherit;
  background: #6F3DFF;
  transition: width .18s ease;
}

.transfer-sheet__progress-bar.is-paused {
  background: #9B84DD;
}

.transfer-sheet__progress-caption {
  margin-top: 12rpx;
  color: #64739A;
  font-size: 22rpx;
}

.transfer-sheet__warning {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-top: 28rpx;
  padding: 24rpx;
  border: 2rpx solid rgba(225, 145, 29, .20);
  border-radius: 24rpx;
  background: #FFF8EA;
}

.transfer-sheet__warning-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #E1911D;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 800;
}

.transfer-sheet__warning-copy {
  flex: 1;
  min-width: 0;
}

.transfer-sheet__warning-title {
  color: #6F4812;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.transfer-sheet__warning-text {
  margin-top: 6rpx;
  color: #7A5C2A;
  font-size: 23rpx;
  line-height: 36rpx;
}

.transfer-sheet__steps {
  display: flex;
  align-items: flex-start;
  margin-top: 28rpx;
  padding: 0 4rpx;
}

.transfer-sheet__step {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  color: #64739A;
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: center;
}

.transfer-sheet__step-no {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #F2EDFF;
  color: #6F3DFF;
  font-size: 22rpx;
  font-weight: 800;
}

.transfer-sheet__step-line {
  width: 28rpx;
  height: 2rpx;
  margin-top: 20rpx;
  flex-shrink: 0;
  background: rgba(111, 61, 255, .16);
}

.transfer-sheet__actions {
  gap: 16rpx;
  margin-top: 32rpx;
}

.transfer-sheet__primary,
.transfer-sheet__danger {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  font-weight: 700;
}

.transfer-sheet__primary {
  flex: 1;
  gap: 10rpx;
  background: #6F3DFF;
  color: #FFFFFF;
}

.transfer-sheet__primary--hover {
  background: #4A2BB8;
}

.transfer-sheet__danger {
  width: 190rpx;
  border: 2rpx solid rgba(214, 69, 69, .18);
  background: #FFF5F5;
  color: #C43D3D;
}

.transfer-sheet__danger--hover {
  background: #FDEAEA;
}

@media (prefers-reduced-motion: reduce) {
  .transfer-sheet__progress-bar {
    transition: none;
  }
}

/* 发送按钮：禁用态尺寸不变 */
.composer__send {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 64rpx;
  background: #6F3DFF;
  color: #FFFFFF;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 0.3rpx;
}

.composer__send.is-disabled {
  background: #C9BCF0;
  color: #FFFFFF;
}

.composer__send--stop,
.fullscreen-composer__tool--stop {
  background: #EF5B66;
}

.composer__send text {
  color: #FFFFFF !important;
}

/* === Transfer mode inline row（无卡片） === */
.mode-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 0;
  margin-bottom: 24rpx;
}

.mode-row--hover {
  opacity: 0.6;
}

.mode-row__text {
  flex: 1;
  font-size: 24rpx;
  color: #6F3DFF;
  font-weight: 500;
}

/* === Quick access（无外层卡片，4 等宽） === */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  padding: 8rpx 0;
  margin-bottom: 32rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 4rpx;
  border-radius: var(--radius);
}

.quick-item--hover {
  background: var(--brand-soft);
}

.quick-icon {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius);
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ui-icon {
  display: block;
  flex-shrink: 0;
}

.ui-icon--quick {
  width: 40rpx;
  height: 40rpx;
}

.ui-icon--ai-main {
  width: 48rpx;
  height: 48rpx;
}

.ui-icon--ai-side {
  width: 32rpx;
  height: 32rpx;
}

.quick-badge {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--success);
  border: 3rpx solid #FFFFFF;
}

.quick-label {
  font-size: 22rpx;
  color: #101936;
  font-weight: 500;
}

/* === AI 工具 bento（左 44% 右 56%，严格对齐） === */
.ai-section {
  margin-bottom: 24rpx;
}

.ai-section__title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #101936;
  margin: 0 0 16rpx;
}

.ai-bento {
  display: grid;
  grid-template-columns: 44fr 56fr;
  gap: 16rpx;
  height: 440rpx;
}

.ai-main {
  position: relative;
  background: linear-gradient(160deg, #F4EEFF 0%, #EDE5FF 100%);
  border-radius: var(--radius-lg);
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  border: 2rpx solid var(--brand-border);
  overflow: hidden;
  box-sizing: border-box;
}

.ai-main--hover {
  opacity: 0.85;
}

.ai-main__icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius);
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  border: 2rpx solid var(--brand-border);
  box-sizing: border-box;
}

.ai-main__title {
  font-size: 34rpx;
  font-weight: 800;
  color: #101936;
  letter-spacing: -0.3rpx;
  margin-bottom: 8rpx;
}

.ai-main__desc {
  font-size: 22rpx;
  color: #64739A;
  line-height: 1.5;
  flex: 1;
}

.ai-main__cta {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 18rpx;
  background: #6F3DFF;
  color: #FFFFFF;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  font-weight: 600;
}

.ai-main__cta text {
  color: #FFFFFF !important;
}

/* 右侧 56% 三张卡片 */
.ai-side-col {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-height: 0;
}

.ai-side {
  flex: 1;
  background: #FFFFFF;
  border-radius: var(--radius);
  padding: 16rpx 18rpx;
  border: 2rpx solid var(--brand-border);
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(16, 25, 54, 0.04);
  min-height: 0;
  box-sizing: border-box;
}

.ai-side--hover {
  background: var(--brand-soft);
}

.ai-side__icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-sm);
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ai-side__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.ai-side__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #101936;
}

.ai-side__desc {
  font-size: 20rpx;
  color: #64739A;
}

/* === Pro upsell（浅紫克制版） === */
.pro-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 22rpx;
  background: #F2EDFF;
  border-radius: var(--radius-lg);
  border: 2rpx solid var(--brand-border);
  box-sizing: border-box;
}

.pro-banner--hover {
  background: var(--brand-soft-3);
}

.pro-banner__icon {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius);
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--brand-border);
  box-sizing: border-box;
}

.pro-banner__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.pro-banner__title {
  font-size: 26rpx;
  font-weight: 700;
  color: #101936;
}

.pro-banner__desc {
  font-size: 22rpx;
  color: #64739A;
  line-height: 1.4;
}

.pro-banner__cta {
  display: inline-flex;
  align-items: center;
  gap: 2rpx;
  padding: 8rpx 18rpx;
  background: #FFFFFF;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  font-weight: 700;
  color: #6F3DFF;
  flex-shrink: 0;
  border: 2rpx solid var(--brand-border);
  box-sizing: border-box;
}
