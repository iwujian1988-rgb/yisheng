/* pages/demo/scenario-select.wxss */
.scenario-container { min-height: 100vh; background-color: #FCFBFF; padding: 24rpx 32rpx; }
.section-title { padding: 32rpx 0; }
.section-text { font-size: 32rpx; color: #101936; font-weight: 500; }
.scenario-list { display: flex; flex-direction: column; gap: 24rpx; }
.scenario-card { background-color: #FFFFFF; border-radius: 20rpx; padding: 40rpx; display: flex; flex-direction: column;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}
.scenario-title { font-size: 30rpx; color: #101936; font-weight: 500; }
.scenario-desc { font-size: 26rpx; color: #98A1B8; margin-top: 12rpx; }
