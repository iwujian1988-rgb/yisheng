/* pages/demo/scenario-select.wxss */
.scenario-container { min-height: 100vh; background-color: #F5F7FA; padding: 16px 32px; }
.section-title { padding: 16px 0; }
.section-text { font-size: 16px; color: #333333; font-weight: 500; }
.scenario-list { display: flex; flex-direction: column; gap: 12px; }
.scenario-card { background-color: #FFFFFF; border-radius: 8px; padding: 20px; display: flex; flex-direction: column; }
.scenario-title { font-size: 15px; color: #333333; font-weight: 500; }
.scenario-desc { font-size: 13px; color: #999999; margin-top: 6px; }
