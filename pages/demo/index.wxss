/* pages/demo/index.wxss */
.demo-container { min-height: 100vh; background-color: #FCFBFF; padding: 24rpx 32rpx; }
.header-section { display: flex; flex-direction: column; align-items: center; padding: 64rpx 0 48rpx; }
.header-title { font-size: 40rpx; color: #101936; font-weight: 600; }
.header-desc { font-size: 26rpx; color: #98A1B8; margin-top: 16rpx; }
.card-list { display: flex; flex-direction: column; gap: 24rpx; }
.entry-card { background-color: #FFFFFF; border-radius: 20rpx; padding: 40rpx; display: flex; flex-direction: column;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}
.card-title { font-size: 32rpx; color: #101936; font-weight: 500; }
.card-desc { font-size: 26rpx; color: #98A1B8; margin-top: 12rpx; }
