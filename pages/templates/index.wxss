.templates-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding-bottom: var(--app-tab-bar-height, 100rpx);
  box-sizing: border-box;
}

.templates-container--with-footer {
  padding-bottom: calc(var(--app-tab-bar-height, 100rpx) + 140rpx);
}

.tab-bar {
  display: flex;
  margin: 24rpx 32rpx 8rpx;
  padding: 8rpx;
  background-color: #F2EDFF;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  border-radius: 999rpx;
  box-sizing: border-box;
}

.tab-item {
  flex: 1;
  display: flex;
  justify-content: center;
  padding: 18rpx 0;
  position: relative;
  border-radius: 999rpx;
}

.tab-text {
  font-size: 26rpx;
  color: #64739A;
}

.tab-active .tab-text {
  color: #6F3DFF;
  font-weight: 700;
}

.tab-active {
  background: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(61, 42, 140, 0.08);
}

.state-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 220rpx 64rpx 0;
}

.empty-icon {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background-color: #F2EDFF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-icon-text {
  font-size: 52rpx;
  color: #6F3DFF;
  font-weight: 700;
}

.state-title {
  font-size: 30rpx;
  color: #101936;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.state-desc {
  font-size: 24rpx;
  color: #64739A;
  line-height: 1.6;
  text-align: center;
}

.retry-btn {
  width: 240rpx;
  height: 76rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background-color: #6F3DFF;
  color: #FFFFFF;
  font-size: 26rpx;
}

.list-section {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.template-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-shadow: 0 4rpx 14rpx rgba(61, 42, 140, 0.04);
}

.template-main {
  flex: 1;
  min-width: 0;
}

.template-name {
  font-size: 28rpx;
  color: #101936;
  font-weight: 700;
  margin-bottom: 8rpx;
  display: block;
}

.template-desc {
  font-size: 23rpx;
  color: #64739A;
  line-height: 1.5;
  display: block;
}

.template-arrow {
  color: #9B8CC8;
  font-size: 32rpx;
  margin-left: 20rpx;
}

.create-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: var(--app-tab-bar-height, 100rpx);
  z-index: 20;
  padding: 20rpx 32rpx 28rpx;
  background-color: rgba(252, 251, 255, 0.96);
  box-sizing: border-box;
  border-top: 2rpx solid rgba(111, 61, 255, 0.10);
}

.create-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background-color: #6F3DFF;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
}
