<view class="result-container">
  <view class="result-section">
    <view class="section-header">
      <text class="result-label">生成结果</text>
      <text class="provider-tag" wx:if="{{provider}}">{{status === 'ai_generated' ? '智能生成' : '模板生成'}}</text>
    </view>
    <view class="result-box">
      <textarea
        class="result-textarea"
        value="{{bodyText}}"
        maxlength="-1"
        auto-height="{{true}}"
        bindinput="onBodyInput"
        placeholder="生成后的正文会显示在这里"
      />
    </view>
  </view>

  <view class="confirm-section" wx:if="{{confirmText}}">
    <text class="result-label">发送前确认</text>
    <view class="confirm-box">
      <text class="confirm-text">{{confirmText}}</text>
    </view>
  </view>

  <view class="action-section">
    <button class="btn btn-primary action-btn" bindtap="sendToComputer">
      发送到电脑
    </button>
    <button class="btn btn-outline action-btn" bindtap="copyResult">
      复制正文
    </button>
    <button class="btn btn-plain action-btn" bindtap="regenerate">
      返回修改
    </button>
  </view>
</view>
