<view class="result-container">
  <view class="result-section">
    <view class="section-header">
      <text class="result-label">可发送正文</text>
      <text class="provider-tag" wx:if="{{provider}}">{{provider}}</text>
    </view>
    <scroll-view class="result-box" scroll-y>
      <text class="result-text" wx:if="{{bodyText}}">{{bodyText}}</text>
      <text class="result-empty" wx:else>等待生成...</text>
    </scroll-view>
  </view>

  <view class="confirm-section" wx:if="{{confirmText}}">
    <text class="result-label">待确认项</text>
    <view class="confirm-box">
      <text class="confirm-text">{{confirmText}}</text>
    </view>
  </view>

  <view class="action-section">
    <button class="btn btn-primary action-btn" bindtap="sendToComputer">
      发送到电脑
    </button>
    <button class="btn btn-outline action-btn" bindtap="copyResult">
      复制正文
    </button>
    <button class="btn btn-plain action-btn" bindtap="regenerate">
      返回编辑
    </button>
  </view>
</view>
