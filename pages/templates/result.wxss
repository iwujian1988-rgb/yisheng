.result-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px 32px;
  display: flex;
  flex-direction: column;
}

.result-section {
  margin-bottom: 16px;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.result-label {
  font-size: 14px;
  color: #333333;
  font-weight: 600;
  display: block;
  margin-bottom: 8px;
}

.provider-tag {
  font-size: 11px;
  color: #4A90E2;
  background-color: #E8F2FC;
  border-radius: 10px;
  padding: 2px 8px;
}

.result-box {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 18px;
  height: 280px;
  border: 1px solid #E5E5E5;
  box-sizing: border-box;
}

.result-text {
  font-size: 15px;
  color: #333333;
  line-height: 1.8;
  white-space: pre-wrap;
}

.result-empty {
  font-size: 14px;
  color: #999999;
}

.confirm-section {
  margin-bottom: 20px;
}

.confirm-box {
  background-color: #FFF8E6;
  border: 1px solid #FFE0A3;
  border-radius: 8px;
  padding: 14px 16px;
}

.confirm-text {
  font-size: 14px;
  color: #8A5A00;
  line-height: 1.7;
  white-space: pre-wrap;
}

.action-section {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding-bottom: 20px;
}

.action-btn {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 600;
}

.btn-primary {
  background-color: #4A90E2;
  color: #FFFFFF;
}

.btn-outline {
  background-color: #FFFFFF;
  color: #4A90E2;
  border: 1px solid #4A90E2;
}

.btn-plain {
  background-color: transparent;
  color: #666666;
}
