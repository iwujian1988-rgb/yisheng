.result-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 24rpx 32rpx 48rpx;
  display: flex;
  flex-direction: column;
}

.result-section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.result-label {
  font-size: 28rpx;
  color: #101936;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}

.provider-tag {
  font-size: 22rpx;
  color: #6F3DFF;
  background-color: #F2EDFF;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.result-box {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  min-height: 560rpx;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-shadow: 0 4rpx 16rpx rgba(61, 42, 140, 0.04);
  box-sizing: border-box;
}

.result-textarea {
  width: 100%;
  min-height: 520rpx;
  font-size: 28rpx;
  color: #101936;
  line-height: 1.8;
  box-sizing: border-box;
}

.result-empty {
  font-size: 26rpx;
  color: #98A1B8;
}

.confirm-section {
  margin-bottom: 28rpx;
}

.confirm-box {
  background-color: #FFF8E6;
  border: 2rpx solid #FFE0A3;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.confirm-text {
  font-size: 26rpx;
  color: #8A5A00;
  line-height: 1.7;
  white-space: pre-wrap;
}

.action-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-bottom: 32rpx;
}

.action-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.btn-primary {
  background-color: #6F3DFF;
  color: #FFFFFF;
}

.btn-outline {
  background-color: #FFFFFF;
  color: #6F3DFF;
  border: 2rpx solid rgba(111, 61, 255, 0.24);
}

.btn-plain {
  background-color: transparent;
  color: #64739A;
}
