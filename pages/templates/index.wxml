<view class="templates-container {{activeTab === 'custom' ? 'templates-container--with-footer' : ''}}">
  <view class="tab-bar">
    <view
      class="tab-item {{activeTab === item.key ? 'tab-active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      bindtap="switchTab"
      data-key="{{item.key}}"
    >
      <text class="tab-text">{{item.name}}</text>
    </view>
  </view>

  <view class="state-section" wx:if="{{isLoading}}">
    <text class="state-title">正在加载模板</text>
  </view>

  <view class="state-section" wx:elif="{{loadError}}">
    <text class="state-title">{{loadError}}</text>
    <button class="retry-btn" bindtap="loadTemplates">重试</button>
  </view>

  <view class="state-section" wx:elif="{{filteredTemplates.length === 0}}">
    <view class="empty-icon">
      <text class="empty-icon-text">T</text>
    </view>
    <text class="state-title">暂无可用模板</text>
    <text class="state-desc">请确认已开通会员；专业模板在连接设备后可见。可先添加自有模板。</text>
  </view>

  <view class="list-section" wx:else>
    <view
      class="template-card"
      wx:for="{{filteredTemplates}}"
      wx:key="id"
      bindtap="openTemplate"
      data-id="{{item.id}}"
    >
      <view class="template-main">
        <text class="template-name">{{item.name}}</text>
        <text class="template-desc">{{item.templateType || item.template_type || '模板'}} · {{item.tag === 'official' ? '官方' : '自有'}}</text>
      </view>
      <text class="template-arrow">›</text>
    </view>
  </view>

  <view class="create-bar" wx:if="{{activeTab === 'custom'}}">
    <button class="create-btn" bindtap="goCreate">添加模板</button>
  </view>
</view>
