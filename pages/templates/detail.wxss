.detail-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 24rpx 32rpx 64rpx;
  box-sizing: border-box;
}

.header-section {
  margin-bottom: 40rpx;
}

.template-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #101936;
  margin-bottom: 12rpx;
  display: block;
}

.template-desc {
  font-size: 26rpx;
  color: #64739A;
  line-height: 1.6;
  display: block;
}

.fields-section {
  margin-bottom: 40rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #101936;
  margin-bottom: 20rpx;
  display: block;
}

.field-item {
  margin-bottom: 28rpx;
}

.field-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.field-label {
  font-size: 26rpx;
  color: #101936;
  font-weight: 600;
}

.required-mark {
  font-size: 22rpx;
  color: #6F3DFF;
  background-color: #F2EDFF;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.field-input {
  width: 100%;
  height: 96rpx;
  padding: 0 24rpx;
  background-color: #FFFFFF;
  border: 2rpx solid rgba(111, 61, 255, 0.14);
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #101936;
  box-sizing: border-box;
}

.field-textarea {
  width: 100%;
  height: 224rpx;
  padding: 22rpx 24rpx;
  background-color: #FFFFFF;
  border: 2rpx solid rgba(111, 61, 255, 0.14);
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #101936;
  box-sizing: border-box;
  line-height: 1.6;
}

.input-placeholder,
.empty-text {
  color: #98A1B8;
}

.empty-section {
  padding: 96rpx 0;
  text-align: center;
}

.field-desc {
  display: block;
  font-size: 24rpx;
  color: #64739A;
  margin-top: 8rpx;
}

.sample-preview {
  display: block;
  font-size: 26rpx;
  color: #101936;
  line-height: 1.6;
  white-space: pre-wrap;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  border: 2rpx solid rgba(111, 61, 255, 0.10);
}

.generate-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.btn-primary {
  background-color: #6F3DFF;
  color: #FFFFFF;
}

.btn-primary:active {
  opacity: 0.8;
}

.disabled {
  background-color: #CCCCCC;
  color: #FFFFFF;
}
