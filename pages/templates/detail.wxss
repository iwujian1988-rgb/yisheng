.detail-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px 48px;
}

.header-section {
  margin-bottom: 28px;
}

.template-title {
  font-size: 20px;
  font-weight: 700;
  color: #333333;
  margin-bottom: 6px;
  display: block;
}

.template-desc {
  font-size: 14px;
  color: #666666;
  line-height: 1.6;
  display: block;
}

.fields-section {
  margin-bottom: 28px;
}

.section-label {
  font-size: 15px;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12px;
  display: block;
}

.field-item {
  margin-bottom: 20px;
}

.field-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.field-label {
  font-size: 14px;
  color: #333333;
  font-weight: 600;
}

.required-mark {
  font-size: 12px;
  color: #4A90E2;
  background-color: #E8F2FC;
  padding: 2px 8px;
  border-radius: 10px;
}

.field-input {
  width: 100%;
  height: 48px;
  padding: 0 16px;
  background-color: #FFFFFF;
  border: 1px solid #E5E5E5;
  border-radius: 8px;
  font-size: 15px;
  color: #333333;
  box-sizing: border-box;
}

.field-textarea {
  width: 100%;
  height: 112px;
  padding: 14px 16px;
  background-color: #FFFFFF;
  border: 1px solid #E5E5E5;
  border-radius: 8px;
  font-size: 15px;
  color: #333333;
  box-sizing: border-box;
  line-height: 1.6;
}

.input-placeholder,
.empty-text {
  color: #999999;
}

.empty-section {
  padding: 48px 0;
  text-align: center;
}

.field-desc {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
}

.sample-preview {
  display: block;
  font-size: 26rpx;
  color: #444;
  line-height: 1.6;
  white-space: pre-wrap;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
}

.generate-btn {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 600;
}

.btn-primary {
  background-color: #4A90E2;
  color: #FFFFFF;
}

.btn-primary:active {
  opacity: 0.8;
}

.disabled {
  background-color: #CCCCCC;
  color: #FFFFFF;
}
