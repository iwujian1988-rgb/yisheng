<!--pages/training/feedback.wxml-->
<view class="feedback-container">
  <view class="form-section">
    <view class="form-title"><text class="form-title-text">培训反馈</text></view>
    <view class="form-group">
      <text class="form-label">课程评分</text>
      <view class="rating-bar">
        <view class="rating-item {{rating>=1?'rating-active':''}}" bindtap="setRating" data-val="1"><text class="rating-text">1</text></view>
        <view class="rating-item {{rating>=2?'rating-active':''}}" bindtap="setRating" data-val="2"><text class="rating-text">2</text></view>
        <view class="rating-item {{rating>=3?'rating-active':''}}" bindtap="setRating" data-val="3"><text class="rating-text">3</text></view>
        <view class="rating-item {{rating>=4?'rating-active':''}}" bindtap="setRating" data-val="4"><text class="rating-text">4</text></view>
        <view class="rating-item {{rating>=5?'rating-active':''}}" bindtap="setRating" data-val="5"><text class="rating-text">5</text></view>
      </view>
    </view>
    <view class="form-group">
      <text class="form-label">反馈内容</text>
      <textarea class="form-textarea" placeholder="请输入您的反馈" value="{{content}}" bindinput="onContentInput" maxlength="500" />
    </view>
  </view>
  <view class="bottom-actions">
    <view class="btn-primary" bindtap="submitFeedback"><text class="btn-text">提交反馈</text></view>
  </view>
</view>
