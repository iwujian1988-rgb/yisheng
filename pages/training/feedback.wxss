/* pages/training/feedback.wxss */
.feedback-container { min-height: 100vh; background-color: #FCFBFF; padding: 24rpx 32rpx; display: flex; flex-direction: column; }
.form-section { background-color: #FFFFFF; border-radius: 20rpx; padding: 40rpx; }
.form-title { margin-bottom: 32rpx; }
.form-title-text { font-size: 32rpx; color: #101936; font-weight: 500; }
.form-group { display: flex; flex-direction: column; margin-bottom: 32rpx; }
.form-group:last-child { margin-bottom: 0; }
.form-label { font-size: 28rpx; color: #64739A; margin-bottom: 16rpx; }
.rating-bar { display: flex; gap: 20rpx; }
.rating-item { width: 80rpx; height: 80rpx; border-radius: 50%; background-color: rgba(111, 61, 255, 0.08); display: flex; align-items: center; justify-content: center; }
.rating-active { background-color: #6F3DFF; }
.rating-text { font-size: 32rpx; color: #FFFFFF; }
.rating-item:not(.rating-active) .rating-text { color: #98A1B8; }
.form-textarea { border: 2rpx solid #E0E0E0; border-radius: 20rpx; padding: 20rpx 24rpx; font-size: 28rpx; color: #101936; height: 240rpx; }
.bottom-actions { margin-top: auto; padding: 48rpx 0; }
.btn-primary { background-color: #6F3DFF; border-radius: 999rpx; padding: 28rpx 0; text-align: center; }
.btn-text { font-size: 32rpx; color: #FFFFFF; }
