/* pages/training/detail.wxss */
.detail-container { min-height: 100vh; background-color: #FCFBFF; padding: 24rpx 32rpx; display: flex; flex-direction: column; }
.info-card { background-color: #FFFFFF; border-radius: 20rpx; padding: 40rpx; display: flex; flex-direction: column;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}
.info-title { font-size: 36rpx; color: #101936; font-weight: 600; }
.info-desc { font-size: 28rpx; color: #98A1B8; margin-top: 16rpx; }
.section-title { padding: 40rpx 0 20rpx; }
.section-text { font-size: 32rpx; color: #101936; font-weight: 500; }
.content-card { background-color: #FFFFFF; border-radius: 20rpx; padding: 40rpx;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}
.content-text { font-size: 28rpx; color: #64739A; line-height: 1.8; }
.bottom-actions { margin-top: auto; padding: 48rpx 0; }
.btn-primary { background-color: #6F3DFF; border-radius: 999rpx; padding: 28rpx 0; text-align: center; }
.btn-text { font-size: 32rpx; color: #FFFFFF; }
