/* pages/dev/index.wxss */
.dev-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 24rpx 32rpx;
}

.warning-card {
  background-color: rgba(250, 173, 20, 0.1);
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 48rpx;
}

.warning-text {
  font-size: 26rpx;
  color: #FAAD14;
  line-height: 1.6;
}

.tool-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 0 40rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.tool-title {
  font-size: 28rpx;
  color: #98A1B8;
  padding: 28rpx 0;
  display: block;
}

.tool-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
}

.tool-label {
  font-size: 30rpx;
  color: #101936;
}

.danger {
  color: #F5222D;
}

.tool-arrow {
  font-size: 24rpx;
  color: #CCCCCC;
}

.tool-divider {
  height: 2rpx;
  background-color: rgba(111, 61, 255, 0.08);
}
