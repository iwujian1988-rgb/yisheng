/* pages/customer/success-dashboard.wxss */
.dashboard-container { min-height: 100vh; background-color: #FCFBFF; padding: 24rpx 32rpx; }
.stats-grid { display: flex; flex-wrap: wrap; gap: 24rpx; }
.stat-card { width: calc(50% - 12rpx); background-color: #FFFFFF; border-radius: 20rpx; padding: 48rpx 40rpx; text-align: center; box-sizing: border-box;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}
.stat-num { font-size: 56rpx; font-weight: 600; color: #101936; display: block; }
.stat-label { font-size: 26rpx; color: #98A1B8; margin-top: 12rpx; display: block; }
