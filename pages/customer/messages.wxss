/* pages/customer/messages.wxss */
.messages-container { min-height: 100vh; background-color: #F5F7FA; padding: 16px 32px; }
.empty-section { display: flex; justify-content: center; padding-top: 120px; }
.empty-text { font-size: 14px; color: #999999; }
.message-list { display: flex; flex-direction: column; gap: 10px; }
.message-card { background-color: #FFFFFF; border-radius: 8px; padding: 16px 20px; display: flex; flex-direction: column; }
.msg-header { display: flex; justify-content: space-between; align-items: center; }
.msg-title { font-size: 15px; color: #333333; font-weight: 500; }
.msg-time { font-size: 12px; color: #CCCCCC; }
.msg-preview { font-size: 13px; color: #999999; margin-top: 8px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
