<!--pages/customer/success-dashboard.wxml-->
<view class="dashboard-container">
  <view class="stats-grid">
    <view class="stat-card"><text class="stat-num">{{toOpen}}</text><text class="stat-label">待开通</text></view>
    <view class="stat-card"><text class="stat-num">{{toBind}}</text><text class="stat-label">待绑定</text></view>
    <view class="stat-card"><text class="stat-num">{{toTrain}}</text><text class="stat-label">待培训</text></view>
    <view class="stat-card"><text class="stat-num">{{toFollow}}</text><text class="stat-label">待回访</text></view>
  </view>
</view>
