/* pages/customer/device-alert.wxss */
.alert-container { min-height: 100vh; background-color: #F5F7FA; padding: 16px 32px; display: flex; flex-direction: column; }
.alert-card { background-color: #FFEBEE; border-radius: 8px; padding: 20px; display: flex; flex-direction: column; }
.alert-title { font-size: 16px; color: #C62828; font-weight: 500; }
.alert-desc { font-size: 13px; color: #B71C1C; margin-top: 8px; }
.info-section { background-color: #FFFFFF; border-radius: 8px; padding: 20px; margin-top: 16px; }
.info-row { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid #F0F0F0; }
.info-row:last-child { border-bottom: none; }
.info-label { font-size: 14px; color: #999999; }
.info-value { font-size: 14px; color: #333333; }
.bottom-actions { margin-top: auto; padding: 24px 0; }
.btn-primary { background-color: #4A90E2; border-radius: 12px; padding: 14px 0; text-align: center; }
.btn-text { font-size: 16px; color: #FFFFFF; }
