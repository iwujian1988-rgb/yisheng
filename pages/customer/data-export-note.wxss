/* pages/customer/data-export-note.wxss */
.export-container { min-height: 100vh; background-color: #F5F7FA; padding: 16px 32px 48px; }
.card { background-color: #FFFFFF; border-radius: 8px; padding: 20px; margin-bottom: 12px; }
.card-title { font-size: 16px; font-weight: 500; color: #333333; display: block; margin-bottom: 14px; }
.list-item { display: flex; align-items: center; padding: 10px 0; border-bottom: 1px solid #F0F0F0; }
.list-item:last-child { border-bottom: none; }
.list-dot { width: 8px; height: 8px; border-radius: 4px; margin-right: 10px; flex-shrink: 0; }
.dot-green { background-color: #52C41A; }
.dot-gray { background-color: #D9D9D9; }
.list-text { font-size: 15px; color: #333333; }
.apply-btn { width: 100%; height: 52px; border-radius: 12px; font-size: 16px; font-weight: 500; margin-top: 24px; background-color: #4A90E2; color: #FFFFFF; }
.apply-btn:active { opacity: 0.8; }
