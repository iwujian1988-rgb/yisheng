/* pages/customer/service-overview.wxss */
.overview-container { min-height: 100vh; background-color: #F5F7FA; padding: 16px 32px; }
.card { background-color: #FFFFFF; border-radius: 8px; padding: 20px; margin-bottom: 12px; }
.card-title { font-size: 16px; font-weight: 500; color: #333333; display: block; margin-bottom: 14px; }
.info-row { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid #F0F0F0; }
.info-row:last-child { border-bottom: none; }
.info-label { font-size: 15px; color: #666666; }
.info-value { font-size: 15px; color: #333333; }
.entry-list { display: flex; flex-direction: column; }
.entry-item { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid #F0F0F0; }
.entry-item:last-child { border-bottom: none; }
.entry-text { font-size: 15px; color: #4A90E2; }
.entry-arrow { font-size: 12px; color: #CCCCCC; }
