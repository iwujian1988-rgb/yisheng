/* pages/customer/service-overview.wxss */
.overview-container { min-height: 100vh; background-color: #FCFBFF; padding: 24rpx 32rpx; }
.card { background-color: #FFFFFF; border-radius: 20rpx; padding: 40rpx; margin-bottom: 24rpx;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}
.card-title { font-size: 32rpx; font-weight: 500; color: #101936; display: block; margin-bottom: 28rpx; }
.info-row { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; border-bottom: 2rpx solid rgba(111, 61, 255, 0.08); }
.info-row:last-child { border-bottom: none; }
.info-label { font-size: 30rpx; color: #64739A; }
.info-value { font-size: 30rpx; color: #101936; }
.entry-list { display: flex; flex-direction: column; }
.entry-item { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; border-bottom: 2rpx solid rgba(111, 61, 255, 0.08); }
.entry-item:last-child { border-bottom: none; }
.entry-text { font-size: 30rpx; color: #6F3DFF; }
.entry-arrow { font-size: 24rpx; color: #CCCCCC; }
