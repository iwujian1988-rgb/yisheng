/* pages/customer/device-bound-success.wxss */
.success-container { min-height: 100vh; background-color: #FCFBFF; display: flex; flex-direction: column; align-items: center; padding: 160rpx 64rpx 96rpx; }
.success-section { display: flex; flex-direction: column; align-items: center; margin-bottom: 120rpx; }
.success-circle { width: 160rpx; height: 160rpx; border-radius: 50%; background-color: #52C41A; color: #FFFFFF; font-size: 80rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 48rpx; }
.success-title { font-size: 44rpx; font-weight: bold; color: #101936; margin-bottom: 20rpx; }
.success-desc { font-size: 30rpx; color: #64739A; text-align: center; line-height: 1.6; }
.action-section { width: 100%; display: flex; flex-direction: column; gap: 24rpx; }
.action-btn { width: 100%; height: 104rpx; border-radius: 999rpx; font-size: 32rpx; font-weight: 500; }
.btn-primary { background-color: #6F3DFF; color: #FFFFFF; }
.btn-primary:active { opacity: 0.8; }
.btn-outline { background-color: transparent; color: #6F3DFF; border: 2rpx solid #6F3DFF; }
