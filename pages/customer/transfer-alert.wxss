/* pages/customer/transfer-alert.wxss */
.alert-container { min-height: 100vh; background-color: #FCFBFF; padding: 24rpx 32rpx; display: flex; flex-direction: column; }
.alert-card { background-color: #FFF8E1; border-radius: 20rpx; padding: 40rpx; display: flex; flex-direction: column; }
.alert-title { font-size: 32rpx; color: #F57F17; font-weight: 500; }
.alert-desc { font-size: 26rpx; color: #E65100; margin-top: 16rpx; }
.info-section { background-color: #FFFFFF; border-radius: 20rpx; padding: 40rpx; margin-top: 32rpx; }
.info-row { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; border-bottom: 2rpx solid rgba(111, 61, 255, 0.08); }
.info-row:last-child { border-bottom: none; }
.info-label { font-size: 28rpx; color: #98A1B8; }
.info-value { font-size: 28rpx; color: #101936; }
.bottom-actions { margin-top: auto; padding: 48rpx 0; display: flex; flex-direction: column; gap: 20rpx; }
.btn-primary { background-color: #6F3DFF; border-radius: 999rpx; padding: 28rpx 0; text-align: center; }
.btn-text { font-size: 32rpx; color: #FFFFFF; }
.btn-secondary { background-color: #FFFFFF; border: 2rpx solid #6F3DFF; border-radius: 999rpx; padding: 28rpx 0; text-align: center; }
.btn-text-secondary { font-size: 32rpx; color: #6F3DFF; }
