<!--pages/customer/first-transfer-success.wxml-->
<view class="success-container">
  <view class="success-section">
    <view class="success-circle">✓</view>
    <text class="success-title">首次传输成功</text>
    <text class="success-desc">文本已成功发送到电脑，您可以继续发送或返回首页。</text>
  </view>
  <view class="action-section">
    <button class="btn btn-primary action-btn" bindtap="goContinue">继续发送</button>
    <button class="btn btn-outline action-btn" bindtap="goHistory">返回首页</button>
    <button class="btn btn-outline action-btn" bindtap="goFeedback">反馈体验</button>
  </view>
</view>
