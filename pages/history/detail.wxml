<view class="detail-container">
  <view class="meta-card">
    <view class="meta-row">
      <text class="meta-label">类型</text>
      <text class="meta-value">{{type}}</text>
    </view>
    <view class="meta-row">
      <text class="meta-label">时间</text>
      <text class="meta-value">{{time}}</text>
    </view>
    <view class="meta-row">
      <text class="meta-label">字数</text>
      <text class="meta-value">{{textLength}} 字</text>
    </view>
  </view>

  <view class="content-card">
    <view class="content-head">
      <text class="content-title">发送内容</text>
      <text class="copy-btn" bindtap="copyText" wx:if="{{text}}">复制</text>
    </view>
    <text class="content-text" wx:if="{{text}}">{{text}}</text>
    <text class="empty-text" wx:else>{{isLoading ? '正在读取' : '暂无内容'}}</text>
  </view>
</view>
