<view class="history-container">
  <view class="empty-section" wx:if="{{records.length === 0 && !isLoading}}">
    <view class="empty-icon">
      <text class="empty-icon-text">&#9776;</text>
    </view>
    <text class="empty-title">暂无传输记录</text>
    <text class="empty-desc">传输完成后会显示时间、来源和字数等元数据。</text>
  </view>

  <view class="empty-section" wx:if="{{isLoading}}">
    <text class="empty-title">正在读取</text>
  </view>

  <view class="list-section" wx:if="{{records.length > 0}}">
    <view class="record-card" wx:for="{{records}}" wx:key="id">
      <view class="record-header">
        <text class="record-type">{{item.type}}</text>
        <text class="record-time">{{item.time}}</text>
      </view>
      <view class="record-body">
        <text class="record-preview">{{item.preview}}</text>
      </view>
      <view class="record-footer">
        <text class="record-status {{item.success ? 'status-success' : 'status-fail'}}">
          {{item.success ? '传输成功' : '传输失败'}}
        </text>
        <text class="record-length">{{item.length}}</text>
      </view>
    </view>
  </view>
</view>
