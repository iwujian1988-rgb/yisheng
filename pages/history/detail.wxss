.detail-container {
  min-height: 100vh;
  background: #F5F7FA;
  padding: 30rpx;
  box-sizing: border-box;
}

.meta-card,
.content-card {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.meta-row {
  min-height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.meta-label {
  font-size: 26rpx;
  color: #888888;
}

.meta-value {
  font-size: 26rpx;
  color: #222222;
  font-weight: 500;
}

.content-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.content-title {
  font-size: 32rpx;
  color: #222222;
  font-weight: 600;
}

.copy-btn {
  font-size: 26rpx;
  color: #1677FF;
}

.content-text {
  display: block;
  font-size: 30rpx;
  color: #333333;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}
