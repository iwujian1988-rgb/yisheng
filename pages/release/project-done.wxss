/* pages/release/project-done.wxss */
.done-container { min-height: 100vh; background-color: #FCFBFF; padding: 24rpx 32rpx; }
.done-header { display: flex; flex-direction: column; align-items: center; padding: 80rpx 0 48rpx; }
.done-title { font-size: 40rpx; color: #101936; font-weight: 600; }
.done-desc { font-size: 26rpx; color: #98A1B8; margin-top: 16rpx; text-align: center; }
.summary-card { background-color: #FFFFFF; border-radius: 20rpx; padding: 40rpx;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}
.info-row { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; border-bottom: 2rpx solid rgba(111, 61, 255, 0.08); }
.info-row:last-child { border-bottom: none; }
.info-label { font-size: 28rpx; color: #98A1B8; }
.info-value { font-size: 28rpx; color: #101936; }
.status-ok { color: #4CAF50; font-weight: 500; }
