/* pages/release/version-detail.wxss */
.detail-container { min-height: 100vh; background-color: #FCFBFF; padding: 24rpx 32rpx; display: flex; flex-direction: column; }
.info-card { background-color: #FFFFFF; border-radius: 20rpx; padding: 40rpx;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}
.info-row { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; border-bottom: 2rpx solid rgba(111, 61, 255, 0.08); }
.info-row:last-child { border-bottom: none; }
.info-label { font-size: 28rpx; color: #98A1B8; }
.info-value { font-size: 28rpx; color: #101936; }
.section-title { padding: 40rpx 0 20rpx; }
.section-text { font-size: 32rpx; color: #101936; font-weight: 500; }
.changelog-card { background-color: #FFFFFF; border-radius: 20rpx; padding: 40rpx;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}
.changelog-text { font-size: 28rpx; color: #64739A; line-height: 1.6; }
.bottom-actions { margin-top: auto; padding: 48rpx 0; }
.btn-danger { background-color: #FFFFFF; border: 2rpx solid #F44336; border-radius: 999rpx; padding: 28rpx 0; text-align: center; }
.btn-text-danger { font-size: 32rpx; color: #F44336; }
