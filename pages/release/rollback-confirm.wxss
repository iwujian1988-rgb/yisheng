/* pages/release/rollback-confirm.wxss */
.confirm-container { min-height: 100vh; background-color: #FCFBFF; padding: 24rpx 32rpx; display: flex; flex-direction: column; }
.confirm-card { background-color: #FFFFFF; border-radius: 20rpx; padding: 40rpx; display: flex; flex-direction: column;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}
.confirm-title { font-size: 36rpx; color: #101936; font-weight: 600; }
.confirm-desc { font-size: 28rpx; color: #64739A; margin-top: 24rpx; line-height: 1.6; }
.warning-card { background-color: #FFF3E0; border-radius: 20rpx; padding: 32rpx 40rpx; margin-top: 32rpx; }
.warning-text { font-size: 26rpx; color: #E65100; }
.bottom-actions { margin-top: auto; padding: 48rpx 0; display: flex; flex-direction: column; gap: 20rpx; }
.btn-danger { background-color: #F44336; border-radius: 999rpx; padding: 28rpx 0; text-align: center; }
.btn-text-danger { font-size: 32rpx; color: #FFFFFF; }
.btn-secondary { background-color: #FFFFFF; border: 2rpx solid #CCCCCC; border-radius: 999rpx; padding: 28rpx 0; text-align: center; }
.btn-text-secondary { font-size: 32rpx; color: #64739A; }
