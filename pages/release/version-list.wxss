/* pages/release/version-list.wxss */
.version-container { min-height: 100vh; background-color: #FCFBFF; padding: 24rpx 32rpx; }
.section-title { padding: 16rpx 0 32rpx; }
.section-text { font-size: 32rpx; color: #101936; font-weight: 500; }
.empty-section { display: flex; justify-content: center; padding-top: 240rpx; }
.empty-text { font-size: 28rpx; color: #98A1B8; }
.version-list { display: flex; flex-direction: column; gap: 20rpx; }
.version-card { background-color: #FFFFFF; border-radius: 20rpx; padding: 32rpx 40rpx; display: flex; flex-direction: column;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}
.version-header { display: flex; justify-content: space-between; align-items: center; }
.version-name { font-size: 30rpx; color: #101936; font-weight: 500; }
.version-tag { font-size: 24rpx; padding: 4rpx 16rpx; border-radius: 20rpx; }
.tag-current { background-color: #F2EDFF; color: #6F3DFF; }
.tag-old { background-color: #F5F5F5; color: #98A1B8; }
.version-date { font-size: 24rpx; color: #CCCCCC; margin-top: 12rpx; }
