.container {
  min-height: 100vh;
  padding: 30rpx;
  background: #F5F7FA;
  box-sizing: border-box;
}

.status-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 48rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.status-card.error {
  background: #FFF7F0;
}

.status-indicator {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 6rpx solid #E0E0E0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-ring.idle {
  border-color: #D9D9D9;
}

.status-ring.scanning {
  border-color: #1677FF;
  animation: pulse 1.2s ease-in-out infinite;
}

.status-ring.connecting,
.status-ring.binding {
  border-color: #FAAD14;
  animation: pulse 1s ease-in-out infinite;
}

.status-ring.connected {
  border-color: #52C41A;
}

.status-ring.error {
  border-color: #FF4D4F;
}

.status-ring.empty {
  border-color: #D9D9D9;
}

.status-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #D9D9D9;
}

.status-ring.scanning .status-dot {
  background: #1677FF;
}

.status-ring.connecting .status-dot,
.status-ring.binding .status-dot {
  background: #FAAD14;
}

.status-ring.connected .status-dot {
  background: #52C41A;
}

.status-ring.error .status-dot {
  background: #FF4D4F;
}

@keyframes pulse {
  0% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.08); opacity: 0.8; }
  100% { transform: scale(1); opacity: 1; }
}

.status-text {
  font-size: 28rpx;
  color: #666666;
  text-align: center;
}

.device-list {
  margin-bottom: 24rpx;
}

.list-title {
  font-size: 26rpx;
  color: #888888;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.device-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.device-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.device-name {
  font-size: 30rpx;
  color: #222222;
  font-weight: 600;
}

.device-id {
  font-size: 22rpx;
  color: #AAAAAA;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-rssi {
  font-size: 24rpx;
  color: #888888;
  margin-left: 20rpx;
}

.action-area {
  padding-top: 20rpx;
}

.scan-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: #1677FF;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  border: none;
}

.scan-btn.disabled {
  background: #B0CFFF;
  color: rgba(255, 255, 255, 0.7);
}
