/* pages/backend/error-log.wxss */
.log-container { min-height: 100vh; background-color: #F5F7FA; padding: 16px 32px; }
.empty-section { display: flex; justify-content: center; padding-top: 120px; }
.empty-text { font-size: 14px; color: #999999; }
.log-list { display: flex; flex-direction: column; gap: 10px; }
.log-card { background-color: #FFFFFF; border-radius: 8px; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; }
.log-code { font-size: 15px; color: #F5222D; font-weight: 500; }
.log-time { font-size: 12px; color: #999999; }
