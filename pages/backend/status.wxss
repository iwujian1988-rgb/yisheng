/* pages/backend/status.wxss */
.status-container { min-height: 100vh; background-color: #FCFBFF; padding: 24rpx 32rpx; }
.card { background-color: #FFFFFF; border-radius: 20rpx; padding: 32rpx 40rpx; margin-bottom: 20rpx;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}
.status-row { display: flex; align-items: center; }
.status-dot { width: 20rpx; height: 20rpx; border-radius: 10rpx; margin-right: 24rpx; flex-shrink: 0; }
.dot-green { background-color: #52C41A; }
.dot-red { background-color: #F5222D; }
.dot-gray { background-color: #D9D9D9; }
.status-label { font-size: 30rpx; color: #101936; flex: 1; }
.status-value { font-size: 28rpx; color: #98A1B8; }
