.health-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 32rpx 64rpx 96rpx;
}

.empty-section {
  display: flex;
  justify-content: center;
  padding-top: 240rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #64748b;
  text-align: center;
}

.check-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 48rpx;
}

.check-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 40rpx;
  display: flex;
  align-items: center;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.check-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 10rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.dot-green {
  background-color: #52c41a;
}

.dot-yellow {
  background-color: #faad14;
}

.dot-red {
  background-color: #f5222d;
}

.check-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.check-name {
  font-size: 30rpx;
  color: #101936;
}

.check-message {
  font-size: 24rpx;
  color: #64748b;
  word-break: break-all;
}

.check-result {
  font-size: 26rpx;
  color: #64748b;
  margin-left: 24rpx;
}

.action-section {
  margin-top: 40rpx;
}

.action-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
  background-color: #6F3DFF;
  color: #ffffff;
}
