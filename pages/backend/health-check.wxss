.health-container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 16px 32px 48px;
}

.empty-section {
  display: flex;
  justify-content: center;
  padding-top: 120px;
}

.empty-text {
  font-size: 14px;
  color: #64748b;
  text-align: center;
}

.check-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 24px;
}

.check-card {
  background-color: #ffffff;
  border-radius: 8px;
  padding: 16px 20px;
  display: flex;
  align-items: center;
}

.check-dot {
  width: 10px;
  height: 10px;
  border-radius: 5px;
  margin-right: 12px;
  flex-shrink: 0;
}

.dot-green {
  background-color: #52c41a;
}

.dot-yellow {
  background-color: #faad14;
}

.dot-red {
  background-color: #f5222d;
}

.check-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.check-name {
  font-size: 15px;
  color: #333333;
}

.check-message {
  font-size: 12px;
  color: #64748b;
  word-break: break-all;
}

.check-result {
  font-size: 13px;
  color: #64748b;
  margin-left: 12px;
}

.action-section {
  margin-top: 20px;
}

.action-btn {
  width: 100%;
  height: 52px;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 500;
  background-color: #4a90e2;
  color: #ffffff;
}
