/* pages/about/index.wxss */
.about-container {
  min-height: 100vh;
  background-color: #FCFBFF;
}

/* 产品信息 */
.product-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 64rpx 80rpx;
}

.logo-circle {
  width: 144rpx;
  height: 144rpx;
  border-radius: 32rpx;
  background-color: #6F3DFF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.logo-text {
  font-size: 64rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.product-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #101936;
  margin-bottom: 8rpx;
}

.product-desc {
  font-size: 28rpx;
  color: #64739A;
  margin-bottom: 16rpx;
}

.version-text {
  font-size: 26rpx;
  color: #98A1B8;
}

/* 信息列表 */
.info-section {
  padding: 0 32rpx;
}

.info-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 0 40rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 36rpx 0;
}

.info-label {
  font-size: 30rpx;
  color: #101936;
}

.info-arrow {
  font-size: 24rpx;
  color: #CCCCCC;
}

.info-divider {
  height: 2rpx;
  background-color: rgba(111, 61, 255, 0.08);
}
