/* pages/about/index.wxss */
.about-container {
  min-height: 100vh;
  background-color: #F5F7FA;
}

/* 产品信息 */
.product-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60px 32px 40px;
}

.logo-circle {
  width: 72px;
  height: 72px;
  border-radius: 16px;
  background-color: #4A90E2;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
}

.logo-text {
  font-size: 32px;
  color: #FFFFFF;
  font-weight: bold;
}

.product-name {
  font-size: 20px;
  font-weight: bold;
  color: #333333;
  margin-bottom: 4px;
}

.product-desc {
  font-size: 14px;
  color: #666666;
  margin-bottom: 8px;
}

.version-text {
  font-size: 13px;
  color: #999999;
}

/* 信息列表 */
.info-section {
  padding: 0 32px;
}

.info-card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 0 20px;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 0;
}

.info-label {
  font-size: 15px;
  color: #333333;
}

.info-arrow {
  font-size: 12px;
  color: #CCCCCC;
}

.info-divider {
  height: 1px;
  background-color: #F0F0F0;
}
