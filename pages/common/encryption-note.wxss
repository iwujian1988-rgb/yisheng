/* pages/common/encryption-note.wxss */
.encryption-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 32rpx 64rpx 96rpx;
}

/* 卡片 */
.card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #101936;
  display: block;
  margin-bottom: 20rpx;
}

.card-desc {
  font-size: 28rpx;
  color: #64739A;
  line-height: 1.8;
}

/* 区块头 */
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-badge {
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 20rpx;
}

.badge-local {
  background-color: #52C41A;
}

.badge-cloud {
  background-color: #6F3DFF;
}

.badge-ai {
  background-color: #722ED1;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #101936;
}

.section-desc {
  font-size: 28rpx;
  color: #64739A;
  line-height: 1.8;
}

/* 确认按钮 */
.confirm-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
  margin-top: 48rpx;
  background-color: #6F3DFF;
  color: #FFFFFF;
}

.confirm-btn:active {
  opacity: 0.8;
}
