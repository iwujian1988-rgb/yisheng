/* pages/common/agreement.wxss */
.agreement-container {
  min-height: 100vh;
  background-color: #FFFFFF;
  padding: 48rpx 64rpx 96rpx;
}

.agreement-meta {
  padding: 16rpx 24rpx;
  margin-bottom: 40rpx;
  background-color: #FCFBFF;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #98A1B8;
  display: block;
}

/* 段落 */
.section {
  margin-bottom: 56rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #101936;
  margin-bottom: 16rpx;
  display: block;
}

.section-text {
  font-size: 28rpx;
  color: #64739A;
  line-height: 1.8;
  display: block;
}
