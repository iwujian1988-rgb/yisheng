/* pages/common/release-note.wxss */
.release-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px;
}

.card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 20px;
  margin-bottom: 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.version-label {
  font-size: 13px;
  color: #999999;
  margin-bottom: 6px;
}

.version-num {
  font-size: 24px;
  font-weight: 600;
  color: #333333;
}

.section {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 20px;
  margin-bottom: 12px;
}

.section-label {
  font-size: 16px;
  font-weight: 500;
  color: #333333;
  display: block;
  margin-bottom: 14px;
}

.update-item {
  display: flex;
  align-items: flex-start;
  padding: 6px 0;
}

.update-dot {
  width: 6px;
  height: 6px;
  border-radius: 3px;
  background-color: #4A90E2;
  margin-top: 8px;
  margin-right: 10px;
  flex-shrink: 0;
}

.update-text {
  font-size: 15px;
  color: #333333;
  line-height: 1.6;
  flex: 1;
}

.notice-item {
  display: flex;
  align-items: flex-start;
  padding: 6px 0;
}

.notice-dot {
  width: 6px;
  height: 6px;
  border-radius: 3px;
  background-color: #FAAD14;
  margin-top: 8px;
  margin-right: 10px;
  flex-shrink: 0;
}

.notice-text {
  font-size: 15px;
  color: #666666;
  line-height: 1.6;
  flex: 1;
}
