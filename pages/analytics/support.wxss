/* pages/analytics/support.wxss */
.support-container { min-height: 100vh; background-color: #F5F7FA; padding: 16px 32px; }
.stat-grid { display: flex; flex-wrap: wrap; gap: 10px; }
.stat-card { background-color: #FFFFFF; border-radius: 8px; width: calc(50% - 5px); padding: 20px; display: flex; flex-direction: column; align-items: center; }
.stat-value { font-size: 20px; color: #333333; font-weight: 600; }
.stat-label { font-size: 12px; color: #999999; margin-top: 6px; }
.placeholder-section { display: flex; justify-content: center; padding-top: 60px; }
.placeholder-text { font-size: 14px; color: #CCCCCC; }
