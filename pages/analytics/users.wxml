<view class="users-container">
  <view class="stat-grid">
    <view class="stat-card">
      <text class="stat-value">{{totalUsers}}</text>
      <text class="stat-label">总用户</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{openedUsers}}</text>
      <text class="stat-label">已开通</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{boundUsers}}</text>
      <text class="stat-label">已绑定</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{activeUsers}}</text>
      <text class="stat-label">活跃用户</text>
    </view>
  </view>
</view>
