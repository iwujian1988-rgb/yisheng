/* pages/login/login.wxss */
.login-container {
  min-height: 100vh;
  padding: 0 32px;
  background: linear-gradient(180deg, #FFFFFF 0%, #F5F7FA 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Logo区域 */
.logo-section {
  margin-top: 80px;
  margin-bottom: 60px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  width: 80px;
  height: 80px;
  margin-bottom: 16px;
}

.app-name {
  font-size: 28px;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8px;
}

.app-desc {
  font-size: 14px;
  color: #999999;
}

/* 表单区域 */
.form-section {
  width: 100%;
  margin-bottom: 24px;
}

.input-wrapper {
  margin-bottom: 20px;
}

.input {
  width: 100%;
  height: 52px;
  padding: 0 16px;
  background-color: #FFFFFF;
  border: 1px solid #E5E5E5;
  border-radius: 12px;
  font-size: 15px;
  color: #333333;
  box-sizing: border-box;
  transition: all 0.3s;
}

.input:focus {
  border-color: #4A90E2;
  box-shadow: 0 0 0 3px rgba(74, 144, 226, 0.1);
}

.input-placeholder {
  color: #999999;
}

/* 密码输入框 */
.password-wrapper {
  position: relative;
}

.password-input {
  padding-right: 48px;
}

.eye-icon {
  position: absolute;
  right: 16px;
  top: 50%;
  transform: translateY(-50%);
  width: 20px;
  height: 20px;
}

/* 忘记密码 */
.forget-pwd {
  text-align: right;
  margin-bottom: 24px;
}

.forget-pwd text {
  font-size: 14px;
  color: #4A90E2;
}

/* 按钮样式 */
.btn {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background-color: #4A90E2;
  color: #FFFFFF;
}

.btn-primary:not(.disabled):active {
  opacity: 0.8;
}

.btn-primary.disabled {
  background-color: #CCCCCC;
  color: #FFFFFF;
}

.btn-outline {
  background-color: transparent;
  color: #4A90E2;
  border: 1px solid #4A90E2;
  margin-top: 16px;
}

/* 微信登录按钮 */
.wechat-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.wechat-icon {
  width: 20px;
  height: 20px;
}

/* 分割线 */
.divider-text {
  display: flex;
  align-items: center;
  margin: 24px 0;
  position: relative;
}

.divider-text text {
  padding: 0 16px;
  font-size: 14px;
  color: #CCCCCC;
  background-color: transparent;
  position: relative;
  z-index: 1;
}

.divider-text::before,
.divider-text::after {
  content: '';
  flex: 1;
  height: 1px;
  background-color: #E5E5E5;
  position: absolute;
  top: 50%;
}

.divider-text::before {
  left: 0;
}

.divider-text::after {
  right: 0;
}

/* 协议区域 */
.agreement-section {
  width: 100%;
  margin-bottom: 24px;
}

.agreement-label {
  display: flex;
  align-items: center;
  font-size: 13px;
}

.agreement-text {
  color: #666666;
  margin-left: 8px;
}

.agreement-link {
  color: #4A90E2;
  margin: 0 2px;
}

/* 注册区域 */
.register-section {
  margin-top: auto;
  margin-bottom: 40px;
  display: flex;
  align-items: center;
}

.register-text {
  font-size: 14px;
  color: #666666;
}

.register-link {
  font-size: 14px;
  color: #4A90E2;
  margin-left: 4px;
}
