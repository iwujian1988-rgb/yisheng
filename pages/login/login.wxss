.login-container {
  min-height: 100vh;
  padding: 0 32px;
  background: linear-gradient(180deg, #FFFFFF 0%, #F5F7FA 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-section {
  margin-top: 80px;
  margin-bottom: 60px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.app-name {
  font-size: 28px;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8px;
}

.app-desc {
  font-size: 14px;
  color: #666666;
}

.form-section {
  width: 100%;
  margin-bottom: 24px;
}

.input-wrapper {
  margin-bottom: 20px;
}

.input {
  width: 100%;
  height: 52px;
  padding: 0 16px;
  background-color: #FFFFFF;
  border: 1px solid #E5E5E5;
  border-radius: 12px;
  font-size: 15px;
  color: #333333;
  box-sizing: border-box;
}

.input-placeholder {
  color: #999999;
}

.password-wrapper {
  position: relative;
}

.password-input {
  padding-right: 56px;
}

.eye-icon {
  position: absolute;
  right: 16px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 13px;
  color: #4A90E2;
}

.btn {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background-color: #4A90E2;
  color: #FFFFFF;
}

.btn-primary:not(.disabled):active {
  opacity: 0.8;
}

.btn-primary.disabled {
  background-color: #CCCCCC;
  color: #FFFFFF;
}

.btn-outline {
  background-color: transparent;
  color: #4A90E2;
  border: 1px solid #4A90E2;
  margin-top: 16px;
}

.login-note {
  margin-top: 12px;
  text-align: center;
}

.login-note text {
  font-size: 13px;
  line-height: 1.6;
  color: #666666;
}

.password-login {
  width: 100%;
}

.divider-text {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 24px 0;
  color: #999999;
  font-size: 14px;
}

.agreement-section {
  width: 100%;
  margin-bottom: 24px;
}

.agreement-label {
  display: flex;
  align-items: center;
  font-size: 13px;
  flex-wrap: wrap;
}

.agreement-text {
  color: #666666;
  margin-left: 6px;
}

.agreement-link {
  color: #4A90E2;
  margin: 0 2px;
}

.register-section {
  margin-top: auto;
  margin-bottom: 40px;
  display: flex;
  align-items: center;
  text-align: center;
}

.register-text {
  font-size: 14px;
  color: #666666;
}
