.login-container {
  min-height: 100vh;
  padding: 0 64rpx;
  padding-top: 160rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #F5F7FA 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.logo-section {
  margin-bottom: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.app-name {
  font-size: 56rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
}

.app-desc {
  font-size: 28rpx;
  color: #666666;
}

.form-section {
  width: 100%;
  margin-bottom: 48rpx;
}

.login-input {
  margin-bottom: 32rpx;
}

.login-input--small {
  --td-input-vertical-padding: 16rpx;
  --td-font-body-large: 28rpx / 40rpx PingFang SC, Microsoft YaHei, Arial Regular;
  --td-input-placeholder-text-font: 28rpx / 40rpx PingFang SC, Microsoft YaHei, Arial Regular;
}

.login-input--row {
  --td-input-vertical-padding: 8rpx;
  --td-font-body-large: 28rpx / 48rpx PingFang SC, Microsoft YaHei, Arial Regular;
  --td-input-placeholder-text-font: 28rpx / 48rpx PingFang SC, Microsoft YaHei, Arial Regular;
  margin-bottom: 0;
}

.code-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.code-input {
  flex: 1;
}

.code-btn {
  flex-shrink: 0;
  width: 232rpx !important;
  --td-button-small-height: 64rpx;
}

.login-btn {
  margin-top: 16rpx;
}

.wechat-btn {
  --td-button-primary-bg-color: #07C160;
  --td-button-primary-border-color: #07C160;
  --td-button-primary-active-bg-color: #06AD56;
  --td-button-primary-active-border-color: #06AD56;
  --td-button-primary-disabled-bg: #91DAB0;
  --td-button-primary-disabled-border-color: #91DAB0;
}

.login-note {
  margin-top: 24rpx;
  text-align: center;
}

.login-note text {
  font-size: 26rpx;
  line-height: 1.6;
  color: #666666;
}

.password-login {
  width: 100%;
  margin-top: 16rpx;
}

.toggle-password {
  display: flex;
  justify-content: center;
  margin: 32rpx 0 16rpx;
  color: #1677FF;
  font-size: 28rpx;
}

.agreement-section {
  width: 100%;
  margin-bottom: 48rpx;
  display: flex;
  justify-content: center;
}

.agreement-checkbox {
  --td-checkbox-icon-size: 32rpx;
  --td-checkbox-title-line-height: 32rpx;
}

.agreement-text-wrap {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  white-space: nowrap;
  font-size: 22rpx;
  line-height: 32rpx;
}

.agreement-text {
  color: #666666;
  flex-shrink: 0;
}

.agreement-link {
  color: #1677FF;
  flex-shrink: 0;
}

.register-section {
  margin-top: auto;
  margin-bottom: 80rpx;
  display: flex;
  align-items: center;
  text-align: center;
}

.register-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.5;
}
