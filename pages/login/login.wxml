<view class="login-container">
  <view class="logo-section">
    <text class="app-name">科室打字员</text>
    <text class="app-desc">帮助你早点下班的ai助手</text>
  </view>

  <view class="form-section">
    <t-input
      type="number"
      placeholder="请输入手机号"
      value="{{phone}}"
      bind:change="onPhoneInput"
      maxlength="11"
      t-class="login-input login-input--small"
    />

    <view class="code-row">
      <t-input
        class="code-input"
        type="number"
        placeholder="请输入 6 位验证码"
        value="{{code}}"
        bind:change="onCodeInput"
        maxlength="6"
        t-class="login-input login-input--row"
      />
      <t-button
        variant="outline"
        size="small"
        disabled="{{!canSendCode || countingDown || isCodeLoading}}"
        loading="{{isCodeLoading}}"
        bind:tap="sendCode"
        t-class="code-btn"
      >
        {{countingDown ? countdown + 's' : '获取验证码'}}
      </t-button>
    </view>

    <t-button
      theme="primary"
      block
      loading="{{isLoading}}"
      disabled="{{!canPhoneLogin || isLoading}}"
      bind:tap="onPhoneLogin"
      t-class="login-btn"
    >
      {{isLoading ? '登录中...' : '注册/登录'}}
    </t-button>

    <t-divider content="或" />

    <t-button
      theme="primary"
      block
      loading="{{isWechatLoading}}"
      disabled="{{isWechatLoading}}"
      bind:tap="onWechatLogin"
      t-class="login-btn wechat-btn"
    >
      {{isWechatLoading ? '登录中...' : '微信登录'}}
    </t-button>

    <view class="login-note">
      <text>微信登录仅支持已绑定手机号的账号，未绑定请先使用验证码登录。</text>
    </view>
  </view>

  <view class="agreement-section">
    <t-checkbox
      checked="{{agreed}}"
      block="{{false}}"
      bind:change="onAgreementChange"
      t-class="agreement-checkbox"
    >
      <view class="agreement-text-wrap">
        <text class="agreement-text">我已阅读并同意</text>
        <text class="agreement-link" catchtap="goToAgreement" data-type="user">《用户协议》</text>
        <text class="agreement-text">和</text>
        <text class="agreement-link" catchtap="goToAgreement" data-type="privacy">《隐私政策》</text>
      </view>
    </t-checkbox>
  </view>
</view>
 