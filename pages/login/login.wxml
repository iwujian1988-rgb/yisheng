<view class="login-container">
  <view class="logo-section">
    <text class="app-name">文本传输助手</text>
    <text class="app-desc">AI 内容整理与离线电脑输入工具</text>
  </view>

  <view class="form-section">
    <button
      class="btn btn-primary"
      bindtap="onWechatLogin"
      loading="{{isWechatLoading}}"
      disabled="{{isWechatLoading}}"
    >
      {{isWechatLoading ? '登录中...' : '微信一键登录'}}
    </button>

    <view class="login-note">
      <text>登录后将校验服务开通状态，设备可用性以后续蓝牙连接结果为准。</text>
    </view>

    <view class="divider-text" bindtap="togglePasswordLogin">
      <text>{{showPasswordLogin ? '收起备用登录' : '备用账号登录'}}</text>
    </view>

    <view wx:if="{{showPasswordLogin}}" class="password-login">
      <view class="input-wrapper">
        <input
          class="input"
          type="text"
          placeholder="请输入手机号或账号"
          placeholder-class="input-placeholder"
          value="{{account}}"
          bindinput="onAccountInput"
          maxlength="30"
        />
      </view>

      <view class="input-wrapper password-wrapper">
        <input
          class="input password-input"
          type="{{showPassword ? 'text' : 'password'}}"
          placeholder="请输入密码"
          placeholder-class="input-placeholder"
          value="{{password}}"
          bindinput="onPasswordInput"
          maxlength="20"
        />
        <text class="eye-icon" bindtap="togglePassword">{{showPassword ? '隐藏' : '显示'}}</text>
      </view>

      <button
        class="btn btn-outline {{canLogin ? '' : 'disabled'}}"
        disabled="{{!canLogin || isLoading}}"
        bindtap="onLogin"
        loading="{{isLoading}}"
      >
        {{isLoading ? '登录中...' : '账号登录'}}
      </button>
    </view>
  </view>

  <view class="agreement-section">
    <checkbox-group bindchange="onAgreementChange">
      <label class="agreement-label">
        <checkbox value="agree" checked="{{agreed}}" color="#4A90E2" />
        <text class="agreement-text">我已阅读并同意</text>
        <text class="agreement-link" bindtap="goToAgreement" data-type="user">《用户协议》</text>
        <text class="agreement-text">和</text>
        <text class="agreement-link" bindtap="goToAgreement" data-type="privacy">《隐私政策》</text>
      </label>
    </checkbox-group>
  </view>

  <view class="register-section">
    <text class="register-text">购买设备后，登录并输入激活码即可开通服务。</text>
  </view>
</view>
