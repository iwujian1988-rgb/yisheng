.env-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 24rpx 32rpx;
}

.card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.env-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.env-badge {
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 20rpx;
}

.badge-pc {
  background-color: #6F3DFF;
}

.badge-remote {
  background-color: #52C41A;
}

.badge-vm {
  background-color: #FAAD14;
}

.badge-web {
  background-color: #722ED1;
}

.badge-unknown {
  background-color: #98A1B8;
}

.env-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #101936;
}

.env-desc {
  font-size: 28rpx;
  color: #64739A;
  line-height: 1.8;
}
