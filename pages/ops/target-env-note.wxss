.env-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px;
}

.card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 20px;
  margin-bottom: 12px;
}

.env-header {
  display: flex;
  align-items: center;
  margin-bottom: 10px;
}

.env-badge {
  font-size: 11px;
  font-weight: 600;
  color: #FFFFFF;
  padding: 3px 8px;
  border-radius: 4px;
  margin-right: 10px;
}

.badge-pc {
  background-color: #4A90E2;
}

.badge-remote {
  background-color: #52C41A;
}

.badge-vm {
  background-color: #FAAD14;
}

.badge-web {
  background-color: #722ED1;
}

.badge-unknown {
  background-color: #999999;
}

.env-title {
  font-size: 16px;
  font-weight: 500;
  color: #333333;
}

.env-desc {
  font-size: 14px;
  color: #666666;
  line-height: 1.8;
}
