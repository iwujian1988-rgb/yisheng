/* pages/ops/ticket-detail.wxss */
.detail-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px 48px;
}

.card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 20px;
  margin-bottom: 16px;
}

.card-title {
  font-size: 16px;
  font-weight: 500;
  color: #333333;
  display: block;
  margin-bottom: 14px;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 10px 0;
  border-bottom: 1px solid #F0F0F0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 15px;
  color: #666666;
  flex-shrink: 0;
  margin-right: 16px;
}

.info-value {
  font-size: 15px;
  color: #333333;
  text-align: right;
  flex: 1;
}

.section-label {
  font-size: 15px;
  font-weight: 500;
  color: #333333;
  display: block;
  margin-bottom: 10px;
}

.empty-section {
  display: flex;
  justify-content: center;
  padding: 40px 0;
  margin-bottom: 16px;
}

.empty-text {
  font-size: 14px;
  color: #999999;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 24px;
}

.record-card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 14px 20px;
}

.record-content {
  font-size: 14px;
  color: #333333;
  line-height: 1.6;
  display: block;
  margin-bottom: 6px;
}

.record-time {
  font-size: 12px;
  color: #999999;
}

.action-section {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.action-btn {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
}

.btn-primary {
  background-color: #4A90E2;
  color: #FFFFFF;
}

.btn-outline {
  background-color: transparent;
  color: #4A90E2;
  border: 1px solid #4A90E2;
}
