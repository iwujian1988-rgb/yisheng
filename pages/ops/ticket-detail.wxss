/* pages/ops/ticket-detail.wxss */
.detail-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 32rpx 64rpx 96rpx;
}

.card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 32rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #101936;
  display: block;
  margin-bottom: 28rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(111, 61, 255, 0.08);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 30rpx;
  color: #64739A;
  flex-shrink: 0;
  margin-right: 32rpx;
}

.info-value {
  font-size: 30rpx;
  color: #101936;
  text-align: right;
  flex: 1;
}

.section-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #101936;
  display: block;
  margin-bottom: 20rpx;
}

.empty-section {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #98A1B8;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 48rpx;
}

.record-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 40rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.record-content {
  font-size: 28rpx;
  color: #101936;
  line-height: 1.6;
  display: block;
  margin-bottom: 12rpx;
}

.record-time {
  font-size: 24rpx;
  color: #98A1B8;
}

.action-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.action-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-primary {
  background-color: #6F3DFF;
  color: #FFFFFF;
}

.btn-outline {
  background-color: transparent;
  color: #6F3DFF;
  border: 2rpx solid #6F3DFF;
}
