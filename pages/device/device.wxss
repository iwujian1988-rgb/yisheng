.device-container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 0 32px;
}

.status-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 60px;
}

.icon-circle {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24px;
}

.icon-text {
  font-size: 34px;
  color: #ffffff;
  font-weight: 700;
}

.icon-unbound {
  background-color: #4a90e2;
}

.icon-bound {
  background-color: #52c41a;
}

.icon-unavailable {
  background-color: #faad14;
}

.status-title {
  font-size: 20px;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8px;
}

.status-desc {
  font-size: 14px;
  color: #666666;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32px;
  padding: 0 16px;
}

.info-card,
.detail-card {
  width: 100%;
  background-color: #ffffff;
  border-radius: 8px;
  padding: 20px;
  margin-bottom: 32px;
}

.info-label {
  font-size: 14px;
  font-weight: 500;
  color: #333333;
  margin-bottom: 12px;
  display: block;
}

.info-step {
  font-size: 14px;
  color: #666666;
  line-height: 2;
  display: block;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 0;
}

.detail-label {
  font-size: 14px;
  color: #666666;
}

.detail-value {
  font-size: 14px;
  color: #333333;
}

.detail-divider {
  height: 1px;
  background-color: #f0f0f0;
}

.action-btn {
  width: 100%;
  height: 52px;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 500;
}

.action-group {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.btn-primary {
  background-color: #4a90e2;
  color: #ffffff;
}

.btn-primary[disabled] {
  background-color: #cccccc;
  color: #ffffff;
}

.btn-outline {
  background-color: transparent;
  color: #4a90e2;
  border: 1px solid #4a90e2;
}
