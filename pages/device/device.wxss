.device-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 0 32rpx 48rpx;
  box-sizing: border-box;
}

.status-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.icon-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}

.icon-text {
  font-size: 68rpx;
  color: #ffffff;
  font-weight: 700;
}

.icon-unbound {
  background-color: #6F3DFF;
}

.icon-bound {
  background-color: #52c41a;
}

.icon-unavailable {
  background-color: #faad14;
}

.status-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #101936;
  margin-bottom: 16rpx;
}

.status-desc {
  font-size: 28rpx;
  color: #64739A;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 64rpx;
  padding: 0 32rpx;
}

.info-card,
.detail-card {
  width: 100%;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 64rpx;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
  box-shadow: 0 6rpx 20rpx rgba(61, 42, 140, 0.04);
}

.info-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #101936;
  margin-bottom: 24rpx;
  display: block;
}

.info-step {
  font-size: 28rpx;
  color: #64739A;
  line-height: 2;
  display: block;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
}

.detail-label {
  font-size: 28rpx;
  color: #64739A;
}

.detail-value {
  font-size: 28rpx;
  color: #101936;
}

.detail-divider {
  height: 2rpx;
  background-color: rgba(111, 61, 255, 0.08);
}

.action-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.action-group {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.btn-primary {
  background-color: #6F3DFF;
  color: #ffffff;
}

.btn-primary[disabled] {
  background-color: #cccccc;
  color: #ffffff;
}

.btn-outline {
  background-color: transparent;
  color: #6F3DFF;
  border: 2rpx solid rgba(111, 61, 255, 0.24);
}
