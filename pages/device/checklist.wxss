/* pages/device/checklist.wxss */
.checklist-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px;
}

.tip-card {
  background-color: rgba(74, 144, 226, 0.08);
  border-radius: 8px;
  padding: 12px 16px;
  margin-bottom: 20px;
}

.tip-text {
  font-size: 14px;
  color: #4A90E2;
}

.check-card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 4px 20px;
  margin-bottom: 32px;
}

.check-item {
  padding: 12px 0;
  border-bottom: 1px solid #F0F0F0;
}

.check-item:last-child {
  border-bottom: none;
}

.check-label {
  display: flex;
  align-items: center;
}

.check-text {
  font-size: 15px;
  color: #333333;
  margin-left: 8px;
}

.connect-btn {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
}

.btn-primary {
  background-color: #4A90E2;
  color: #FFFFFF;
}

.btn-primary:active {
  opacity: 0.8;
}

.disabled {
  background-color: #CCCCCC;
  color: #FFFFFF;
}
