/* pages/device/checklist.wxss */
.checklist-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 24rpx 32rpx;
}

.tip-card {
  background-color: rgba(111, 61, 255, 0.08);
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 40rpx;
}

.tip-text {
  font-size: 28rpx;
  color: #6F3DFF;
}

.check-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 8rpx 40rpx;
  margin-bottom: 64rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.check-item {
  padding: 24rpx 0;
  border-bottom: 2rpx solid rgba(111, 61, 255, 0.08);
}

.check-item:last-child {
  border-bottom: none;
}

.check-label {
  display: flex;
  align-items: center;
}

.check-text {
  font-size: 30rpx;
  color: #101936;
  margin-left: 16rpx;
}

.connect-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-primary {
  background-color: #6F3DFF;
  color: #FFFFFF;
}

.btn-primary:active {
  opacity: 0.8;
}

.disabled {
  background-color: #CCCCCC;
  color: #FFFFFF;
}
