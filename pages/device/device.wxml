<!--pages/device/device.wxml-->
<view class="device-container">
  <!-- 设备未绑定 -->
  <view class="status-section" wx:if="{{status === 'unbound'}}">
    <view class="icon-circle icon-unbound">
      <text class="icon-text">&#9881;</text>
    </view>
    <text class="status-title">未绑定设备</text>
    <text class="status-desc">请将传输硬件插入电脑 USB 口，然后在下方点击绑定</text>

    <view class="info-card">
      <text class="info-label">绑定步骤：</text>
      <text class="info-step">1. 将硬件插入电脑 USB 口</text>
      <text class="info-step">2. 等待电脑识别设备</text>
      <text class="info-step">3. 点击下方按钮完成绑定</text>
    </view>

    <button
      class="btn btn-primary action-btn {{binding ? '' : ''}}"
      disabled="{{binding}}"
      loading="{{binding}}"
      bindtap="bindDevice"
    >
      {{binding ? '绑定中...' : '绑定设备'}}
    </button>
  </view>

  <!-- 设备已绑定 -->
  <view class="status-section" wx:if="{{status === 'bound'}}">
    <view class="icon-circle icon-bound">
      <text class="icon-text">&#10003;</text>
    </view>
    <text class="status-title">设备已绑定</text>
    <text class="status-desc">传输硬件已连接，可以正常使用</text>

    <view class="detail-card">
      <view class="detail-row">
        <text class="detail-label">设备型号</text>
        <text class="detail-value">{{deviceModel || '--'}}</text>
      </view>
      <view class="detail-divider"></view>
      <view class="detail-row">
        <text class="detail-label">序列号</text>
        <text class="detail-value">{{deviceSN || '--'}}</text>
      </view>
      <view class="detail-divider"></view>
      <view class="detail-row">
        <text class="detail-label">绑定时间</text>
        <text class="detail-value">{{bindTime || '--'}}</text>
      </view>
    </view>

    <button class="btn btn-outline action-btn" bindtap="unbindDevice">
      解绑设备
    </button>
  </view>

  <!-- 设备不可用 -->
  <view class="status-section" wx:if="{{status === 'unavailable'}}">
    <view class="icon-circle icon-unavailable">
      <text class="icon-text">&#9888;</text>
    </view>
    <text class="status-title">设备不可用</text>
    <text class="status-desc">{{unavailableReason || '当前设备无法使用，请检查连接或联系客服'}}</text>

    <view class="action-group">
      <button class="btn btn-primary action-btn" bindtap="retryConnection">
        重新检测
      </button>
      <button class="btn btn-outline action-btn" bindtap="contactSupport">
        联系客服
      </button>
    </view>
  </view>
</view>
