<view class="checklist-container">
  <view class="tip-card">
    <text class="tip-text">请逐项确认后再开始连接。</text>
  </view>

  <checkbox-group class="check-card" bindchange="onCheckChange">
    <view class="check-item" wx:for="{{items}}" wx:key="id">
      <label class="check-label">
        <checkbox value="{{item.id}}" checked="{{item.checked}}" color="#4A90E2" />
        <text class="check-text">{{item.text}}</text>
      </label>
    </view>
  </checkbox-group>

  <button
    class="btn btn-primary connect-btn {{allChecked ? '' : 'disabled'}}"
    disabled="{{!allChecked}}"
    bindtap="startConnect"
  >
    开始连接
  </button>
</view>
