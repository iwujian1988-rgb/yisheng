/* pages/device/bind.wxss */
.bind-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 24rpx 32rpx;
}

/* 提示卡片 */
.tip-card {
  background-color: rgba(111, 61, 255, 0.08);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 56rpx;
}

.tip-text {
  font-size: 28rpx;
  color: #6F3DFF;
  line-height: 1.6;
}

/* 表单 */
.form-section {
  margin-bottom: 64rpx;
}

.input-group {
  margin-bottom: 48rpx;
}

.input-label {
  font-size: 28rpx;
  color: #101936;
  font-weight: 500;
  margin-bottom: 16rpx;
  display: block;
}

.input-wrapper {
  position: relative;
}

.input {
  width: 100%;
  height: 104rpx;
  padding: 0 32rpx;
  background-color: #FFFFFF;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  border-radius: 24rpx;
  font-size: 30rpx;
  color: #101936;
  box-sizing: border-box;
}

.input:focus {
  border-color: #6F3DFF;
}

.input-placeholder {
  color: #98A1B8;
}

.error-text {
  font-size: 24rpx;
  color: #F5222D;
  margin-top: 8rpx;
  display: block;
}

/* 绑定按钮 */
.bind-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
  margin-top: 16rpx;
}

.btn-primary {
  background-color: #6F3DFF;
  color: #FFFFFF;
}

.btn-primary:active {
  opacity: 0.8;
}

.disabled {
  background-color: #CCCCCC;
  color: #FFFFFF;
}
