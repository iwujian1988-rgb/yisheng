/* pages/device/unbind-confirm.wxss */
.unbind-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px 48px;
}

/* 卡片 */
.card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 20px;
  margin-bottom: 12px;
}

.card-title {
  font-size: 15px;
  font-weight: 500;
  color: #333333;
  display: block;
  margin-bottom: 14px;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-label {
  font-size: 15px;
  color: #666666;
}

.info-value {
  font-size: 15px;
  color: #333333;
}

/* 风险提示 */
.warn-card {
  background-color: rgba(245, 34, 45, 0.06);
}

.warn-text {
  font-size: 14px;
  color: #CF1322;
  line-height: 1.8;
}

/* 原因列表 */
.reason-item {
  display: flex;
  align-items: center;
  padding: 14px 0;
  border-bottom: 1px solid #F0F0F0;
}

.reason-item:last-child {
  border-bottom: none;
}

.reason-text {
  font-size: 15px;
  color: #333333;
  margin-left: 8px;
}

/* 确认按钮 */
.confirm-btn {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
  margin-top: 24px;
  background-color: #F5222D;
  color: #FFFFFF;
}

.confirm-btn:active {
  opacity: 0.8;
}

.confirm-btn[disabled] {
  background-color: #CCCCCC;
  color: #FFFFFF;
}
