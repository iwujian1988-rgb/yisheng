/* pages/device/detail.wxss */
.detail-container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 16px 32px;
}

.info-card {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 4px 20px;
  margin-bottom: 32px;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 0;
}

.info-label {
  font-size: 14px;
  color: #666666;
}

.info-value {
  font-size: 14px;
  color: #333333;
}

.info-divider {
  height: 1px;
  background-color: #F0F0F0;
}

.status-bound {
  color: #52C41A;
}

.status-not_bound {
  color: #FAAD14;
}

.status-conflict {
  color: #F5222D;
}

.action-section {
  margin-top: 8px;
}

.action-btn {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
}

.btn-outline {
  background-color: transparent;
  color: #F5222D;
  border: 1px solid #F5222D;
}
