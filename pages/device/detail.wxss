/* pages/device/detail.wxss */
.detail-container {
  min-height: 100vh;
  background-color: #FCFBFF;
  padding: 24rpx 32rpx;
}

.info-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 8rpx 40rpx;
  margin-bottom: 64rpx;

  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: #64739A;
}

.info-value {
  font-size: 28rpx;
  color: #101936;
}

.info-divider {
  height: 2rpx;
  background-color: rgba(111, 61, 255, 0.08);
}

.status-bound {
  color: #52C41A;
}

.status-not_bound {
  color: #FAAD14;
}

.status-conflict {
  color: #F5222D;
}

.action-section {
  margin-top: 16rpx;
}

.action-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-outline {
  background-color: transparent;
  color: #F5222D;
  border: 2rpx solid #F5222D;
}
