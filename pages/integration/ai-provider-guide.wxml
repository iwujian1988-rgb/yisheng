<!--pages/integration/ai-provider-guide.wxml-->
<view class="guide-container">
  <view class="guide-header"><text class="guide-title">AI 服务集成指南</text></view>
  <view class="step-list">
    <view class="step-card">
      <text class="step-num">1</text>
      <view class="step-content">
        <text class="step-title">选择 AI 供应商</text>
        <text class="step-desc">根据业务需求选择合适的 AI 服务商</text>
      </view>
    </view>
    <view class="step-card">
      <text class="step-num">2</text>
      <view class="step-content">
        <text class="step-title">获取 API Key</text>
        <text class="step-desc">在服务商平台申请接口密钥</text>
      </view>
    </view>
    <view class="step-card">
      <text class="step-num">3</text>
      <view class="step-content">
        <text class="step-title">配置接口地址</text>
        <text class="step-desc">在管理后台填入 API 地址和密钥</text>
      </view>
    </view>
    <view class="step-card">
      <text class="step-num">4</text>
      <view class="step-content">
        <text class="step-title">测试连通性</text>
        <text class="step-desc">发送测试请求验证服务可用性</text>
      </view>
    </view>
  </view>
</view>
