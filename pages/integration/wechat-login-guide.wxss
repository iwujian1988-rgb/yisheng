/* pages/integration/wechat-login-guide.wxss */
.guide-container { min-height: 100vh; background-color: #FCFBFF; padding: 24rpx 32rpx; }
.guide-header { padding: 32rpx 0; }
.guide-title { font-size: 36rpx; color: #101936; font-weight: 600; }
.step-list { display: flex; flex-direction: column; gap: 24rpx; }
.step-card { background-color: #FFFFFF; border-radius: 20rpx; padding: 32rpx 40rpx; display: flex; align-items: flex-start; gap: 24rpx;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}
.step-num { width: 56rpx; height: 56rpx; background-color: #6F3DFF; color: #FFFFFF; border-radius: 50%; font-size: 28rpx; text-align: center; line-height: 56rpx; flex-shrink: 0; }
.step-content { display: flex; flex-direction: column; }
.step-title { font-size: 30rpx; color: #101936; font-weight: 500; }
.step-desc { font-size: 26rpx; color: #98A1B8; margin-top: 8rpx; }
