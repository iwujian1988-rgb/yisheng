/* pages/finance/service-overview.wxss */
.overview-container { min-height: 100vh; background-color: #F5F7FA; padding: 16px 32px; }
.stat-grid { display: flex; flex-wrap: wrap; gap: 10px; }
.stat-card { background-color: #FFFFFF; border-radius: 8px; width: calc(50% - 5px); padding: 20px; display: flex; flex-direction: column; align-items: center; }
.stat-value { font-size: 20px; color: #333333; font-weight: 600; }
.stat-label { font-size: 12px; color: #999999; margin-top: 6px; }
.section-title { padding: 20px 0 10px; }
.section-text { font-size: 16px; color: #333333; font-weight: 500; }
.empty-section { display: flex; justify-content: center; padding-top: 60px; }
.empty-text { font-size: 14px; color: #999999; }
.bill-list { display: flex; flex-direction: column; gap: 10px; }
.bill-card { background-color: #FFFFFF; border-radius: 8px; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; }
.bill-title { font-size: 15px; color: #333333; }
.bill-amount { font-size: 15px; color: #4A90E2; font-weight: 500; }
