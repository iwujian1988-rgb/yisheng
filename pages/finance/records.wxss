/* pages/finance/records.wxss */
.records-container { min-height: 100vh; background-color: #FCFBFF; padding: 24rpx 32rpx; }
.filter-bar { display: flex; gap: 20rpx; margin-bottom: 32rpx; }
.filter-item { padding: 16rpx 32rpx; border-radius: 40rpx; background-color: #FFFFFF; }
.filter-active { background-color: #6F3DFF; }
.filter-active .filter-text { color: #FFFFFF; }
.filter-text { font-size: 28rpx; color: #64739A; }
.empty-section { display: flex; justify-content: center; padding-top: 240rpx; }
.empty-text { font-size: 28rpx; color: #98A1B8; }
.record-list { display: flex; flex-direction: column; gap: 20rpx; }
.record-card { background-color: #FFFFFF; border-radius: 20rpx; padding: 32rpx 40rpx; display: flex; justify-content: space-between; align-items: center;
  border: 2rpx solid rgba(111, 61, 255, 0.12);
  box-sizing: border-box;
}
.record-left { display: flex; flex-direction: column; }
.record-title { font-size: 30rpx; color: #101936; }
.record-date { font-size: 24rpx; color: #CCCCCC; margin-top: 8rpx; }
.record-amount { font-size: 30rpx; font-weight: 500; }
.amount-green { color: #4CAF50; }
.amount-red { color: #F44336; }
