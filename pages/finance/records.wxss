/* pages/finance/records.wxss */
.records-container { min-height: 100vh; background-color: #F5F7FA; padding: 16px 32px; }
.filter-bar { display: flex; gap: 10px; margin-bottom: 16px; }
.filter-item { padding: 8px 16px; border-radius: 20px; background-color: #FFFFFF; }
.filter-active { background-color: #4A90E2; }
.filter-active .filter-text { color: #FFFFFF; }
.filter-text { font-size: 14px; color: #666666; }
.empty-section { display: flex; justify-content: center; padding-top: 120px; }
.empty-text { font-size: 14px; color: #999999; }
.record-list { display: flex; flex-direction: column; gap: 10px; }
.record-card { background-color: #FFFFFF; border-radius: 8px; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; }
.record-left { display: flex; flex-direction: column; }
.record-title { font-size: 15px; color: #333333; }
.record-date { font-size: 12px; color: #CCCCCC; margin-top: 4px; }
.record-amount { font-size: 15px; font-weight: 500; }
.amount-green { color: #4CAF50; }
.amount-red { color: #F44336; }
