/* pages/index/index.wxss */
.container {
  min-height: 100vh;
  padding: 20rpx;
}

.header {
  text-align: center;
  margin-bottom: 30rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-top: 10rpx;
}

.card {
  background: white;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.status-row {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.status-label {
  font-size: 28rpx;
  color: #666;
  width: 180rpx;
}

.status-value {
  font-size: 28rpx;
  color: #999;
}

.status-value.success {
  color: #52C41A;
}

.status-value.small {
  font-size: 24rpx;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.result-text {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
  word-break: break-all;
  font-family: monospace;
}

.action-area {
  padding: 20rpx 0;
}

.btn {
  width: 100%;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: white;
}

.btn-send {
  background: linear-gradient(135deg, #52C41A 0%, #389E0D 100%);
  color: white;
}

.btn.disabled {
  background: #E5E5E5;
  color: #999;
}

.btn::after {
  border: none;
}

.log-card {
  max-height: 400rpx;
}

.log-scroll {
  max-height: 300rpx;
}

.log-item {
  display: flex;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.log-time {
  font-size: 22rpx;
  color: #999;
  width: 150rpx;
  flex-shrink: 0;
}

.log-message {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}
