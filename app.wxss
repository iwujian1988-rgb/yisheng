/* app.wxss */
page {
  background-color: #F5F7FA;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
}

/* 全局样式变量 */
:root {
  --primary-color: #4A90E2;
  --success-color: #52C41A;
  --warning-color: #FAAD14;
  --danger-color: #F5222D;
  --text-primary: #333333;
  --text-secondary: #666666;
  --text-placeholder: #999999;
  --border-color: #E5E5E5;
  --bg-gray: #F5F7FA;
  --bg-white: #FFFFFF;
}

/* 通用按钮样式 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 48px;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 500;
  border: none;
  transition: all 0.3s;
}

.btn-primary {
  background-color: var(--primary-color);
  color: #FFFFFF;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-primary.disabled {
  background-color: #CCCCCC;
  color: #FFFFFF;
}

.btn-outline {
  background-color: transparent;
  color: var(--primary-color);
  border: 1px solid var(--primary-color);
}

.btn-text {
  background-color: transparent;
  color: var(--primary-color);
}

/* 输入框样式 */
.input-wrapper {
  position: relative;
  margin-bottom: 16px;
}

.input-wrapper .input {
  width: 100%;
  height: 48px;
  padding: 0 16px;
  background-color: var(--bg-white);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  font-size: 15px;
  color: var(--text-primary);
  box-sizing: border-box;
}

.input-wrapper .input::placeholder {
  color: var(--text-placeholder);
}

.input-wrapper .input:focus {
  border-color: var(--primary-color);
}

.input-wrapper .icon {
  position: absolute;
  right: 12px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-placeholder);
}

/* 卡片样式 */
.card {
  background-color: var(--bg-white);
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 16px;
}

/* 分割线 */
.divider {
  height: 1px;
  background-color: var(--border-color);
  margin: 16px 0;
}

.divider-text {
  display: flex;
  align-items: center;
  margin: 24px 0;
  color: var(--text-placeholder);
  font-size: 14px;
}

.divider-text::before,
.divider-text::after {
  content: '';
  flex: 1;
  height: 1px;
  background-color: var(--border-color);
}

.divider-text text {
  padding: 0 16px;
}
