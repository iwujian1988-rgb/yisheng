/* app.wxss */
@import 'miniprogram_npm/tdesign-miniprogram/common/style/theme/_index.wxss';

page {
  background-color: #FCFBFF;
  color: #101936;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  --app-tab-bar-height: calc(100rpx + env(safe-area-inset-bottom));
  --td-brand-color: #6F3DFF;
  --td-brand-color-active: #4A2BB8;
  --td-brand-color-light: #F2EDFF;
  --td-brand-color-focus: #E4DAFF;
  --td-brand-color-disabled: #C9BCF0;
  --td-bg-color-page: #FCFBFF;
  --td-bg-color-container: #FFFFFF;
  --td-component-stroke: rgba(111, 61, 255, 0.12);
  --td-component-border: rgba(111, 61, 255, 0.20);
  --td-text-color-primary: #101936;
  --td-text-color-secondary: #64739A;
  --td-text-color-placeholder: #98A1B8;
  --td-radius-large: 28rpx;
  --primary-color: #6F3DFF;
  --success-color: #18D28B;
  --warning-color: #FAAD14;
  --danger-color: #F5222D;
  --text-primary: #101936;
  --text-secondary: #64739A;
  --text-placeholder: #98A1B8;
  --border-color: rgba(111, 61, 255, 0.12);
  --bg-gray: #FCFBFF;
  --bg-white: #FFFFFF;

  /* Homepage design tokens shared by all mini program pages. */
  --brand-900: #3D2A8C;
  --brand: #6F3DFF;
  --brand-deep: #4A2BB8;
  --brand-soft: #F2EDFF;
  --brand-border: rgba(111, 61, 255, 0.12);
  --brand-border-strong: rgba(111, 61, 255, 0.20);
  --surface: #FFFFFF;
  --fg: #101936;
  --muted: #64739A;
  --radius-sm: 12rpx;
  --radius: 20rpx;
  --radius-md: 24rpx;
  --radius-lg: 28rpx;
  --radius-pill: 999rpx;
  --brand-700: #4A2BB8;
  --brand-500: #6F3DFF;
  --brand-300: #A58BFF;
  --brand-100: #E4DAFF;
  --brand-50: #F2EDFF;
  --accent-gold: #FFB400;
  --danger-strong: #FF5252;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  line-height: 1.2;
  transition: transform 160ms ease, opacity 160ms ease;
}

button > text {
  line-height: 1.2;
}

button::after {
  border: 0;
}

button:active {
  opacity: 0.88;
  transform: scale(0.98);
}

button[disabled] {
  opacity: 0.48;
}

@media (prefers-reduced-motion: reduce) {
  button {
    transition: none;
  }

  button:active {
    transform: none;
  }
}
